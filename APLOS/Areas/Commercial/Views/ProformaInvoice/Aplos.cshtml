<togglable name="Proforma Invoice"></togglable>
<div class="form-elements form-horizontal" ng-form name="buyerNewForm">
    <div class="modal-body">
        <div class="row">
            <div class="form-elements form-horizontal">
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI No :</span><sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="PI No." ng-model="PImodelNew.PINo" class="form-control" maxlength="50" required tabindex="5">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI REF # :</span><sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Ref No." ng-model="PImodelNew.RefNo" class="form-control" maxlength="50" required tabindex="5">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Currency :</span><sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Currency" class="form-control" ng-model="PImodelNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI Date :</span><sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="PI Date" ng-model="PImodelNew.PIDate" datepicker class="form-control" maxlength="15" required tabindex="5">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Customer :</span><sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <input type="text" name="Customer" ng-model="PImodelNew.Customer" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button ng-click="ShowCustomerPopUpNew();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                    <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">T & C</span></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="TypeId" class="form-control" name="Terms And Conditions" ng-model="PImodelNew.TermsAndConditionsId" ng-change="LoadTermsAndConditionGrid();" tabindex="12" @*required*@>
                                    <option ng-repeat="option in TermsAndConditionsList" value="{{option.Id}}">{{option.TermsAndConditions}}</option>
                                </select>
                            </div>
                        </div>
                    </div>


                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Version :</span><sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <div class="select-style">
                                    <select name="Version" class="form-control" ng-change="SelectVersion();" ng-model="SelectedPIVersion" ng-options="item.Id as item.VersionNo for item in VersionList">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                                <span class="input-group-btn">
                                    <button ng-click="NewVersion();" class="btn single-small-btn"><i class="glyphicon glyphicon-level-up" style="color: limegreen;"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Buyer :</span><sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select name="Buyer" class="form-control" ng-model="PImodelNew.BuyerId" ng-options="item.Value as item.Text for item in buyerList" tabindex="6" ng-change="buyerChange();">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-12">
                    <div class="row">
                        <div class="col-sm-12 table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Material Group</th>
                                        <th>Description</th>
                                        <th>HSN Code</th>
                                        <th>Quantity</th>
                                        <th>Rate</th>
                                        <th style="width:100px;">UoM</th>
                                        <th>Delivery date</th>
                                        <th>Amount</th>
                                        <th>Add</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in DataList">
                                        <th>{{$index>0?'':''}}</th>
                                        <td>
                                            <div class="col-sm-12 show-message">
                                                <input id="{{'MG'+$index}}" ej-dropdownlist e-model-fields-id="$index" e-datasource="MaterialGroupList" e-change="OnUOMChange" e-enablefiltersearch="true" e-value="item.MaterialGroupMasterId" e-fields-value="Id" e-fields-text="MaterialGroup" e-width="100%" />
                                            </div>
                                        </td>
                                        <td><input type="text" ng-model="item.Description" class="form-control" @*ng-disabled="DataList.length>1"*@ /></td>
                                        <td>
                                            <div class="col-sm-12 show-message">
                                                <input id="{{'HS'+$index}}" ej-dropdownlist e-model-fields-id="$index" e-datasource="HSNCodeList" e-enablefiltersearch="true" e-value="item.HSNCodeId" e-fields-value="Id" e-fields-text="HSNCode" e-width="100%" />
                                            </div>
                                        </td>
                                        <td><input type="text" ng-model="item.Quantity" n-decimals="2" ng-change="SumAmount(item)" class="form-control" @*ng-disabled="$index<DataList.length-1"*@ /></td>
                                        <td><input type="text" ng-model="item.Rate" n-decimals="4" ng-change="SumAmount(item)" class="form-control" @*ng-disabled="$index<DataList.length-1"*@ /></td>
                                        <td style="width:100px;">
                                            <div class="select-style">
                                                <select ng-model="item.UoMId">
                                                    <option ng-repeat="option in item.MaterialGroupUOMList" value="{{option.Id}}">{{option.userName}}</option>
                                                </select>
                                            </div>
                                        </td>
                                        <td><input type="text" ng-model="item.DeliveryDate" datepicker class="form-control" /></td>

                                        <td><input type="text" ng-disabled="true" ng-model="item.Amount" class="form-control" /></td>
                                        <td class="text-right">
                                            <ul class="list-inline">
                                                <li><button ng-click="SubmitH(item);" ng-hide="$index<DataList.length-1" class="btn btn-action "><i class="glyphicon glyphicon-plus" style="color: limegreen;"></i></button></li>
                                                <li><button ng-hide="DataList.length<2" ng-click="Remove($index);" class="btn btn-action "><i class="glyphicon glyphicon-minus" style="color: orangered;"></i></button></li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                                <li> <button ng-click="Clear();" class="btn" tabindex="13"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                <li> <button ng-click="DeletePI();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                            </ul>
                        </div>
                        <div class="col-sm-12 container-fluid" ng-show="TermsAndConditionGridList.length>0">
                            <div style="color:black;" id="GridTermsAndConditions" ej-grid e-datasource="TermsAndConditionGridList"
                                 e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" 
                                 e-filtersettings-filterType="excel" e-enabletouch="false" 
                                 e-allowselection="false">
                                <div e-columns>
                                    <div e-column e-field="TermsAndConditionPIChildId" e-headertext="TermsAndConditionsPIChildId" e-visible="false"></div>
                                    <div e-column e-type="string" e-field="Title" e-headertext="Title" e-width="420"></div>
                                    <div e-column e-template="#ShowDetails" e-headertext="" e-width="70"></div>
                                </div>
                                <script type="text/ng-template" id="ShowDetails">
                                    <div class="common-btn">
                                        <ul class="list-inline ">
                                            <li>
                                                <button ng-click="$parent.showTermsAndConditionDetailPopUp(data);" title="Edit" class="btn small" @*style="height: 28px; width: 28px; padding: 0px; margin: 0px;"*@>
                                                    <i class="glyphicon glyphicon-edit"></i>
                                                </button>
                                            </li>
                                            <li>
                                                <button ng-click="$parent.DeletePITitle(this);@*$parent.ClearTitle();*@" class="btn small tooltip-here" @*style="height: 28px; width: 28px; padding: 0px; margin: 0px;"*@ title="Delete">
                                                    <i class="glyphicon glyphicon-trash" style="color: orangered;"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </script>
                                <script id="tabGridContentsTitle" type="text/x-jsrender">
                                    <div class="tabcontrol" id="Test">
                                        <ul>
                                            <li><a href="#gridTabTitle{{:Id}}">Details</a></li>

                                        </ul>
                                        <div id="gridTabTitle{{:Id}}">
                                            <div id="detailGridTitle"></div>
                                        </div>

                                    </div>
                                </script>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="row text-right">
                <div class="col-xs-12 col-sm-12 col-sm-12 ">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="PISearchBy">
                                        <option ng-repeat="option in searchPIByList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="PISearch" ng-enter="LoadPISearchList()">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="LoadPISearchList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div style="color:black;" id="GridPI" ej-grid e-datasource="PIGridList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
             e-allowselection="false">
            <div e-columns>
                <div e-column e-type="string" e-field="PINo" e-headertext="PI No." e-width="100"></div>
                <div e-column e-type="string" e-field="LastVersion" e-headertext="Last Version" e-width="100"></div>
                <div e-column e-type="date" e-field="PIDate" e-format="{0:dd-MMM-yyyy}" e-headertext="PI Date" e-width="120"></div>
                <div e-column e-type="string" e-field="RefNo" e-headertext="Ref No." e-width="100"></div>
                <div e-column e-type="number" e-field="Amount" e-format="{0:N2}" e-headertext="Amount" e-width="100"></div>
                <div e-column e-type="string" e-field="Currency" e-headertext="Currency" e-width="100"></div>
                <div e-column e-type="number" e-field="POQuantity" e-format="{0:N2}" e-headertext="PO Tagged Quantity" e-width="100"></div>
                <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="120"></div>
                <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="100"></div>
                @*<div e-column e-type="string" e-field="InvoicingByAddress" e-headertext="InvoicingByAddress" e-width="100"></div>
                <div e-column e-type="string" e-field="DeliveryByAddress" e-headertext="DeliveryByAddress" e-width="100"></div>*@
            </div>
        </div>
    </div>
</div>

<div class="modal site-modal" id="CustomerPopUpNew" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> {{partyType}} List <button type="button" class="close" ng-click="closeCustomerPopUpNew();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByParty">
                                            <option ng-repeat="option in searchByPartyList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchParty" ng-enter="ShowCustomerPopUpNew()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="ShowCustomerPopUpNew()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="content-container-fluid">

                        <div style="color:black;" id="customerPopUpGrid" ej-grid e-datasource="partyList" e-recorddoubleclick="SetCustomerData"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="Code" e-headertext="Code" e-width="50" e-filter="false"></div>
                                <div e-column e-field="UserName" e-headertext="Party" e-width="130"></div>
                                <div e-column e-field="PartyAccountGroupName" e-headertext="Account Group" e-width="130"></div>
                                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                                <div e-column e-field="CountryName" e-headertext="Country" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="StateName" e-headertext="State" e-width="80" textAlign='Right'></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeCustomerPopUpNew();" class="btn"> Close</button></li>
                </ul>
                <i>**Showing top 100 {{partyType}} order by Code</i>
            </div>
        </div>
    </div>
</div>
<div class="modal site-modal" id="invoicingPartyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Invoicing Party<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 col-md-4 control-label">Bill To</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select ng-model="PImodelNew.InvoicingPartyPlantId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: PImodelNew.PartyId }" ng-change="billShippAddress(PImodelNew.InvoicingPartyPlantId,'billTo')">
                                    <option value=""></option>
                                </select>
                            </div>
                            <p ng-hide="PImodelNew.InvoicingPartyPlantId==null">State :{{PImodelNew.InvoicingState}}</p>
                            <p ng-hide="PImodelNew.InvoicingPartyPlantId==null">GSTIN :{{PImodelNew.InvoicingGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Invoicing by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="PImodelNew.InvoicingByAddress" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">ShipTo</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="PImodelNew.DeliveryPartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(PImodelNew.DeliveryPartyPlantId,'shipTo')">
                                    <option value=""></option>
                                </select>
                            </div>
                            <p ng-hide="PImodelNew.InvoicingPartyPlantId==null">State :{{PImodelNew.DeliveryState}}</p>
                            <p ng-hide="PImodelNew.InvoicingPartyPlantId==null">GSTIN :{{PImodelNew.DeliveryGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="PImodelNew.DeliveryByAddress" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeInvoicingPartyPopUp();" class="btn"> Done</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmPIDeletePopUp" title="Confirmation" message={{message_detailconfirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmMaterialPopUp" title="Confirmation" message={{message_Materialconfirmation}} data-ng-click-right-button="DeletePIMaterial();"></confirm-archive-generic>

<div class="row">
    <div class="modal fade site-modal in" id="GridPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">Details<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body">
                    <div class="row">
                        <div style="color:black;" id="gridTermsAndCondition" ej-grid e-datasource="POPupList" e-allowsorting="true" e-allowscrolling="true"
                             e-allowfiltering="true" e-gridlines="vertical" e-allowResizing="true" e-allowrowdraganddrop="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-actioncomplete="actionComplete" e-allowselection="true"
                             e-endadd="SaveGrid" e-endedit="SaveGrid" e-enddelete="DeletePODetailPOPUp" e-editsettings-allowediting="true" e-editsettings-allowadding="true" e-editsettings-allowdeleting="true"
                             e-toolbarsettings-showtoolbar="true" e-toolbarsettings-toolbaritems="[ej.Grid.ToolBarItems.Add, ej.Grid.ToolBarItems.Edit, ej.Grid.ToolBarItems.Delete, ej.Grid.ToolBarItems.Update, ej.Grid.ToolBarItems.Cancel]">

                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-isprimarykey="true"></div>
                                <div e-column e-field="Sequence" e-headertext="Sequence" e-visible="false"></div>
                                <div e-column e-field="TermsAndConditionsPIChildId" e-headertext="TermsAndConditionsPIChildId" e-visible="false"></div>
                                <div e-column e-field="HeaderCaption" e-headertext="Header" e-width="5"></div>
                                <div e-column e-field="Description" e-headertext="Description" e-width="5"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmPITitleDeletePopUp" title="Confirmation" message={{message_detailconfirmation}} data-ng-click-right-button="DeleteTitle();"></confirm-archive-generic>
