<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{hadding}}
</h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        /*background-color: #1c1f32;*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>
<div class="form-elements" ng-form name="investmentTypeGivenGLForm">
    <div class="row">
        <input type="hidden" ng-model="ChargesTypeGL.Id">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-3 control-label">COA<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ChargesTypeGL.COAId"
                                ng-options="item.Value as item.Text for item in COAList" id="COAId" name="COA" ng-change="showAll()" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        </div>
        <div class="col-sm-12">
            <div class="content-container-fluid" style="color:black;">
                <div style="color:black;" ng-init="chkinit()" id="Grid" ej-grid e-datasource="investmentTypeGivenGLWithCombineList" e-gridlines="vertical"  e-allowpaging="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                        <div e-column e-field="UserName" e-headertext="Type Name" e-width="80"></div>
                        <div e-column e-field="Type" e-headertext="Charges Type" e-width="80"></div>
                        <div e-column e-template="#GLAction" e-headertext="GL" e-width="90"></div>
                        <div e-column e-template="#Budget" e-headertext="Budget" e-width="80"></div>
                        <div e-column e-template="#Activity" e-headertext="Activity" e-width="80"></div>
                    </div>
                </div>
            </div>

            <script type="text/template" id="checkboxTemplate">
                <input type="checkbox" e-checked="data.Active" e-value="data.Active" ej-checkbox class="nodetext" />
            </script>
            <script type="text/template" id="GLAction">
                <div class="col-sm-12">
                    <div class="col-sm-9">
                        <input type="text" ng-model="data.ExpensesGLInfo" disabled style="color:black;margin-left: -32px;width: 136%;" class="form-control" />
                    </div>
                    <div class="col-sm-3">
                        <button style="margin-left: -19px;" class="btn single-small-btn"><i class="glyphicon glyphicon-search" ng-click="$parent.getExpensesTypeList($event);"></i></button>
                        <button ng-click="$parent.clearExpenseTypeGL(this)" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                </div>
            </script>
            <script type="text/x-jsrender" id="headerTemplate">
                <input type="checkbox" id="headchk" />
            </script>
            <script type="text/template" id="Budget">
                <div class="col-sm-10">
                    <input ej-dropdownlist e-datasource="data.BudgetList" e-value="data.ExpensesBudgetMasterId" e-fields-value="BudgetMasterId" e-fields-text="BudgetName"  e-change="$parent.getExpensesActivity" e-width="100%" />
                </div>
            </script>
            <script type="text/template" id="Activity">
                <div class="col-sm-10">
                    <input ej-dropdownlist e-datasource="data.ActivityList" e-value="data.ExpensesActivityId" e-fields-value="ActivityId" e-fields-text="ActivityName" e-width="100%" />
                </div>
            </script>
        </div>

        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_ExpensesTypeGL.cshtml")


@Html.Partial("_ConfirmModal")
<confirm-archive-generic modalid="glUntag" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>