<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="InvoiceNo" e-headertext="InvoiceNo" e-width="2"></div>
            <div e-column e-field="InvoiceDate" e-headertext="InvoiceDate" e-width="2"></div>
            <div e-column e-field="BLAWBNo" e-headertext="BLAWBNo" e-width="2"></div>
            <div e-column e-field="BLAWBDate" e-headertext="BLAWBDate" e-width="2"></div>
            <div e-column e-field="ShipMode" e-headertext="ShipMode" e-width="2"></div>
            <div e-column e-field="Port" e-headertext="Port" e-width="2"></div>
            <div e-column e-field="CNFAgentName" e-headertext="CNFAgent" e-width="2"></div>
            <div e-column e-field="TransportAgentName" e-headertext="TransportAgent" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
<div class="modal fade site-modal in" id="ContractPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Purchase LC</h4>
            </div>
            <div class="modal-body">
                <div class="row">

                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="Grid456" ej-grid e-datasource="LcList" e-allowsorting="true"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
                             e-recorddoubleclick="recorddoubleclickLC" e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="PurchaseLCNO" e-headertext="LC Id" e-width="80" e-visible="false"></div>
                                <div e-column e-field="ContractId" e-headertext="ContractId" e-width="100" e-visible="false"></div>
                                <div e-column e-field="LCRef" e-headertext="LC No" e-width="100"></div>
                                <div e-column e-field="ContractNo" e-headertext="Contract No" e-width="100"></div>
                                <div e-column e-field="UDNo" e-headertext="UD No" e-width="100"></div>
                                <div e-column e-field="MasterLCRef" e-headertext="MasterLC Ref" e-width="100"></div>
                                <div e-column e-field="CustomerName" e-headertext="Customer" e-width="100"></div>
                                <div e-column e-field="PartyName" e-headertext="Vendor" e-width="100"></div>
                                <div e-column e-field="LCOpeningDate" e-headertext="LCOpening Date" e-width="100"></div>
                                <div e-column e-field="LCExpiryDate" e-headertext="LCExpiry Date" e-width="100"></div>
                                <div e-column e-field="LCOpeningBank" e-headertext="LCOpening Bank" e-width="100"></div>
                                <div e-column e-field="AcceptanceFirst" e-headertext="Acceptance First" e-width="100"></div>
                            </div>
                        </div>
                    </div>

                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="CloseContractPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
