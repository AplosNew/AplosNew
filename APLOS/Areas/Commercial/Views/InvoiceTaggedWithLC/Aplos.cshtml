<togglable name=" {{FormTitle}}"></togglable>
<div class="form-horizontal" ng-form name="AutoLoanForm">
    <div class="form-elements">
        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="form-group">
                <div class="col-sm-12 radio">
                    <label>
                        <input type="radio" name="source2" ng-model="AutoLoanNew.DateRange" value=false ng-change="viewChange()">
                        <span class="cr" tabindex="1"><i class="cr-icon"></i></span>As On Date
                    </label>
                    <label>
                        <input type="radio" name="source2" ng-model="AutoLoanNew.DateRange" value=true ng-change="viewChange()">
                        <span class="cr" tabindex="2"><i class="cr-icon"></i></span>For the Period
                    </label>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="form-group" show-errors id="div_FromDate">
                <label class="col-sm-4 control-label">{{fromDateTitle}}</label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Date" ng-model="AutoLoanNew.FromDate" datepicker class="form-control" tabindex="3">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors id="div_WDToDate">
                <div ng-show="toDateShow">
                    <label class="col-sm-4 control-label">To Date</label>
                    <div class="col-sm-6 show-message">
                        <input type="text" name="Date" ng-model="AutoLoanNew.ToDate" datepicker class="form-control" tabindex="4">
                    </div>
                </div>
                <div class="col-sm-2 show-message" style="padding-left:0px;">
                    <div class="common-btn">
                        <button ng-click="getAutoLoanAvailableList();" class="btn"><i class="glyphicon glyphicon-circle-arrow-down"></i>Go</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>
        <div class="row">
            <div class="container-fluid" style="color:black;">
                <div style="color:black;" id="GridAcceptanceList" ej-grid e-datasource="AutoLoanAvailableDataList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true"
                     e-gridlines="vertical" e-allowresizing="true"
                     e-filtersettings-filterType="excel"
                     e-enabletouch="true">
                    <div e-columns>
                        <div e-column e-headertext="Select" e-template="#checkMasterLC" e-textalign="center" e-width="30"></div>

                        <div e-column e-type="string" e-field="VoucherNo" e-headertext="Voucher No" e-width="80"></div>
                        <div e-column e-type="date" e-field="PostingDate" e-headertext="Posting Date" e-format="{0:dd-MMM-yyyy}" e-width="70"></div>
                        <div e-column e-type="string" e-field="DocRefNo" e-headertext="DocRefNo" e-width="80"></div>
                        <div e-column e-type="string" e-field="PartyPlantName" e-headertext="Vendor" e-width="120"></div>
                        <div e-column e-type="date" e-field="BaseOnDueDate" e-headertext="DueDate BaseOn" e-format="{0:dd-MMM-yyyy}" e-width="100"></div>
                        <div e-column e-type="date" e-field="ActualDueDate" e-headertext="DueDate" e-format="{0:dd-MMM-yyyy}" e-width="100"></div>
                        <div e-column e-type="string" e-field="BaseNoOfDays" e-headertext="NoOfDays" e-width="80"></div>
                        <div e-column e-type="string" e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Receivable" e-headertext="Payable" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Received" e-headertext="SetOff" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Balance" e-headertext="Balance" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="string" e-field="SourceType" e-headertext="Source Type" e-width="100"></div>
                    </div>
                </div>
                <script type="text/template" id="checkMasterLC">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" @*e-enabled="{{data.Balance== 0.00?'fasle':'true'}}"*@ e-change="$parent.Calculate" e-checked="data.isSelected" />
                </script>

                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li>
                            <button ng-click="AddSelectedInvoice();" class="btn"> <i class="glyphicon glyphicon-search"></i>Add To List</button>
                            <button ng-click="InvoiceTaggedWithLCReportExcel();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="row form-elements">
                <div class="col-xs-12 col-sm-12 col-md-12 modal-table" ng-show="selectedInvoiceList.length">
                    <table class="table table-responsive table-striped">
                        <thead>
                            <tr>
                                <th>VoucherNo</th>
                                <th>Posting Date</th>
                                <th>Doc RefNo</th>
                                <th>Payable</th>
                                <th>SetOff</th>
                                <th>Balance</th>
                                <th>Amount</th>
                                <th>
                                    LC Ref No
                                    <div class="common-btn">
                                        <button ng-click="copyLCNo();" class="btn" tabindex="5"><i class="glyphicon"></i> Copy</button>
                                    </div>
                                </th>
                                <th>LC Opening Bank</th>
                                <th>LC Open Date</th>
                                <th>LC Balance Amount</th>
                                <th class="text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in selectedInvoiceList" ng-show="selectedInvoiceList.length">
                                <td>{{x.VoucherNo}}</td>
                                <td>{{x.PostingDate}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>{{x.Receivable}}</td>
                                <td>{{x.Received}}</td>
                                <td>{{x.Balance}}</td>
                                <td>
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Amount">
                                    </div>
                                </td>
                                <td>
                                    {{x.LCRef}}
                                    <button ng-click="getSavedData($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top"><i class="glyphicon glyphicon-search"></i></button>
                                </td>
                                <td>{{x.OpeningBank}}</td>
                                <td>{{x.LCDate}}</td>
                                <td>{{x.BalanceLCAmount}}</td>
                                <td class="text-right">
                                    <button ng-click="removeSelectedInvoiceRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot ng-show="selectedInvoiceList.length">
                            <tr>
                                <td colspan="4"></td>
                                <td><b> Total</b></td>
                                <td class="text-right"><b>{{ selectedInvoiceList | sumByKey : 'Balance' }}</b></td>
                                <td class="text-right"><b>{{ selectedInvoiceList | sumByKey : 'Amount' }}</b></td>
                                <td colspan="4"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group">
                    <div class="col-sm-12 radio">
                        <label>
                            <input type="radio" name="IsLoan" ng-model="LcModel.IsLoan" value=true ng-change="Calculate()">
                            <span class="cr" tabindex="1"><i class="cr-icon"></i></span>With Loan
                        </label>
                        <label>
                            <input type="radio" name="IsLoan" ng-model="LcModel.IsLoan" value=false ng-change="ChangeValue()">
                            <span class="cr" tabindex="2"><i class="cr-icon"></i></span>Without Loan
                        </label>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">LC No</label>
                        <div class="col-sm-8">
                            <input type="text" ng-disabled="true" ng-model="LcModel.LCRef" class="form-control" maxlength="100" tabindex="2">
                        </div>
                    </div>
                    <div class="form-group" ng-show="LcModel.IsLoan=='true'">
                        <label class="col-sm-4 control-label">Loan Amount</label>
                        <div class="col-sm-8">
                            <input type="number" class="input ejinputtext form-control" ng-disabled="true" ng-model="LcModel.LoanAmount" maxlength="100" tabindex="2">
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Vendor</label>
                        <div class="col-sm-8">
                            <input type="text" ng-disabled="true" ng-model="LcModel.PartyName" class="form-control" maxlength="100" tabindex="2">
                        </div>
                    </div>
                    <div class="form-group" ng-show="LcModel.IsLoan=='true'">
                        <label class="col-sm-4 control-label">Loan No</label>
                        <div class="col-sm-8">
                            <input type="text" class="input ejinputtext form-control" ng-model="LcModel.LoanNo" maxlength="100" tabindex="2">
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Currency</label>
                        <div class="col-sm-8">
                            <input type="text" ng-disabled="true" ng-model="LcModel.Currency" class="form-control" maxlength="100" tabindex="2">
                        </div>
                    </div>
                    <div class="form-group" ng-show="LcModel.IsLoan=='true'">
                        <label class="col-sm-4 control-label">Loan Date</label>
                        <div class="col-sm-8">
                            <input type="text" class="datepicker form-control" datepicker ng-model="LcModel.LoanDate" width="80" />
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>

        </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div id="GridEdit" ej-grid e-datasource="SaveDataList" e-allowfiltering="true"
             e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="LCRef" e-headertext="LC Ref" e-width="80"></div>
                <div e-column e-field="Vendor" e-headertext="Vendor" e-width="120"></div>
                <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="LoanDate" e-headertext="Loan Date" e-textalign="right" e-width="80"></div>
                <div e-column e-field="LoanNo" e-headertext="LoanNo" e-textalign="right" e-width="80"></div>
                <div e-column e-field="Currency" e-headertext="Currency" e-width="80"></div>
                <div e-column e-field="Amount" e-headertext="Amount" e-width="80"></div>
                <div e-column e-field="VoucherNo" e-headertext="VoucherNo" e-width="80"></div>
                <div e-column e-field="Status" e-headertext="Status" e-width="80"></div>
                <div e-column e-headertext=" Action " e-template="#InvoiceTWLCTemplate" e-width="160"></div>
            </div>
            <script id="InvoiceTWLCTemplate" type="text/template">
                <div class="common-btn">
                    <ul class="common-btn list-inline text-center">

                        <li><a class="btn btn-action" href="Commercial/InvoiceTaggedWithLC/GetInvoiceTaggedWithLCReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&LCId={{data.Id}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Commercial/InvoiceTaggedWithLC/GetInvoiceTaggedWithLCReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&LCId={{data.Id}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        <li><a class="btn btn-action" ng-hide="data.VoucherId==null" href="Accounts/Loan/AutoLoanReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{data.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" ng-hide="data.VoucherId==null" href="Accounts/Loan/AutoLoanReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{data.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        <li>
                            <button ng-show="data.VoucherId==null" ng-click="$parent.onClickUnTaggLCPopUp(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Delete">
                                <i class="glyphicon glyphicon-trash" style="color:orangered;"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </script>
        </div>
    </div>
</div>



<div class="modal fade site-modal in" id="PurchaseLCPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Purchase LC <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div style="color:black;" id="GridPurchaseLC" ej-grid e-datasource="purchaseLCList" e-recorddoubleclick="SetDetails"
                     e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                    <div e-columns>
                        <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="20" e-visible="false"></div>
                        <div e-column e-type="string" e-field="LCRef" e-headertext="LC No" e-width="60"></div>
                        <div e-column e-type="string" e-field="Version" e-headertext="Last Version" e-width="20"></div>
                        <div e-column e-field="LCDate" e-headertext="Opening Date" e-format="{0:dd-MMM-yyyy}" e-type="date" e-width="40"></div>
                        <div e-column e-type="number" e-field="Amount" e-headertext="Opening Value" e-width="40" e-textalign="right"></div>
                        <div e-column e-field="AmendmentDate" e-headertext="Amendment Date" e-format="{0:dd-MMM-yyyy}" e-type="date" e-width="40"></div>
                        <div e-column e-type="number" e-field="AmendmentAmount" e-headertext="Amendment Value" e-width="40" e-textalign="right"></div>
                        <div e-column e-type="string" e-field="Currency" e-headertext="Currency" e-width="30"></div>
                        <div e-column e-type="string" e-field="PartyName" e-headertext="Vendor" e-width="60"></div>
                        <div e-column e-type="string" e-field="OpeningBank" e-headertext="Opening Bank" e-width="60"></div>
                        <div e-column e-type="string" e-field="ContractNo" e-headertext="Contract No" e-width="50"></div>
                        <div e-column e-type="string" e-field="CustomerName" e-headertext="Customer" e-width="60"></div>
                        <div e-column e-type="string" e-field="MasterLCNo" e-headertext="MasterLCNo" e-width="50"></div>
                        <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                        <div e-column e-type="string" e-field="ContractRemarks" e-headertext="Contract Remarks" e-width="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirmUntagPopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="UntagInvoiceWithLC()"></confirm-archive-generic>

