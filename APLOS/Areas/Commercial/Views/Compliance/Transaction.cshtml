
<link href="~/Scripts/BootstrapTimePicker/css/bootstrap-timepicker.css" rel="stylesheet" />
<script src="~/Scripts/BootstrapTimePicker/Scripts/bootstrap.js"></script>
<script src="~/Scripts/BootstrapTimePicker/js/bootstrap-timepicker.js"></script><togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Transaction Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="TransactionDate" ng-model="ModelNew.ComplianceDate" datepicker class="form-control" maxlength="100" autocomplete="off" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Location Reference<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.LocationId" name="Location" ng-options="item.Id as item.LocationReference for item in ComplianceList" tabindex="7" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Master Plan" ng-model="ModelNew.EmployeeCode" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="popUp();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        



    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
      
        <div class="form-group">
            <label class="col-sm-4 control-label">Transaction Time<sup>*</sup></label>
            <div class="col-sm-7 input-group bootstrap-timepicker timepicker" style="float:right">
                <input id="TransactionTime" type="text" class="form-control input-small" ng-model="ModelNew.ComplianceTime" style="margin-left:-10%; width:94%" tabindex="7">
                <span class="input-group-addon" style="float:left; width:12%"><i class="glyphicon glyphicon-time"></i></span>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Compliance Value<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.ValueId" name="Compliance Value" ng-options="item.Id as item.ComplianceValue for item in ComplianceList" tabindex="7" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>


        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="10"></textarea>
            </div>
        </div>

    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getCTData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getCTData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="ComDate" e-format="{0:dd-MMM-yyyy}" e-type="string" e-headertext="ComplianceDate" e-width="3"></div>
            <div e-column e-field="ComTime" e-headertext="Compliance Time" e-width="5"></div>
            <div e-column e-field="ComplianceValue" e-headertext="ComplianceValue" e-width="5"></div>
            <div e-column e-field="LocationReference" e-headertext="LocationReference" e-width="5"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmBoMDetailPopUp" title="Confirmation" message={{message_detailconfirmation}} data-ng-click-right-button="DeleteRP();"></confirm-archive-generic>
<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee Information
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SetEmployee"  e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                        
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="closePopUp()" class="btn">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
  
</div>

<script type="text/javascript">
    $('[id*=TransactionTime]').timepicker({ showMeridian: false, defaultTime: false }).on('changeTime.timepicker', function (e) {
        var hours = e.time.hours, //Returns a string
            min = e.time.minutes
        //merdian = e.time.meridian;

        if (hours.length == 1) {
            $('[id*=TransactionTime]').timepicker('setTime', '0' + hours + ':' + min);

        }
    });
   
</script>