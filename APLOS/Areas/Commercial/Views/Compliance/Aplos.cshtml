<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);GetGroupCbo();GetCategoryCbo();GetSubCategoryCbo();" href="" aria-controls="general" role="tab" data-toggle="tab">Compliance</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);getGroupData('Group');" href="" aria-controls="general" role="tab" data-toggle="tab">Group</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);getCategoryData('Category');" href="" aria-controls="general" role="tab" data-toggle="tab">Category</a></li>
            <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4);getSubCategoryData('SubCategory');" href="" aria-controls="general" role="tab" data-toggle="tab">SubCategory</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            @Html.Partial("~/Areas/Commercial/Views/Compliance/Compliance.cshtml")
        </div>
        @*   TAB -2  *@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            @Html.Partial("~/Areas/Commercial/Views/Compliance/Group.cshtml")
        </div>
        @*   TAB -3  *@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
            @Html.Partial("~/Areas/Commercial/Views/Compliance/Category.cshtml")
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
            @Html.Partial("~/Areas/Commercial/Views/Compliance/SubCategory.cshtml")
        </div>
    </div>

</div>