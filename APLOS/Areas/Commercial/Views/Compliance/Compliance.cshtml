<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Compliance Group<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.ComplianceGroupId" name="Compliance Group" ng-options="item.Value as item.Text for item in Grouplist" tabindex="7" required>
                        <option value=""></option>
                    </select>
                </div>
                @*<input type="text" name="Compliance Group" ng-model="ModelNew.ComplianceGroup" class="form-control" maxlength="100" autocomplete="off" required tabindex="1">*@
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Category Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                @*<input type="text" name="Category Name" ng-model="ModelNew.Category" class="form-control" required autocomplete="off" tabindex="3" maxlength="100">*@
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.CategoryId" name="Category Name" ng-options="item.Value as item.Text for item in CategoryList" tabindex="7" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Item Name" ng-model="ModelNew.ItemName" class="form-control" required autocomplete="off" tabindex="5" maxlength="100">
                    <span class="input-group-btn">
                        <button ng-click="showCheckPointsPopUp ();" ng-disabled="ModelNew.Id==null" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-plus"></i>Check Points</button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Audit Frequency<sup>*</sup></label>
            <div class="col-sm-4 show-message">
                <input type="text" name="Audit Frequency" ng-model="ModelNew.AuditFrequency" only-numbers class="form-control" required autocomplete="off" tabindex="5" maxlength="100">
            </div>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.AuditFrequencyUnit" name="AuditFrequencyUnit" ng-options="item.Value as item.Text for item in auditFrequencyUnitList" tabindex="7" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Compliance Value<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.ComplianceValue" name="Compliance Value" ng-options="item.Value as item.Text for item in ComplianceValueList" tabindex="7" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Scan Applicable</label>
            <div class="col-sm-2">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.ScanApplicable" tabindex="10">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label class="col-sm-3 control-label">Code Applicable</label>
            <div class="col-sm-2">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.CodeApplicable" tabindex="10">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label class="col-sm-4 control-label">Is Document verification</label>
            <div class="col-sm-2">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.IsDocumentVerification" tabindex="10">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">File Upload</label>
            <div class="col-sm-8">
                <div id="UploadDefault" e-dialogtext-title="Compliance File" e-autoupload="true" e-begin="onBeginUpload" e-filesize="2097152" ej-uploadbox e-saveurl="uploadUrl" e-multiplefilesselection=false e-extensionsallow=".jpg,.bmp,.png,.jpeg,.xls,.xlsx,.pdf" e-error="errorPicUpload"></div>
            </div>
        </div>

        <!--<div class="form-group">
            <label>Attachment</label>
            <input type="file"
                   id="fileAttachment"
                   class="form-control"
                   onchange="angular.element(this).scope().setFile(this)"
                   style="padding: 5px;" />
            <small class="text-muted" style="color: #666; font-size: 12px;">
                Allowed file types: PDF, DOC, DOCX, XLS, XLSX, JPG, PNG (Max 2MB)
            </small>-->

            <!-- Display selected file name -->
            <!--<div ng-if="fileName" style="margin-top: 5px; color: #007bff;">
                <i class="fa fa-file"></i> Selected: {{fileName}} ({{fileSize}})
            </div>
        </div>-->

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required autocomplete="off" tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">SubCategory Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                @*<input type="text" name="SubCategory Name" ng-model="ModelNew.SubCategory" class="form-control" required autocomplete="off" tabindex="4" maxlength="100">*@
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.SubCategoryId" name="SubCategory Name" ng-options="item.Value as item.Text for item in SubCategoryList" tabindex="7" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Criticality Level<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Criticality Level" class="form-control" ng-model="ModelNew.CriticalityLevel" required tabindex="6">
                        <option value=""></option>
                        <option ng-repeat="item in CriticalityLevelList" value="{{item.Value}} ">{{item.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Location Reference<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Location Reference" ng-model="ModelNew.LocationReference" class="form-control" required autocomplete="off" tabindex="8" maxlength="100">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Expiry Date<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" ng-model="ModelNew.ExpiryDate" datepicker class="form-control datepicker" placeholder="dd-MM-yyyy" tabindex="3">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="10"></textarea>
            </div>
        </div>



    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet2(1) }"><a ng-click="setTab2(1)" href="" aria-controls="RP" role="tab" data-toggle="tab">Responsible Person</a></li>
                <li role="presentation" ng-class="{ active: isSet2(2) }"><a ng-click="setTab2(2)" href="" aria-controls="Ad" role="tab" data-toggle="tab">Auditor</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(1), active: isSet2(1) }">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li>
                            <button ng-click="popUp('RP');" class="btn"><i class="glyphicon glyphicon-plus"></i>Add Responsible Person</button>
                        </li>
                    </ul>
                </div>
                <div style="color:black;" id="GridRP" ej-grid e-datasource="RPDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="30"></div>
                        <div e-column e-field="EmpSystemID" e-headertext="Emp SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                        <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                        <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                        <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                        <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                        <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                    </div>
                </div>
                <script type="text/template" id="ShowActionButtons">
                    <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeRP(this);" style="margin: -6px;"></i></button>
                </script>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(2), active: isSet2(2) }">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li>
                            <button ng-click="popUp('Auditor');" class="btn"><i class="glyphicon glyphicon-plus"></i>Add Auditor</button>
                        </li>
                    </ul>
                </div>
                <div style="color:black;" id="GridAuditor" ej-grid e-datasource="ADDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-headertext="Actions" e-template="#ShowActionButtonsAD" e-width="30"></div>
                        <div e-column e-field="EmpSystemID" e-headertext="Emp SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                        <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                        <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                        <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                        <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                        <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                    </div>
                </div>
                <script type="text/template" id="ShowActionButtonsAD">
                    <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeAD(this);" style="margin: -6px;"></i></button>
                </script>
            </div>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-visible="false" e-isprimarykey="true"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ComplianceGroup" e-headertext="Compliance Group" e-width="5"></div>
            <div e-column e-field="Category" e-headertext="Category Name" e-width="5"></div>
            <div e-column e-field="SubCategory" e-headertext="SubCategory Name" e-width="5"></div>
            <div e-column e-field="ItemName" e-headertext="ItemName" e-width="5"></div>

            <!-- File Column - Simple Version -->
            @*<div e-column e-field="FileName" e-headertext="File" e-width="4" e-templateid="#simpleFileTemplate"></div>*@
            <div e-column e-type="text" e-template="#file" e-headertext="File Name" e-textalign="right" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>

<!-- Simple Template -->
<script type="text/template" id="file">
    <div class="text-right" style="width:100%">
        <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.FileDownload(data);">{{data.FileName}}</a>
    </div>
</script>
<script type="text/x-jsrender" id="simpleFileTemplate">
    <div style="text-align: center;">
            {{if FileName && FileName !== ''}}
            <a href="/Commercial/Compliance/DownloadFile?id={{:Id}}" target="_blank"
               style="color: #007bff; text-decoration: none;" title="Download {{:FileName}}">
                <i class="fa fa-download"></i>
            </a>
            {{else}}
            -
            {{/if}}
        </div>
</script>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmBoMDetailPopUp" title="Confirmation" message={{message_detailconfirmation}} data-ng-click-right-button="DeleteRP();"></confirm-archive-generic>
<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee Information
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-templaterefresh="refreshTemplate" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            @*<div e-column e-headertext="Pic" e-template="#empimage" e-textalign="center" e-width="40"></div>*@
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveRP()" class="btn">Apply</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    @*<script type="text/x-jsrender" id="empimage">
            <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
        </script>*@
</div>
<div class="modal fade site-modal in" id="CheckPointsPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="CloseCheckPointsPopUp()">&times;</button>
                <h4 class="modal-title">Check Points</h4>
            </div>
            <div class="modal-body">
                <div id="gridCP" ej-grid e-datasource="CheckPointsList" e-pagesettings-pagesize="4" e-minheight="300"
                     e-endadd="SaveCheckPoints" e-endedit="SaveCheckPoints" e-enddelete="DeleteCheckPoints" e-editsettings-allowediting="true" e-editsettings-allowadding="true" e-editsettings-allowdeleting="true"
                     e-toolbarsettings-showtoolbar="true" e-toolbarsettings-toolbaritems="[ej.Grid.ToolBarItems.Add, ej.Grid.ToolBarItems.Edit, ej.Grid.ToolBarItems.Delete, ej.Grid.ToolBarItems.Update, ej.Grid.ToolBarItems.Cancel]"
                     e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filtertype="excel">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-isprimarykey="true"></div>
                        <div e-column e-field="ComplianceMasterId" e-headertext="ComplianceMasterId" e-visible="false"></div>
                        <div e-column e-field="CheckPointName" e-headertext="CheckPointName" e-width="5"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>