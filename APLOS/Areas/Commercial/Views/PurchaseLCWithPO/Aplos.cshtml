<div class="modal fade site-modal in" id="serviceChargePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Tax Information<button type="button" class="close" ng-click="closeTaxPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <p>Taxable amount : <b>{{chargestaxAbleAmnt| number| setDecimal:currencyPrecision}}</b>&nbsp;<b>{{Currency}}</b></p>
                    <p>HSNCode : <b>{{HSNCode}}</b></p>
                </div>
                <div class="clearfix"></div>
                <div>
                    <p class="col-md-11"></p>
                    <button type="button" class="btn btn-action" ng-click="addTax();">Add Tax</button>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped" border="1" id="AddTax">
                        <thead>
                            <tr>
                                <th ng-hide="true">id</th>
                                <th>Tax Category</th>
                                <th ng-hide="true">HSN Code</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in taxList">
                                <td ng-hide="true">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Id" readonly>
                                    </div>
                                </td>
                                <td>
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in taxCategoryList" ng-change="onchangeFunction(x.TaxCategoryId)"></select>
                                    </div>
                                </td>
                                <td ng-hide="true">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.HSNCode">
                                    </div>
                                </td>
                                <td>
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Percentage" ng-keyup="calculateTaxAmount(x);">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TaxAmount" ng-keyup="checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="removeTax(x.Id,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right"><label class="control-label">Total : {{taxList | sumByKey : 'TaxAmount'| setDecimal:2| number:2 }}</label></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="common-btn">

                    <ul class="list-inline text-right">
                        <li><button ng-click="SaveChargesTax();" class="btn"><i class="glyphicon glyphicon-plus"></i> {{TaxAction}}</button></li>
                        <li><button ng-click="closeAccepServiceChargePopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="removPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="removeTaxRow();"></confirm-archive-generic>
