            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-12">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsAccepptanceFirst" ng-model="purchaseLCNew.IsAccepptanceFirst" value="true" ng-disabled="PurchaseLCUsedInAcceptance || isFirst">
                        <span class="cr"><i class="cr-icon"></i></span>Accepptance First
                    </label>&nbsp;&nbsp;
                    <label>
                        <input type="radio" name="IsAccepptanceFirst" ng-model="purchaseLCNew.IsAccepptanceFirst" value="false" ng-disabled="PurchaseLCUsedInAcceptance || isFirst">
                        <span class="cr"><i class="cr-icon"></i></span>GRN/Ack First
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
