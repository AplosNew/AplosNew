                        <option value="">--Select--</option>
                    </select>
                </div>*@
                <input type="text" name="Lein Bank" ng-model="purchaseLCNew.LeinBank" class="form-control" tabindex="6" maxlength="50">
            </div>
        </div>

        <div class="form-group" show-errors>
