                        <option value="">--Select--</option>
                        <option ng-repeat="option in currencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-1 show-message" style="width: 17%; margin-left: -16px;">
