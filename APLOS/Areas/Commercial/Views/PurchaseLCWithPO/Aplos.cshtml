    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="confirmToCreateNewVersion();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="GetPurchaseLCCharges();" class="btn" @*ng-disabled="voucherId!==null"*@><i class="glyphicon glyphicon-plus"></i> LC Opening Charges</button></li>
                </ul>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="table-responsive modal-table" ng-show="purchaseLCChargesList.length>0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Charges Type</th>
                            <th>OverHead Type</th>
                            <th>VoucherNo</th>
                            <th style="width: 100px;">Charges Value</th>
                            <th style="width: 150px;">Currency</th>
                            <th>Ex. Rate</th>
                            <th style="width: 100px;">Bank Amount</th>
                            <th>Opening Bank</th>
                            <th>Remarks</th>
                            <th>Actipn</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in purchaseLCChargesList">
                            <td>{{x.Type}}</td>
                            <td>{{x.OverHeadType}}</td>
                            <td>{{x.VoucherId}}</td>
                            <td class="text-right"><input type="text" n-decimals="2" class="form-control" ng-disabled="x.VoucherId!==null" ng-model="x.ChargesValue" ng-change="ChangeChargesBank(x.CurrencyId,$index);"></td>
                            <td>
                                <div class="select-style">
                                    <select name="Currency" class="form-control" ng-disabled="x.VoucherId!==null" ng-model="x.CurrencyId" ng-options="item.Value as item.Text for item in currencyList" ng-change="ChangeChargesBank(x.CurrencyId,$index);GetCurrencyExchangeChargesRateList(x.CurrencyId,$index)" style="height: 30px;">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </td>
                            <td class="text-right"><input type="text" n-decimals="4" class="form-control" ng-disabled="x.VoucherId!==null || x.CurrencyId==companyCurrencyId" ng-model="x.Rate"></td>
                            <td class="text-right"><input type="text" n-decimals="2" class="form-control " ng-model="x.BankAmount" ng-disabled="x.CurrencyId===x.BankCurrencyId || x.VoucherId!==null"></td>
