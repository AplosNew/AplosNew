            <label class="col-sm-4 control-label">Maturity Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Maturity Date" ng-model="purchaseLCNew.MaturityDate" datepicker class="form-control" required tabindex="10">
            </div>
        </div>*@

