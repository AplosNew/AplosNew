            <label class="col-sm-4 control-label">Acceptance Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Acceptance Date" ng-model="purchaseLCNew.AcceptanceDate" datepicker class="form-control" required tabindex="9">
            </div>
        </div>*@

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Amount<sup>*</sup></label>
            <div class="col-sm-3 show-message">
                <input type="text" n-decimals="2" name="Amount" ng-model="purchaseLCNew.Amount" class="form-control" maxlength="15" disabled required tabindex="12">
            </div>
            <label class="col-sm-2 control-label" style="margin-left:-25px">Currency<sup>*</sup></label>
