            <label class="col-sm-4 control-label">Payment Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Payment Date" ng-model="purchaseLCNew.PaymentDate" datepicker class="form-control" required tabindex="11">
            </div>
