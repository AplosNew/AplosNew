            <label class="col-sm-4 control-label">PI No<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="PINo" ng-model="purchaseLCNew.PINo" class="form-control" maxlength="150" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">LC Ref No<sup>*</sup></label>
            <div class="col-sm-8 show-message">
