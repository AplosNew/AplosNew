                                    <li><button ng-click="removeRowModal($index,x)" ng-disabled="x.VoucherId!==null" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                </ul>
                            </td>

                        </tr>
                        <tr>
                            <td colspan="3">Total:</td>
                            <td class="text-right"><strong>{{purchaseLCChargesList | sumByKey : 'ChargesValue' }}</strong></td>
                            <td></td>
                            <td></td>
                            <td class="text-right"><strong>{{purchaseLCChargesList | sumByKey : 'BankAmount' }}</strong></td>
                            <td colspan="3"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
