                    <select name="Port Of Discharge" class="form-control" ng-model="purchaseLCNew.PortOfLandingId" ng-options="item.Value as item.Text for item in portList" tabindex="16">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label" title="Insurance Value">Insurance Value<sup>*</sup></label>
