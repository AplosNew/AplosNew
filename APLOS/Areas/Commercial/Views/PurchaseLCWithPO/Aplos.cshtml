<togglable name="Multiple PO LC"></togglable>
<div class="form-elements form-horizontal" ng-form name="PurchaseLCForm">
    <input type="hidden" ng-model="purchaseLCNew.Id">
    <div class="col-xs-12">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border" style="margin-bottom:-8px">Purchase Order</legend>
            <div class="col-xs-6" id="Unassign">
                <div class="common-btn">
                    <ul class="list-inline text-right"><li><button ng-click="MakeData()" class="btn btn-action tooltip-here" data-placement="top" title="Add">>></button></li></ul>
                </div>
                <div>
                    <div style="color:black;" id="Grid456" ej-grid e-datasource="GriddataPOWithOutLC" e-allowscrolling="true" e-summaryrows="summaryUnassignRows"
                         e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-pageSettings-pageSize="10" e-allowResizing="true"
                         e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">

                        <div e-columns>
                            <div e-column e-template="#checkboxTemplate" e-textalign="center" e-width="40"></div>
                            <div e-column e-type="string" e-field="Id" e-headertext="POId" e-width="50"></div>
                            <div e-column e-type="string" e-field="PODate" e-headertext="PODate" e-width="60"></div>
                            <div e-column e-type="string" e-field="DocRefNo" e-headertext="DocRefNo" e-width="80"></div>
                            <div e-column e-type="string" e-field="StandardName" e-headertext="Vendor" e-width="100"></div>
                            <div e-column e-type="string" e-field="TransactionAmount" e-headertext="Amount" e-width="80" e-textalign="right"></div>
                            <div e-column e-type="string" e-field="LCAmount" e-headertext="LCAmount" e-width="80" e-textalign="right"></div>
                            <div e-column e-type="string" e-field="BalanceAmount" e-headertext="BalanceAmount" e-width="80" e-textalign="right"></div>
                            <div e-column e-type="string" e-field="Currency" e-headertext="Currency" e-width="30"></div>
                            <div e-column e-type="string" e-field="PaymentTerm" e-headertext="Payment Term" e-width="70"></div>
                            <div e-column e-type="string" e-field="OrderSpecifi" e-headertext="Order Specific" e-width="70"></div>
                            <div e-column e-type="string" e-field="ContractNo" e-headertext="ContractNo" e-width="80"></div>
                            <div e-column e-field="Flag" e-headertext="State" e-width="60"></div>
                        </div>
                    </div>
                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="data.check" e-checked="data.check" />
                    </script>
                </div>
            </div>
            <div class="col-xs-6" id="Assigned">
                <div class="common-btn">
                    <ul class="list-inline text-left"><li><button ng-click="RemovePO()" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><<</button></li></ul>
                </div>

                <div>

                    <div style="color:black;" id="Grid45" ej-grid e-datasource="selectedPOList" e-allowscrolling="true" e-summaryrows="summaryassignRows"
                         e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-pageSettings-pageSize="10" e-allowResizing="true" e-actionComplete="refresh"
                         e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">

                        <div e-columns>
                            <div e-column e-template="#checkboxTemplate" e-textalign="center" e-width="40"></div>
                            <div e-column e-type="string" e-field="Id" e-headertext="POId" e-width="50"></div>
                            <div e-column e-type="string" e-field="PODate" e-headertext="PODate" e-width="60"></div>
                            <div e-column e-type="string" e-field="DocRefNo" e-headertext="DocRefNo" e-width="80"></div>
                            <div e-column e-type="string" e-field="StandardName" e-headertext="Vendor" e-width="100"></div>
                            <div e-column e-type="string" e-field="TransactionAmount" e-headertext="Amount" e-width="80" e-textalign="right"></div>
                            <div e-column e-type="string" e-field="LCAmount" e-headertext="LCAmount" e-width="80" e-textalign="right"></div>
                            <div e-column e-type="string" e-field="BalanceAmount" e-headertext="BalanceAmount" e-width="80" e-textalign="right"></div>
                            <div e-column e-type="string" e-template="#InputAmount" e-headertext="Amount" e-width="100"></div>
                            <div e-column e-type="string" e-field="Currency" e-headertext="Currency" e-width="30"></div>
                            <div e-column e-type="string" e-field="PaymentTerm" e-headertext="Payment Term" e-width="70"></div>
                            <div e-column e-type="string" e-field="OrderSpecifi" e-headertext="Order Specific" e-width="70"></div>
                            <div e-column e-type="string" e-field="ContractNo" e-headertext="ContractNo" e-width="80"></div>
                            <div e-column e-field="Flag" e-headertext="State" e-width="60"></div>
                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.check" e-checked="data.check" />
                        </script>
                        <script type="text/template" id="InputAmount">
                            <div class="col-sm-10" style="padding:0px; width:70px;">
                                <input type="text" ng-model="data.Amount" ng-blur="$parent.CalculateAmount(this);" n-decimals="1" style="color:black;" class="form-control" />
                            </div>
                        </script>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group">
            <label class="col-sm-3 control-label">Order Specific</label>
            <div class="col-sm-5">
