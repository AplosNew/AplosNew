                        <option value="Active">Active</option>
                        <option value="Hold">Hold</option>
                        <option value="Cancel">Cancel</option>
                        <option value="Close">Close</option>
                    </select>*@
                    <select name="Status" class="form-control" ng-model="purchaseLCNew.Status" ng-options="item.Value as item.Text for item in StatusList" tabindex="18">
