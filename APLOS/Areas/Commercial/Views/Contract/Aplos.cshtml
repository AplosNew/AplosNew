<togglable name="Contract"></togglable>
<div class="table-responsive modal-table aplos-grid-toggle">
    <div class="aplos-grid-toggle">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Service" role="tab" data-toggle="tab">Contract</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="GetReport('EXCEL');" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Lien Report</button></li>
                            </ul>
                        </div>
                        <div class="row text-right aplos-grid-toggle">
                            <div class="col-xs-12 col-sm-12 col-sm-12">
                                <div class="search-form">
                                    <div class="row">
                                        <div class="col-xs-12 col-sm-3 col-md-3">
                                            <div class="select-style">
                                                <select ng-model="searchBy">
                                                    <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-xs-12 col-sm-7 col-md-7">
                                            <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getSavedData()">
                                        </div>
                                        <div class="col-xs-12 col-sm-2 col-md-2">
                                            <button type="button" ng-click="getSavedData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div style="color:black;" id="Grid2" ej-grid e-datasource="contractList" e-recorddoubleclick="selectContract"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-headertext="Actions" e-template="#SalesAdd" e-width="160"></div>
                                <div e-column e-type="string" e-field="FileNo" e-headertext="File No" e-width="120"></div>
                                <div e-column e-type="string" e-field="Bank" e-headertext="Bank" e-width="150"></div>
                                <div e-column e-type="string" e-field="ContractNo" e-headertext="Contract No" e-width="100"></div>
                                <div e-column e-type="string" e-field="TotalQty" e-headertext="Quantity" e-width="100"></div>
                                <div e-column e-type="string" e-field="Amount" e-headertext="Value" e-width="100"></div>
                                <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="CreationDate" e-headertext="Creation Date" e-width="100"></div>
                                <div e-column e-type="string" e-field="CustomerName" e-headertext="Customer" e-width="150"></div>
                                <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="150"></div>
                                <div e-column e-type="string" e-field="ItemNo" e-headertext="ItemNo" e-width="180"></div>
                                <div e-column e-type="string" e-field="Id" e-headertext="ContractId" e-width="90"></div>
                                <div e-column e-type="string" e-field="MasterLCNo" e-headertext="MasterLC RefNo" e-width="100"></div>
                                <div e-column e-type="string" e-field="UDNo" e-headertext="UD No" e-width="100"></div>
                                <div e-column e-field="IsLC" e-headertext="IsLC" e-width="70"></div>
                                <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                            </div>
                        </div>
                        <script type="text/template" id="SalesAdd">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button style="color: #f3f3ec;background-color: #1c1f32;height: 25px;" title="Details" class="btn"><i class="glyphicon glyphicon-print" ng-click="$parent.MasterOrderReport(this);"></i></button></li>
                                    <li><button style="color: #f3f3ec;background-color: #1c1f32;height: 25px;" title="Summary" class="btn"><i class="glyphicon glyphicon-print" ng-click="$parent.GetDetailsReport(this);"></i></button></li>
                                    <li><button style="color: #f3f3ec;background-color: #1c1f32;height: 25px;" title="Proforma Invoice" class="btn"><i class="glyphicon glyphicon-print" ng-click="$parent.ProformaInvoiceReport(this);"></i></button></li>
                                    <li><button style="color: #f3f3ec;background-color: #1c1f32;height: 25px;" title="Proforma Invoice without Agent" class="btn"><i class="glyphicon glyphicon-print" ng-click="$parent.ProformaInvoiceReport1(this);"></i></button></li>
                                </ul>
                            </div>
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

