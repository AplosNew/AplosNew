<togglable name="Master LC"></togglable>
<div class="form-elements form-horizontal">
    <div class="row" id="mainDiv">
        <input type="hidden" ng-model="modelNew.Id">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Service" role="tab" data-toggle="tab">LC</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="AddInfo" role="tab" data-toggle="tab">Add Info</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="T&C" role="tab" data-toggle="tab">T&C</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">Opening Bank</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" data-toggle="tab">LC Clauses</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="MasterLCForm">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" title="Version">Last Version</label>
                            <label class="col-sm-2 control-label" title="Version">{{masterLC.Version}}</label>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Benificiary Bank<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Benificiary Bank" class="form-control" ng-model="masterLC.BenificiaryBankId" ng-options="item.Id as item.AccountTitle for item in bankMasterList" required tabindex="1">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Opening Bank<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Opening Bank" ng-model="masterLC.OpeningBank" class="form-control" readonly required>
                                    <span class="input-group-btn">
                                        <button ng-click="ShowNBPopUp();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Advising Bank</label>
                            <div class="col-sm-8">
                                @*<div class="select-style">
                                        <select name="Lein Bank" class="form-control" ng-model="masterLC.LeinBankId" ng-options="item.Value as item.Text for item in bankList" required tabindex="5">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>*@
                                <input type="text" name="Advising Bank" ng-model="masterLC.LeinBank" class="form-control" tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Negotiating Bank<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Negotiating Bank" id="OB" class="form-control" ng-model="masterLC.NegotiatingBankId" ng-options="item.Id as item.AccountTitle for item in bankMasterList" tabindex="7">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Master LC No<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="LCRef" ng-model="masterLC.LCRef" class="form-control" maxlength="50" required tabindex="7">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Expiry Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="LC Date" ng-model="masterLC.ExpiryDate" datepicker class="form-control" required tabindex="9">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Port <span style="text-transform:lowercase">Of</span> Loading<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Port Of Loading" class="form-control" ng-model="masterLC.PortOfLoadingId" ng-options="item.Value as item.Text for item in portList" tabindex="14">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Final Destination<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Destination" class="form-control" ng-model="masterLC.FinalDestinationId" ng-options="item.Value as item.Text for item in destinationList" tabindex="13">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Last Shipment Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="LC Shipment Date" ng-model="masterLC.LCShipmentDate" datepicker class="form-control" required tabindex="9">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Amount<sup>*</sup></label>
                            <div class="col-sm-3 show-message">
                                <input type="text" n-decimals="2" name="Amount" ng-model="masterLC.Amount" class="form-control" maxlength="15" required tabindex="12">
                            </div>
                            <label class="col-sm-2 control-label" style="margin-left:-25px">Currency<sup>*</sup></label>
                            <div class="col-sm-3 show-message" style="padding-right: 0px; width: 69px;">
                                <div class="select-style">
                                    <select id="currencyId" class="form-control" tabindex="15" name="Currency" ng-model="masterLC.CurrencyId" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in currencyList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>


                        <div class="form-group">
                            <label class="col-sm-4 control-label">Insurance Company</label>
                            <div class="col-sm-8">
                                <input type="text" name="Advising Bank" ng-model="masterLC.InsuranceCompany" class="form-control" tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Insurance Cover Note No</label>
                            <div class="col-sm-8">
                                <input type="text" name="Advising Bank" ng-model="masterLC.InsuranceCoverNote" class="form-control" tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">IsClose</label>
                            <div class="col-sm-1">
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" ng-model="masterLC.IsClose" ng-checked="masterLC.IsClose">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                            <label class="col-sm-3 control-label">Additional Info Varify</label>
                            <div class="col-sm-4">
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" ng-model="masterLC.AdditionalInfoVarify" ng-checked="masterLC.AdditionalInfoVarify">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-5"> <button ng-click="GetEditSalesOrderList();" style="background:{{bgcolor}}" class="btn single-small-btn"><i class="glyphicon glyphicon-th-list"></i>LC Article Verify</button></div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Customer" ng-model="masterLC.PartyName" class="form-control" readonly required>
                                    <span class="input-group-btn">
                                        <button ng-click="ShowCustomerPopUpNew();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Opening Bank Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="masterLC.OpeningDescription" tabindex="2" maxlength="250"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Advising Bank Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="masterLC.LeinDescription" tabindex="4" maxlength="250"></textarea>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">LC Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="LC Date" ng-model="masterLC.LCDate" datepicker class="form-control" required tabindex="6">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Type<sup>*</sup></label>
                            <div class="col-sm-4 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="masterLC.Type" name="Type" ng-change="changeType();" required tabindex="10">
                                        <option value="">--Select--</option>
                                        <option value="Usance">Usance</option>
                                        <option value="AtSight">At Sight</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <input type="text" name="Tenure" ng-disabled="masterLC.Type==='AtSight'" ng-model="masterLC.Tenure" class="form-control" n-decimals="2" tabindex="12">
                            </div>
                            <label class="col-sm-2 control-label"><span style="text-transform:lowercase">day(s)</span> </label>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Shipment Mode<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Shipment Mode" class="form-control" ng-model="masterLC.ShipmentModeId" ng-options="item.Value as item.Text for item in shipmentModeList" ng-change="SetOtherDates();" required tabindex="108">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Port <span style="text-transform:lowercase">Of</span> Discharge<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Port Of Landing" class="form-control" ng-model="masterLC.PortOfLandingId" ng-options="item.Value as item.Text for item in portList" tabindex="14">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description Of Goods And/Or Services</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="masterLC.DescriptionOfGoodsAndOrServices" maxlength="500" tabindex="7"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="masterLC.Remarks" maxlength="250" tabindex="7"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Insurance Company Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="masterLC.InsuranceCompanyDescription" tabindex="4" maxlength="250"></textarea>
                            </div>
                        </div>


                        <div class="form-group">
                            <label class="col-sm-4 control-label">Payment Term Varify</label>
                            <div class="col-sm-1">
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" ng-model="masterLC.PaymentTermVarify" ng-checked="masterLC.PaymentTermVarify">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                            <label class="col-sm-3 control-label">Terms and Condition Varify</label>
                            <div class="col-sm-4">
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" ng-model="masterLC.TermsandConditionVarify" ng-checked="masterLC.TermsandConditionVarify">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveMasterLC();" @*ng-disabled="masterLC.Version>1"*@ class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" ng-disabled="masterLC.Version>1" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
                <div class="clearfix"></div>
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="GetPopUpContract();" ng-disabled="masterLC.Id==null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Contract</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="content-container-fluid" style="color:black;overflow:scroll">
                            <div style="color:black;" id="GridCon" ej-grid e-datasource="savedcontractList" e-gridlines="vertical" e-allowfiltering="true"
                                 e-allowpaging="true" e-allowsorting="true" e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="Actions" e-width="30">
                                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 25px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.deleteModal($event);" style="margin: -6px;"></i></button>
                                    </div>
                                    <div e-column e-field="Id" e-headertext="Contract No" e-width="80"></div>
                                    <div e-column e-type="string" e-field="FileNo" e-headertext="File No" e-width="120"></div>
                                    <div e-column e-type="string" e-field="ContractNo" e-headertext="Contract No" e-width="100"></div>
                                    <div e-column e-type="string" e-field="CustomerName" e-headertext="Customer" e-width="150"></div>
                                    <div e-column e-field="PaymentTerm" e-headertext="PaymentTerm" e-width="150"></div>
                                    <div e-column e-type="string" e-field="TotalQty" e-headertext="Quantity" e-width="100"></div>
                                    <div e-column e-type="string" e-field="Amount" e-headertext="Value" e-width="100"></div>
                                    <div e-column e-type="string" e-field="Bank" e-headertext="Bank" e-width="150"></div>
                                    <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="CreationDate" e-headertext="Creation Date" e-width="100"></div>
                                    <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="150"></div>
                                    <div e-column e-type="string" e-field="ItemNo" e-headertext="ItemNo" e-width="180"></div>
                                    <div e-column e-type="string" e-field="Id" e-headertext="ContractId" e-width="90"></div>
                                    <div e-column e-type="string" e-field="MasterLCNo" e-headertext="MasterLC RefNo" e-width="100"></div>
                                    <div e-column e-type="string" e-field="UDNo" e-headertext="UD No" e-width="100"></div>
                                    <div e-column e-field="IsLC" e-headertext="IsLC" e-width="70"></div>
                                    <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="150"></div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" id="addTermsAndConditions">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="AddTermsAndConditions();" ng-disabled="masterLC.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Terms&Conditions</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12" ng-show="TermsAndConditionsList.length>0">
                        <div id="GridContractTermsAndConditions" ej-grid e-datasource="TermsAndConditionsList"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="false"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true" e-allowResizing="true">
                            <div e-columns>
                                <div e-column e-headertext="Actions" e-template="#ShowActionButtonsBOM" e-width="50"></div>
                                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="40"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="50"></div>
                                <div e-column e-field="Group" e-headertext="Group" e-width="80"></div>
                                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="140"></div>
                                <div e-column e-template="#UserName" e-headertext="UserName" e-width="140"></div>
                                <div e-column e-field="Description" e-headertext="Description" e-width="140"></div>
                                <div e-column e-template="#Remarks" e-headertext="Remarks" e-width="140"></div>
                                <div e-column e-template="#Con" e-field="IsContract" e-headertext="IsContract" e-width="50"></div>
                                <div e-column e-template="#MLC" e-field="IsMasterLC" e-headertext="IsMasterLC" e-width="50"></div>
                            </div>
                        </div>
                    </div>
                    <script type="text/template" id="ShowActionButtonsBOM">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeBoMDetail(this);" style="margin: -6px;"></i></button>
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Edit" class="btn"><i class="glyphicon glyphicon-pencil" ng-click="$parent.SaveRowData(this);" style="margin: -6px;"></i></button>
                    </script>
                    <script type="text/template" id="Con">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" disabled ng-model="data.IsContract" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </script>
                    <script type="text/template" id="MLC">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" disabled ng-model="data.IsMasterLC" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </script>
                    <script type="text/template" id="UserName">
                        <input type="text" name="UserName" ng-model="data.UserName" class="form-control" tabindex="3" maxlength="50">
                    </script>
                    <script type="text/template" id="Remarks">
                        <textarea class="form-control" rows="1" ng-model="data.Remarks" tabindex="2" maxlength="250"></textarea>
                    </script>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div ng-form="addInfoForm">
                    <div class="row">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Sequence" tabindex="1" ej-numerictextbox e-decimalplaces="0" e-enablertl="false" e-value="addInfo.Sequence" e-width="100%" required />
                                </div>
                            </div>

                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="addInfo.Remarks" maxlength="250" tabindex="102"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12">
                            <div class="form-group" show-errors>
                                <label class="col-sm-2 control-label">Description<sup>*</sup></label>
                                <div class="col-sm-10 show-message">
                                    <textarea class="form-control" rows="5" name="Description" ng-model="addInfo.Description" maxlength="1000" tabindex="103" required></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="SaveMasterLCAddInfo();" ng-disabled="masterLC.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{ActionAdd}}</button></li>
                                    <li> <button ng-click="ClearAddInfo();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-xs-12">
                            <div style="color:black;" id="GridAddInfo" ej-grid e-datasource="masterLCAddInfoList" e-gridlines="vertical" e-allowfiltering="true"
                                 e-recorddoubleclick="GetAddInfo" e-allowpaging="true" e-allowsorting="true" e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="Actions" e-width="20">
                                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 25px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.deleteAddInfoModal($event);" style="margin: -6px;"></i></button>
                                    </div>
                                    <div e-column e-field="Sequence" e-headertext="Sequence" e-width="50"></div>
                                    <div e-column e-field="Description" e-headertext="Description" e-width="150"></div>
                                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row">
