<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Fund
</h3>
<div ng-form name="ModelNewForm" class="form-elements form-horizontal">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="fundutilization" role="tab" data-toggle="tab">Fund Utilization</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="buyerdeduction" role="tab" data-toggle="tab">Buyer Deduction</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="ModelNewForm1">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Utilization</th>
                                        <th>Utilization Text</th>
                                        <th>Percentage(%)</th>
                                        <th>Currency</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in fundUtilizationList">
                                        <td>{{x.Text}}</td>
                                        <td><input type="text" class="form-control" ng-model="x.FundUtilizationText"></td>
                                        <td><input type="text" n-decimals="2" class="form-control" ng-model="x.Percentage" ng-disabled="x.Text==='Negotiable'" ng-change="getPercentageValue();"></td>
                                        <td>
                                            <div class="select-style">
                                                <select name="Currency" class="form-control" ng-model="x.CurrencyId" ng-options="item.Value as item.Text for item in currencyList">
                                                    <option value=""></option>
                                                </select>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total:</strong></td>
                                        <td></td>
                                        <td class="text-left"><strong>{{fundUtilizationList | sumByKey : 'Percentage' }}</strong></td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="ModelNewForm2">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Deduction</th>
                                        <th>Deduction Text</th>
                                        <th>Percentage(%)</th>
                                        <th>Currency</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in buyerDeductionList">
                                        <td>{{x.Text}}</td>
                                        <td><input type="text" class="form-control" ng-model="x.FundUtilizationText"></td>
                                        <td><input type="text" n-decimals="2" class="form-control" ng-model="x.Percentage"></td>
                                        <td>
                                            <div class="select-style">
                                                <select name="Currency" class="form-control" ng-model="x.CurrencyId" ng-options="item.Value as item.Text for item in currencyList">
                                                    <option value=""></option>
                                                </select>
                                            </div>
                                        </td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveBuyerDeduction();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        </ul>
                    </div>
                </div>
               
            </div>
        </div>
        
    </div>
</div>