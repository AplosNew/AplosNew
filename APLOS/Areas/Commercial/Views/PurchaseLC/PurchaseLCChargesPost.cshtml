@*<togglable name="Purchase LC Charges Post"></togglable>*@

<h3 class="site-heading" style="cursor:default"><span class="glyphicon glyphicon-info-sign"></span>  Purchase LC Charges Post</h3>
<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);getSavedData();" href="" data-toggle="tab">Non Posted</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);getData();" href="" data-toggle="tab">Posted</a></li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <div class="form-elements form-horizontal" ng-form name="PurchaseLCChargesForm">
            <input type="hidden" ng-model="purchaseLCNew.Id">
            <div class="row">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="popUpData" ej-grid e-datasource="purchaseLCList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                         e-recorddoubleclick="" e-filtersettings-filterType="excel" e-enabletouch="true"
                         e-allowselection="true"
                         e-detailstemplate="detailTemp"
                         e-detailsdatabound="detailgrid">
                        <div e-columns>
                            <div e-column e-template="#checkboxLC" e-headertext="Apply" e-textalign="center" e-width="10"></div>
                            <div e-column e-field="LCRef" e-headertext="LC No" e-width="20"></div>
                            <div e-column e-field="Type" e-headertext="Type" e-width="20"></div>
                            <div e-column e-field="Version" e-headertext="Version" e-width="15"></div>
                            <div e-column e-headertext="Opening Date" e-width="30" e-template="#lcPostigDate"></div>
                            @*<div e-column e-field="LCDate" e-headertext="Opening Date" e-width="30"></div>*@
                            <div e-column e-field="Amount" e-headertext="Opening Value" e-width="20"></div>
                            <div e-column e-field="AmendmentDate" e-headertext="Amendment Date" e-width="30"></div>
                            <div e-column e-field="AmendmentAmount" e-headertext="Amendment Value" e-width="20"></div>
                            <div e-column e-field="ExpiryDate" e-headertext="Expiry Date" e-width="30"></div>
                            <div e-column e-field="Currency" e-headertext="Currency" e-width="15"></div>
                            <div e-column e-field="PartyName" e-headertext="Vendor" e-width="50"></div>
                            <div e-column e-field="OpeningBank" e-headertext="Opening Bank" e-width="80"></div>
                            @*<div e-column e-headertext="Tax" e-commands="commandTax" e-isunbound=true e-textalign="center" e-width="60"></div>*@

                            @*<div e-column e-headertext="Actions" e-width="20">
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon" title="Tax" ng-click="$parent.onClickTax('popUpData');" style="margin: -6px;">Tax</i></button>
                                </div>*@
                        </div>
                    </div>
                </div>
                <script type="text/template" id="lcPostigDate">
                    <input type="text" ng-model="data.LCDate" datepicker class="form-control">
                </script>
                <script type="text/template" id="checkboxLC">
                    <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
                </script>
                <script id="tabGridContents" type="text/x-jsrender">
                    <div class="tabcontrol" id="Test">
                        <ul>
                            <li><a href="#gridTab{{:Id}}">Charges Details</a></li>
                        </ul>
                        <div id="gridTab{{:Id}}">
                            <div id="detailGrid"></div>
                        </div>
                    </div>
                </script>
            </div>

            <div class="clearfix"></div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
                </ul>
            </div>
        </div>
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <div ng-form="tabForm2">
            <div class="content-container-fluid" style="color:black;overflow:scroll">
                <div style="color:black;" id="GridPost" ej-grid e-datasource="purchaseLCChargesPostedList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                     e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" e-actioncomplete="actionCompleteSelected3">
                    <div e-columns>
                        <div e-column e-field="PurchaseLCId" e-headertext="LC No" e-width="20"></div>
                        <div e-column e-field="DocRefNo" e-headertext="LC Ref" e-width="20"></div>
                        <div e-column e-field="Type" e-headertext="Type" e-width="20"></div>
                        <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="40"></div>
                        <div e-column e-field="Amount" e-headertext="Amount" e-width="20"></div>
                        <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="15"></div>
                        <div e-column e-field="VendorName" e-headertext="Vendor" e-width="50"></div>
                        <div e-column e-field="OpeningBankMaster" e-headertext="Opening Bank" e-width="50"></div>
                        <div e-column e-field="IsPark" e-headertext="Park/Post" e-width="50"></div>
                        <div e-column e-headertext="Report" e-width="40">
                            <button style="color: #f3f3ec;background-color: #1c1f32;" title="PDF" class="btn"><i class="fa fa-file-word-o" ng-click="$parent.onClickReportDownloadWord($event);"></i></button>
                            <button style="color: #f3f3ec;background-color: #1c1f32;" title="XL" class="btn"><i class="fa fa-file-excel-o" ng-click="$parent.onClickReportDownloadExcel($event);"></i></button>
                        </div>
                        <div e-column e-headertext=" Action " e-template="#DeleteTemplate" e-width="40"></div>

                    </div>
                </div>
                <script id="DeleteTemplate" type="text/template">
                    <div class="common-btn">
                        <ul class="common-btn list-inline text-center">
                            <li>
                                <button ng-disabled="data.IsPark=='Posted'" ng-click="$parent.onClickDeletePopUp(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Delete">
                                    <i class="glyphicon glyphicon-trash" style="color:orangered;"></i>
                                </button>

                            </li>
                        </ul>
                    </div>
                </script>
            </div>
        </div>
    </div>
</div>
@Html.Partial("~/Areas/Commercial/Views/Shared/_InputTaxCategoryUp.cshtml")

<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="removerPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="DeleteCharges();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="Postdelete(purchaseLCId,VoucherId)"></confirm-archive-generic>
