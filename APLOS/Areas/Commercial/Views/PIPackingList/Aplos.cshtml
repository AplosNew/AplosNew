<togglable name=" PI Packing List"></togglable>
<div class="form-elements form-horizontal" ng-form name="buyerNewForm">
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="PIPopUp();" class="btn"><i class="glyphicon glyphicon-plus"></i>Add PI</button></li>
        </ul>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="form-elements form-horizontal">
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI No :</span></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="PI No." ng-model="PImodelNew.PINo" class="form-control" maxlength="15" readonly required tabindex="5">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI REF # :</span></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Ref No." ng-model="PImodelNew.RefNo" class="form-control" maxlength="15" readonly required tabindex="5">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Address :</span></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Invoicing by address" ng-model="PImodelNew.InvoicingByAddress" class="form-control" maxlength="15" required tabindex="5" readonly>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI Date :</span></label>
                        <div class="col-sm-8 show-message">
                            @*<input type="text" name="PI Date" ng-model="PImodelNew.PIDate" datepicker class="form-control" maxlength="15" readonly required tabindex="5">*@
                            <input type="text" name="PI Date" ng-model="PImodelNew.PIDate" class="form-control" maxlength="15" readonly required tabindex="5">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Customer :</span><sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Customer" ng-model="PImodelNew.Customer" class="form-control" maxlength="15" readonly required tabindex="5" />
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Currency :</span><sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Currency" class="form-control" ng-model="PImodelNew.Currency" maxlength="15" readonly required tabindex="5" />
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Version :</span></label>
                        <div class="col-sm-8">
                            <input type="text" name="Version" class="form-control" ng-model="PImodelNew.VersionNo" maxlength="15" readonly required tabindex="5" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Buyer :</span><sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" name="Buyer" class="form-control" ng-model="PImodelNew.BuyerId" maxlength="15" readonly required tabindex="5" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-12">
                    <div class="row">
                        <div class="col-sm-12 table-responsive modal-table">

                            <div style="color:black;" id="GridPI" ej-grid e-datasource="DataList"
                                 e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
                                 e-allowselection="false">
                                <div e-columns>
                                    <div e-column e-type="string" e-field="MaterialGroupMasterId" e-headertext="Material Group" e-width="100"></div>
                                    <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="100"></div>
                                    <div e-column e-type="number" e-field="Quantity" e-headertext="Quantity" e-width="100"></div>
                                    <div e-column e-type="number" e-field="Rate" e-headertext="Rate" e-width="100"></div>
                                    <div e-column e-type="string" e-field="MaterialGroupUOMList" e-headertext="UoM" e-width="120"></div>
                                    <div e-column e-type="date" e-field="DeliveryDate" e-format="{0:dd-MMM-yyyy}" e-headertext="Delivery date" e-width="120"></div>
                                    <div e-column e-type="number" e-field="Amount" e-headertext="Amount" e-width="100"></div>
                                    <div e-column e-field="" e-template="#AllocatedQTY" e-headertext="Allocated Qty" e-width="80"></div>
                                    <div e-column e-headertext="Allocation" e-template="#Allocation" e-width="30"></div>
                                </div>
                            </div>

                            <script type="text/template" id="Allocation">
                                <button style="color: #f3f3ec;background-color: #1c1f32;" title="PO Items" class="btn"><i class="glyphicon glyphicon-search" ng-click="$parent.POQTYAllocation(this);" style="margin: -6px;"></i></button>
                            </script>

                            <script type="text/template" id="AllocatedQTY">
                                <div class="col-sm-10" style="padding:0px; width:70px;">
                                    <input type="text" ej-numerictextbox e-decimalplaces="2" e-value="" e-width="100" />
                                </div>
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="QTYAllocation" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Proforma Invoice Quantity Allocation<button type="button" class="close" ng-click="ClosePopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                @*<div style="padding-left: 900px;color:maroon;font-weight:bolder;"><label id="totalGRN" ng-model="totalGRNVal" class="text-right">Total GRN Qty:{{totalGRNVal}}|| RejectionQty:{{RejectionQty}}</label></div>*@

                <div class="col-lg-12">
                    <div style="color:black;" id="GridReqso" ej-grid e-datasource="soList" @*e-recorddoubleclick="GetSequence"*@
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                         e-filtersettings-filterType="excel" e-enabletouch="true" e-actioncomplete="actionCompleteSelected"
                         e-allowscrolling="true" e-showstackedheader="true" e-allowExcelExport='true' e-enableGroupingBar="true">
                        <div e-columns>
                            <div e-column e-headertext="" e-template="#SOChecked" e-textalign="center" e-width="30"></div>

                            <div e-column e-field="MaterialGroupMasterName" e-headertext="Group" e-width="80"></div>
                            <div e-column e-field="UserName" e-headertext="Material " e-width="120"></div>
                            <div e-column e-field="StandardName" e-headertext="Article" e-width="120"></div>
                            <div e-column e-field="FirstCharacteristicsValue" e-headertext="SKU1" e-width="80"></div>
                            <div e-column e-field="SecondCharacteristicsValue" e-headertext="SKU2" e-width="80"></div>
                            <div e-column e-field="ThirdCharacteristicsValue" e-headertext="SKU3" e-width="80"></div>

                            @*<div e-column e-field="TransactionQtyForPO" e-headertext="PO TransactionQty" e-width="80"></div>
                                <div e-column e-field="TransactionUoM" e-headertext="PO Transaction UOM" e-width="80"></div>
                                <div e-column e-field="allowCatedQty" e-headertext="Valid Qty Allocated" e-width="100"></div>
                                <div e-column e-field="RejectQty" e-headertext="Rejected Qty Allocated" e-width="100"></div>
                                <div e-column e-field="TransactionQty" e-template="#SOQty" e-headertext="GRNQtyAllocation" e-width="80"></div>
                                <div e-column e-field="RejectionQty" e-template="#SORejQty" e-headertext="RejectionQtyAllocation" e-width="80"></div>
                                <div e-column e-field="SalesOrderId" e-headertext="SalesOrderId" e-width="70"></div>*@
                        </div>
                    </div>
                    <script type="text/template" id="SOChecked">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Active" />
                    </script>
                    <script type="text/template" id="SORejQty">
                        <div class="col-sm-10" style="padding:0px; width:70px;">
                            <input type="text" ej-numerictextbox e-decimalplaces="2" e-value="data.RejectionQty" e-width="100" />
                        </div>
                    </script>
                    <script type="text/template" id="SOQty">
                        <div class="col-sm-10" style="padding:0px; width:70px;">
                            <input type="text" ej-numerictextbox e-decimalplaces="2" e-value="data.TransactionQty" e-width="100" />
                        </div>
                    </script>
                </div>



                <div class="clearfix"></div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="GrnRequisitionAllocationSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                        <li><button ng-click="ClosePopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="modal fade site-modal in" id="PIPOPopup" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">Proforma Invoice<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body">
                    <div class="row">
                        <div style="color:black;" id="GridPIPOPuP" ej-grid e-datasource="PIPopUpList" e-recorddoubleclick="GetPIPopUp"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
                             e-allowselection="false">
                            <div e-columns>
                                <div e-column e-type="string" e-field="PINo" e-headertext="PI No." e-width="100"></div>
                                <div e-column e-type="string" e-field="LastVersion" e-headertext="Last Version" e-width="100"></div>
                                <div e-column e-type="date" e-field="PIDate" e-format="{0:dd-MMM-yyyy}" e-headertext="PI Date" e-width="120"></div>
                                <div e-column e-type="string" e-field="RefNo" e-headertext="Ref No." e-width="100"></div>
                                <div e-column e-type="string" e-field="Currency" e-headertext="Currency" e-width="100"></div>

                                <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="120"></div>
                                <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="100"></div>
                                <div e-column e-type="string" e-field="InvoicingByAddress" e-headertext="InvoicingByAddress" e-width="100"></div>
                                <div e-column e-type="string" e-field="DeliveryByAddress" e-headertext="DeliveryByAddress" e-width="100"></div>
                            </div>
                        </div>
                    </div>
                    <script type="text/template" id="asasas">
                        <div class="text-right" style="width:100%">
                            <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.LoadPOBreakDownList(data);">{{data.GRNAmount |number:2}}</a>
                        </div>
                    </script>
                </div>
            </div>
        </div>
    </div>


</div>
<div class="table-responsive aplos-grid-toggle">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="row text-right">
                <div class="col-xs-12 col-sm-12 col-sm-12 ">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="PIPackingSearchBy">
                                        <option ng-repeat="option in searchByPIPackingList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="PIPackingSearch" ng-enter="LoadPIPackingList()">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="LoadPIPackingList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div style="color:black;" id="GridPI" ej-grid e-datasource="PIPackingGridList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
             e-allowselection="false">
            <div e-columns>
                <div e-column e-type="string" e-field="Id" e-headertext="PI Packing No." e-width="100"></div>
                <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="100"></div>
                <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                <div e-column e-type="date" e-field="AddedDate" e-format="{0:dd-MMM-yyyy}" e-headertext="PI Packing Date" e-width="120"></div>
            </div>
        </div>
    </div>
</div>

@*<confirm-modal></confirm-modal>*@
