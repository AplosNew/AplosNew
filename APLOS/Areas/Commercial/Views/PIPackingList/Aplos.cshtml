<togglable name=" PI Packing List"></togglable>
<div class="form-elements form-horizontal" ng-form name="PIPackingListNewForm">
    <div class="modal-body">
        <div class="row">           
            <div class="form-group">
                <div class="col-sm-12">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="table-responsive ">
                                <div style="color:black;" id="GridPIPackingList" ej-grid e-datasource="PIPackingMaterialGridList" @*e-recorddoubleclick="Get"*@
                                     e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
                                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
                                     e-allowselection="false">
                                    <div e-columns>
                                        <div e-column e-type="string" e-field="Id" e-headertext="PI Packing No." e-width="100"></div>
                                        <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="100"></div>
                                        <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                                        <div e-column e-type="date" e-field="AddedDate" e-format="{0:dd-MMM-yyyy}" e-headertext="PI Packing Date" e-width="120"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="row text-right">
                <div class="col-xs-12 col-sm-12 col-sm-12 ">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="PIPackingSearchBy">
                                        <option ng-repeat="option in searchByPIPackingList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="PIPackingSearch" ng-enter="LoadPIPackingList()">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="LoadPIPackingList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div style="color:black;" id="GridPI" ej-grid e-datasource="PIPackingGridList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
             e-allowselection="false">
            <div e-columns>
                <div e-column e-type="string" e-field="Id" e-headertext="PI Packing No." e-width="100"></div>
                <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="100"></div>
                <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                <div e-column e-type="date" e-field="AddedDate" e-format="{0:dd-MMM-yyyy}" e-headertext="PI Packing Date" e-width="120"></div>
            </div>
        </div>
    </div>
</div>

@*<confirm-modal></confirm-modal>*@
