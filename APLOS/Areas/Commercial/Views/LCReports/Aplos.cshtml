
<h3 class="site-heading">LC Reports</h3>

<div class="row">
    <div class="col-md-4">
        <div class="form-group" @*ng-hide="showFinanceDB"*@>
            <label class="col-sm-4 control-label">Base On<sup> *</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="GRNType" class="form-control" name="LC" ng-model="reportParameters.LCType" ng-change="getDataList()" tabindex="7" required>
                        <option value="contract">Contract</option>
                        <option value="masterLC">Master LC</option>
                        <option value="purchaseLC">Purchase LC</option>
                        @*<option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>*@
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4" style="margin-left: -50px;">

        <div class="form-group">
            <label class="col-sm-4 control-label" style="margin-left:20px">From Date<sup>*</sup></label>
            <div class="col-sm-8" style="margin-left: -50px;">
                <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="reportParameters.FromDate" />
            </div>

        </div>
    </div>
    <div class="col-md-4">
        @*<div class="col-md-12 col-sm-6 col-md-6">*@
        <div class="form-group">
            <label class="col-sm-4 control-label" style="margin-left:-131px">To Date<sup>*</sup></label>
            <div class="col-sm-8" style="margin-left: -50px;">
                <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="reportParameters.ToDate" />
            </div>
        </div>


    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            @*<li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
            <li><button ng-click="GetMasterLCList();" class="btn"><i @*class="glyphicon glyphicon-refresh"*@></i>View</button></li>
        </ul>
    </div>

            <div style="color:black;" id="GridMasterLC" ej-grid e-datasource="MasterLCList"  e-templaterefresh="refreshTemplateLC"
                 e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                <div e-columns>
                    @*<div e-column e-headertext="All" e-headertemplateid="#headerTemplate" e-template="#checkMasterLC" e-textalign="center" e-width="30"></div>*@

                    <div e-column e-headertext="All" e-headertemplateid="#headerTemplate" e-template="#checkMasterLC"  e-width="20"></div>
                    <div e-column e-field="MasterLCNo" e-headertext="Master LC No." e-width="100"></div>
                    <div e-column e-field="Vendor" e-headertext="Vendor" e-width="120"></div>
                    <div e-column e-field="PurchaseLCId" e-headertext="Purchase LC Id" e-width="100"></div>
                    <div e-column e-field="PurchaseLCRef" e-headertext="Purchase LC Ref" e-width="80"></div>
                    <div e-column e-field="LCOpeningDate" e-headertext="LC OpeningDate" e-width="80"></div>
                    <div e-column e-field="ExpiryDate" e-type="string" e-format="{0:dd-MMM-yyyy}" e-headertext="Expiry Date" e-width="90"></div>
                    <div e-column e-field="PurCurrencyCode" e-headertext="Currency" e-width="80"></div>
                    <div e-column e-field="ContractNo" e-headertext="Contract No" e-width="100"></div>
                    <div e-column e-field="FileNo" e-headertext="File No" e-width="80"></div>
                    <div e-column e-field="Customer" e-headertext="Customer" e-width="100"></div>

                    <div e-column e-field="MasterLCRefNo" e-headertext="Master LC No." e-width="100"></div>
                    <div e-column e-field="PurchaseLCAmount" e-headertext="Purchase LC Value" e-width="100"></div>
                    <div e-column e-field="Rate" e-headertext="Rate" e-width="100"></div>
                    <div e-column e-field="Type" e-headertext="Type" e-width="50"></div>
                    <div e-column e-field="Tenure" e-headertext="Tenure" e-width="50"></div>
                    <div e-column e-field="OpeningBank" e-headertext="Opening Bank" e-width="120"></div>
                    <div e-column e-field="BenificiaryBank" e-headertext="Benificiary Bank" e-width="120"></div>
                    <div e-column e-field="BenificiaryBankDescription" e-headertext="Benif.Bank Descp." e-width="120"></div>
                    <div e-column e-field="LeinBank" e-headertext="Lein Bank" e-width="120"></div>

                    <div e-column e-field="LeinBankDescription" e-headertext="Lein Bank Descp." e-width="150"></div>
                    @*<div e-column e-template="#checkMasterLC" e-headertext="" e-width="40"></div>
                      <div e-column e-template="#checkMasterLC" e-headertext="" e-width="40"></div>*@
                    <div e-column e-field="PortOfLoading" e-headertext="Port Of Loading" e-width="100"></div>
                    <div e-column e-field="FinalDestination" e-headertext="Final Destination" e-width="120"></div>
                    <div e-column e-field="Status" e-headertext="Status" e-width="120"></div>
                    <div e-column e-field="LCANo" e-headertext="LCANo" e-width="120"></div>
                    <div e-column e-field="PaymentBasedOn" e-headertext="PaymentBasedOn" e-width="150"></div>
                    <div e-column e-field="ShipmentDate" e-type="date" e-format="{0:dd-MMM-yyyy}" e-headertext="ShipmentDate" e-width="80"></div>
                    <div e-column e-field="PINo" e-headertext="PI No." e-width="150"></div>

                    <div e-column e-field="UDNo" e-headertext="UD No." e-width="100"></div>

                    <div e-column e-field="PONo" e-headertext="PO No." e-width="100"></div>
                    <div e-column e-field="OrderSpecific" e-headertext="Ord.Specific" e-width="100"></div>
                    <div e-column e-field="GRNNo" e-headertext="GRN No." e-width="100"></div>


                </div>
            </div>
            <script type="text/template" id="checkMasterLC">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="data.isSelected" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </script>

            <script type="text/x-jsrender" id="headerTemplate">
                <input type="checkbox" id="headchk" />
            </script>
           
    <div class="form-group">

        <div class="col-xs-12 col-sm-12 col-md-12">
            <ul class="common-btn list-inline text-left">
                <li>
                    <div ej-tooltip e-showshadow="true" e-content="All active master LC with corresponding contracts and purchase LC along with purchase order values" ng-click="MasterLCReport();" e-width="width">
                        <button class="btn"><i class="glyphicon glyphicon-file"></i>LC Report</button>
                    </div>

                    @*<div ej-tooltip e-showshadow="true" e-content="All active master LC with corresponding contracts and purchase LC along with purchase order values" ng-click="MasterOrderReport();" e-width="width">
                            <button class="btn"><i class="glyphicon glyphicon-file"></i> Master Order</button>
                        </div>*@
                </li>

            </ul>
        </div>

    </div>



</div>
