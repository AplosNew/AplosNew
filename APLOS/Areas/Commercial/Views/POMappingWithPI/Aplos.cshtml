<togglable name="PO Mapping With PI"></togglable>
<div class="form-elements form-horizontal" ng-form name="buyerNewForm">
    <div class="modal-body">
        <div class="row">
            <div class="form-elements form-horizontal">
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI No :</span></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="PI No." ng-model="PImodelNew.PINo" class="form-control" maxlength="15" readonly required tabindex="5">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI REF # :</span></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Ref No." ng-model="PImodelNew.RefNo" class="form-control" maxlength="15" readonly required tabindex="5">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Address :</span></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Invoicing by address" ng-model="PImodelNew.InvoicingByAddress" class="form-control" maxlength="15" required tabindex="5" readonly>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI Date :</span></label>
                        <div class="col-sm-8 show-message">
                            @*<input type="text" name="PI Date" ng-model="PImodelNew.PIDate" datepicker class="form-control" maxlength="15" readonly required tabindex="5">*@
                            <input type="text" name="PI Date" ng-model="PImodelNew.PIDate" class="form-control" maxlength="15" readonly required tabindex="5">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Customer :</span><sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Customer" ng-model="PImodelNew.Customer" class="form-control" maxlength="15" readonly required tabindex="5" />
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Currency :</span><sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Currency" class="form-control" ng-model="PImodelNew.CurrencyId" maxlength="15" readonly required tabindex="5" />
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Version :</span></label>
                        <div class="col-sm-8">
                            <input type="text" name="Version" class="form-control" ng-model="PImodelNew.VersionNo" maxlength="15" readonly required tabindex="5" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Buyer :</span><sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" name="Buyer" class="form-control" ng-model="PImodelNew.BuyerId" maxlength="15" readonly required tabindex="5" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-12">
                    <div class="row">
                        <div class="col-sm-12 table-responsive modal-table">

                            <div style="color:black;" id="GridPI" ej-grid e-datasource="DataList" 
                                 e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
                                 e-allowselection="false">
                                <div e-columns>
                                    <div e-column e-type="string" e-field="MaterialGroup" e-headertext="Material Group Name" e-width="100"></div>
                                    <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="100"></div>
                                    <div e-column e-type="number" e-field="Quantity" e-headertext="Quantity" e-width="100"></div>
                                    <div e-column e-type="number" e-field="Rate" e-headertext="Rate" e-width="100"></div>
                                    <div e-column e-type="string" e-field="MaterialGroupUOMList" e-headertext="UoM" e-width="120"></div>
                                    <div e-column e-type="date" e-field="DeliveryDate" e-format="{0:dd-MMM-yyyy}" e-headertext="Delivery date" e-width="120"></div>
                                    <div e-column e-type="number" e-field="Amount" e-headertext="Amount" e-width="100"></div>
                                    @*<div e-column e-type="button" e-field="Search" e-headertext="PO Items" e-width="100"></div>*@
                                    <div e-column e-headertext="PO Items" e-template="#POItemsTemplate" e-width="30"></div>

                                </div>
                            </div>

                            <script type="text/template" id="POItemsTemplate">
                                <button style="color: #f3f3ec;background-color: #1c1f32;" title="PO Items" class="btn"><i class="glyphicon glyphicon-search" ng-click="$parent.GetPOPopUpNew(this);" style="margin: -6px;"></i></button>
                            </script>
                        </div>
                    </div>
                </div>




            </div>
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="row text-right">
                <div class="col-xs-12 col-sm-12 col-sm-12 ">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="PISearchBy">
                                        <option ng-repeat="option in searchPIByList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="PISearch" ng-enter="LoadPISearchList()">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="LoadPISearchList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div style="color:black;" id="GridPI" ej-grid e-datasource="PIGridList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
             e-allowselection="false">
            <div e-columns>
                <div e-column e-type="string" e-field="PINo" e-headertext="PI No." e-width="100"></div>
                <div e-column e-type="string" e-field="LastVersion" e-headertext="Last Version" e-width="100"></div>
                <div e-column e-type="date" e-field="PIDate" e-format="{0:dd-MMM-yyyy}" e-headertext="PI Date" e-width="120"></div>
                <div e-column e-type="string" e-field="RefNo" e-headertext="Ref No." e-width="100"></div>
                <div e-column e-type="string" e-field="Currency" e-headertext="Currency" e-width="100"></div>

                <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="120"></div>
                <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="100"></div>
                @*<div e-column e-type="string" e-field="InvoicingByAddress" e-headertext="InvoicingByAddress" e-width="100"></div>
                    <div e-column e-type="string" e-field="DeliveryByAddress" e-headertext="DeliveryByAddress" e-width="100"></div>*@
            </div>
        </div>
    </div>
</div>



<div class="modal fade site-modal in" id="POPopUpNew" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">
                PO Items
                <button type="button" class="close" ng-click="closePOPopup();">&times;</button>
            </div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div id="GridPacking" ej-grid e-datasource="PODataList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#POTemplate" e-template="#POcheckboxTemplate" e-textalign="center" e-width="20"></div>
                            <div e-column e-field="PODetailId" e-headertext="PO DetailId" e-width="50" e-filter="false"></div>
                            <div e-column e-field="POQuantity" e-headertext="PO Quantity" e-width="50" e-filter="false"></div>
                            <div e-column e-field="POUoM" e-headertext="PO UoM" e-width="50" e-filter="false"></div>
                            @*<div e-column e-field="PIMaterialID" e-headertext="PI MaterialID" e-width="50" e-filter="false"></div>

                            <div e-column e-field="QuantityAtPIUoM" e-headertext="Quantity At PIUoM" e-width="50" e-filter="false"></div>
                            <div e-column e-field="PIUoMId" e-headertext="PIUoMId" e-width="50" e-filter="false"></div>
                                                *@
                            <div e-column e-field="PORate" e-headertext="PO Rate" e-width="50" e-filter="false"></div>
                            @*<div e-column e-field="Qty" e-headertext="Quantity" e-width="130"></div>
                            <div e-column e-field="UoM" e-headertext="UoM" e-width="50"></div>*@

                            @*<div e-column e-field="UoM" e-headertext="Article" e-width="50"></div>
                            <div e-column e-field="UoM" e-headertext="UoM" e-width="50"></div>
                            <div e-column e-field="UoM" e-headertext="UoM" e-width="50"></div>

                            <div e-column e-field="UoM" e-headertext="UoM" e-width="50"></div>
                            <div e-column e-field="UoM" e-headertext="UoM" e-width="50"></div>*@
                        </div>
                    </div>

                    <script type="text/x-jsrender" id="POTemplate">
                        <input type="checkbox" id="POheadchk" />
                    </script>

                    <script type="text/template" id="POcheckboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.check" e-value="data.check" />
                    </script>

                </div>
                <div class="common-btn" style="padding-right: 15px;">
                    <ul class="list-inline text-right">
                        <li>
                        <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button>
                        <button ng-click="closePOPopup();" class="btn">Close</button>
                        </li>
                    </ul>
                </div>
            </div>
            
        </div>
    </div>
</div>


