<togglable name="PO Mapping With PI"></togglable>
<div class="form-elements form-horizontal" ng-form name="buyerNewForm">
    <div class="modal-body">
        <div class="row">
            <div class="form-elements form-horizontal">
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI No :</span></label>
                        <div class="col-sm-8 show-message">
                            @*<input type="text" name="PI No." ng-model="PImodelNew.PINo" class="form-control" maxlength="15" readonly required tabindex="5">*@
                            <label class="col-sm-4 control-label">{{PImodelNew.PINo}}</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI REF # :</span></label>
                        <div class="col-sm-8 show-message">
                            @*<input type="text" name="Ref No." ng-model="PImodelNew.RefNo" class="form-control" maxlength="15" readonly required tabindex="5">*@
                            <label class="col-sm-4 control-label">{{PImodelNew.RefNo}}</label>
                        </div>
                    </div>
                    <!--<div class="form-group">
                            <label class="col-sm-4 control-label"><span style="font-weight:bold">Address :</span></label>
                            <div class="col-sm-8 show-message">-->
                    @*<input type="text" name="Invoicing by address" ng-model="PImodelNew.InvoicingByAddress" class="form-control" maxlength="15" required tabindex="5" readonly>*@
                    <!--<label class="col-sm-4 control-label">{{PImodelNew.InvoicingByAddress}}</label>
                        </div>
                    </div>-->

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Currency :</span></label>
                        <div class="col-sm-8 show-message">
                            @*<input type="text" name="Currency" class="form-control" ng-model="PImodelNew.Currency" maxlength="15" readonly required tabindex="5" />*@
                            <label class="col-sm-4 control-label">{{PImodelNew.Currency}}</label>
                        </div>
                    </div>

                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI Date :</span></label>
                        <div class="col-sm-8 show-message">
                            @*<input type="text" name="PI Date" ng-model="PImodelNew.PIDate" datepicker class="form-control" maxlength="15" readonly required tabindex="5">*@
                            @*<input type="text" name="PI Date" ng-model="PImodelNew.PIDate" class="form-control" maxlength="15" readonly required tabindex="5">*@
                            <label class="col-sm-4 control-label">{{PImodelNew.PIDate}}</label>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Customer :</span></label>
                        <div class="col-sm-8 show-message">
                            @*<input type="text" name="Customer" ng-model="PImodelNew.Customer" class="form-control" maxlength="15" readonly required tabindex="5" />*@
                            <label class="col-sm-4 control-label">{{PImodelNew.Customer}}</label>
                        </div>
                    </div>

                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Version :</span></label>
                        <div class="col-sm-8">
                            @*<input type="text" name="Version" class="form-control" ng-model="PImodelNew.VersionNo" maxlength="15" readonly required tabindex="5" />*@
                            <label class="col-sm-4 control-label">{{PImodelNew.VersionNo}}</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Buyer :</span></label>
                        <div class="col-sm-8">
                            @*<input type="text" name="Buyer" class="form-control" ng-model="PImodelNew.Buyer" maxlength="15" readonly required tabindex="5" />*@
                            <label class="col-sm-4 control-label">{{PImodelNew.Buyer}}</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="row">
                    <div style="color:black;" id="GridPI1" ej-grid e-datasource="DataList"
                         e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
                         e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
                         e-allowselection="false">
                        <div e-columns>
                            <div e-column e-type="string" e-field="MaterialGroup" e-headertext="Material Group Name" e-width="100"></div>
                            <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="100"></div>
                            <div e-column e-type="date" e-field="DeliveryDate" e-headertext="Delivery date" e-width="120"></div>
                            <div e-column e-type="number" e-field="Quantity" e-headertext="Quantity" e-width="100"></div>
                            <div e-column e-type="string" e-field="MaterialGroupUOM" e-headertext="UoM" e-width="120"></div>
                            <div e-column e-type="number" e-field="Rate" e-headertext="Rate" e-width="100"></div>
                            <div e-column e-type="number" e-field="Amount" e-headertext="Amount" e-width="100"></div>
                            <div e-column e-type="number" e-field="POTaggedQuantity" e-headertext="PO Tagged Quantity" e-width="100"></div>
                            <div e-column e-type="number" e-field="POTaggedAmount" e-headertext="PO Tagged Amount" e-width="100"></div>
                            <div e-column e-headertext="PO Items" e-template="#POItemsTemplate" e-width="30"></div>
                        </div>
                    </div>

                    <script type="text/template" id="POItemsTemplate">
                        <button ng-click="$parent.GetPOPopUpNew(this);" style="color: #f3f3ec;background-color: #1c1f32;" title="PO Items" class="btn"><i class="glyphicon glyphicon-search"  style="margin: -6px;"></i></button>
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="row text-right">
                <div class="col-xs-12 col-sm-12 col-sm-12 ">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="PISearchBy">
                                        <option ng-repeat="option in searchPIByList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="PISearch" ng-enter="LoadPISearchList()">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="LoadPISearchList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div style="color:black;" id="GridPI" ej-grid e-datasource="PIGridList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
             e-allowselection="false">
            <div e-columns>
                <div e-column e-type="string" e-field="PINo" e-headertext="PI No." e-width="100"></div>
                <div e-column e-type="string" e-field="RefNo" e-headertext="Ref No." e-width="100"></div>
                <div e-column e-type="date" e-field="PIDate" e-format="{0:dd-MMM-yyyy}" e-headertext="PI Date" e-width="120"></div>
                <div e-column @*e-type="number"*@ e-field="LastVersionNo" e-headertext="Last Version" e-width="100"></div>
                <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="120"></div>
                <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="100"></div>
                <div e-column e-type="string" e-field="Currency" e-headertext="Currency" e-width="100"></div>

                <div e-column e-type="string" e-field="Amount" e-headertext="Amount" e-width="100"></div>
                <div e-column e-type="string" e-field="POTaggedAmount" e-headertext="PO Tagged Amount" e-width="100"></div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade site-modal in" id="POPopUpNew" role="dialog" data-backdrop="static">
    <div class="row">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    PO Items
                    <button type="button" class="close" ng-click="closePOPopup();">&times;</button>
                </div>
                <div class="modal-body">
                  
                    <div class="row" @*style="background-color:lightgray;"*@>
                        <div class="form-element-ctrl form-horizontal">
                            <div class="col-xs-12">
                                <div class="col-xs-12 col-sm-4 col-md-4">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label"><span style="font-weight:bold;">Material Group :</span></label>
                                        <label class="col-sm-8 control-label">{{POPopUpHeader.MaterialGroup}}</label>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Quantity :</span></label>
                                        <label class="col-sm-8 control-label">{{POPopUpHeader.Quantity}}&nbsp;({{POPopUpHeader.MaterialGroupUOM}})</label>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-4 col-md-4">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Description :</span></label>
                                        <label class="col-sm-8 control-label">{{POPopUpHeader.Description}}</label>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Rate :</span></label>
                                        <label class="col-sm-8 control-label">{{POPopUpHeader.Rate}}</label>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-4 col-md-4">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Delivery Date :</span></label>
                                        <label class="col-sm-8 control-label">{{POPopUpHeader.DeliveryDate}}</label>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Amount :</span></label>
                                        <label class="col-sm-8 control-label">{{POPopUpHeader.Amount}}&nbsp;({{PImodelNew.Currency}})</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div id="GridPacking" ej-grid e-datasource="PODataList" e-templaterefresh="refreshPOMappingWithPI"
                         e-summaryrows="summaryPO" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                         e-allowResizing="true" e-allowselection="true" e-filtersettings-filterType="excel" e-allowscrolling="true">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#POTemplate" e-template="#POcheckboxTemplate" e-textalign="center" e-width="45"></div>
                            <div e-column e-field="PODetailId" e-headertext="PO DetailId" e-width="60" e-filter="false"></div>
                            <div e-column e-field="Vendor" e-headertext="Vendor" e-width="120"></div>
                            <div e-column e-field="DeliveryDate" e-headertext="Delivery Date" e-width="80"></div>
                            <div e-column e-field="MaterialGroup" e-headertext="Material Group" e-width="80"></div>
                            <div e-column e-field="Material" e-headertext="Material" e-width="100"></div>
                            <div e-column e-field="Article" e-headertext="Article" e-width="130"></div>
                            <div e-column e-field="SKU1" e-headertext="SKU1" e-width="60"></div>
                            <div e-column e-field="SKU2" e-headertext="SKU2" e-width="60"></div>
                            <div e-column e-field="SKU3" e-headertext="SKU3" e-width="60"></div>
                            <div e-column e-field="POQuantity" e-headertext="PO Qty" e-width="80" e-filter="false"></div>
                            <div e-column e-field="POUoM" e-headertext="PO UoM" e-width="50" e-filter="false"></div>
                            <div e-column e-field="PORate" e-headertext="PO Rate" e-width="60" e-filter="false"></div>
                            <div e-column e-field="POAmount" e-headertext="PO Amount" e-width="80" e-filter="false"></div>
                            <div e-column e-field="POCurrency" e-headertext="PO Currency" e-width="50" e-filter="false"></div>
                            <div e-column e-field="POQuantity" e-headertext="Quantity At PIUoM" e-width="60"></div>
                            <div e-column e-field="PIUoM" e-headertext="PIUoM" e-width="50"></div>
                            <div e-column e-field="PackedQty" e-headertext="Pack Quantity" e-width="60"></div>
                            @*<div e-column e-field="BalanceToPack" e-headertext="Balance To Pack" e-width="60"></div>*@
                        </div>
                    </div>

                    <script type="text/x-jsrender" id="POTemplate">
                        <input type="checkbox" id="POheadchk" />
                    </script>

                    <script type="text/template" id="POcheckboxTemplate">
                        <input type="checkbox" e-enabled="{{data.HasPackingList?'false':'true'}}" ej-checkbox class="rowCheckbox" e-checked="data.check" e-value="data.check" />
                    </script>
                    <div class="common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li>
                                <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button>
                                <button ng-click="closePOPopup();" class="btn">Close</button>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>


<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmPIDeletePopUp" title="Confirmation" message={{message_detailconfirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmMaterialPopUp" title="Confirmation" message={{message_Materialconfirmation}} data-ng-click-right-button="DeletePIMaterial();"></confirm-archive-generic>
