<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        /*background-color: #1c1f32;*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>

<togglable name="{{title}}"></togglable>
<div class="form-horizontal" ng-form name="ModelNewForm">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.CompanyId" name="Company" ng-options="item.Value as item.Text for item in companyList" ng-change="getData()" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="clearfix"></div>
    <div class="form-elements">
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Process</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.Process" name="Process" tabindex="30">
                            <option value="Purchase">Purchase</option>
                            <option value="Sales">Sales</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Expense Type</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.ExpenseTypeId" name="Expense Type"
                                ng-options="item.Value as item.Text for item in overHeadTypeList" tabindex="30">
                            <option value="">--Select--</option>
                            @*<option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                                <option value="E">E</option>*@
                        </select>
                    </div>
                   
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Days<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Days" ng-model="ModelNew.Days" class="form-control" required only-numbers tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Estimated Percentage Value<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="EstimatedPercentageValue" ng-model="ModelNew.EstimatedPercentageValue" class="form-control" required n-Decimals="2" tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Estimated Max Value<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="EstimatedMaxValue" ng-model="ModelNew.EstimatedMaxValue" class="form-control" required n-Decimals="2" tabindex="4" maxlength="50">
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Type</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.Type" name="Type" tabindex="30">
                            <option value="Import">Import</option>
                            <option value="Local">Local</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label" title="DrBudgetCode">Dr. Budget Code</label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" ng-model="ModelNew.DrBudgetCode" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="GetCOAICodeList('Dr');" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearGL()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label" title="CrBudgetCode">Cr. Budget Code</label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" ng-model="ModelNew.CrBudgetCode" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="GetCOAICodeList('Cr');" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearGL()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Payment Terms (Days)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Payment Terms" ng-model="ModelNew.PaymentTerms" class="form-control" required only-numbers tabindex="4" maxlength="50">
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Process" e-headertext="Process" e-width="2"></div>
            <div e-column e-field="Type" e-headertext="Type" e-width="3"></div>
            <div e-column e-field="ExpenseType" e-headertext="ExpenseType" e-width="5"></div>
            <div e-column e-field="DrBudgetCode" e-headertext="DrBudgetCode" e-width="5"></div>
            <div e-column e-field="CrBudgetCode" e-headertext="CrBudgetCode" e-width="5"></div>
            <div e-column e-field="Days" e-headertext="Days" e-width="2"></div>
            <div e-column e-field="PaymentTerms" e-headertext="PaymentTerms(Days)" e-width="5"></div>
            <div e-column e-field="EstimatedPercentageValue" e-headertext="Estimated % Value" e-width="5"></div>
            <div e-column e-field="EstimatedMaxValue" e-headertext="EstimatedMaxValue" e-width="2"></div>
            @*<div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="InvoiceDate" e-headertext="InvoiceDate" e-allowediting="false" e-width="2"></div>*@
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLBudgetPopUp.cshtml")