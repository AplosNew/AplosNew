<div class="modal fade site-modal in" id="materialMasterArticleFormModal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" style="width:90%">
        <div class="modal-content" ng-form name="projectPlanningPOmaterialMasterArticleForm">
            <div class="modal-header">
                Article
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <div class="form-group">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li> <button ng-click="materialMasterArticleSearchPopup();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i>Add Article</button></li>
                        </ul>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Delete</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th ng-repeat="x in articleHead">{{x.MaterialAttributeName}}</th>
                                <th>PO Material UoM</th>
                                <th>Requisition Quantity</th>
                                <th>Raised Quantity</th>
                                <th>Balance Quantity</th>
                                <th>Quantity</th>
                                <th>Rate</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in PPRequisitionMaterialArticleListForSave" style="white-space: normal;">
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="valuePassInPOArticleMasterModal($index,x)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td ng-repeat="y in articleHead">{{x[y.MaterialAttributeName]}}</td>
                                <td>{{x.PoRequisitionUoM}}</td>
                                <td>{{x.RequisitionQuantity}}</td>
                                <td>{{x.RaisedQuantity}}</td>
                                <td>{{x.RequisitionQuantity-x.RaisedQuantity}}</td>
                                <td><input type="text" name="Rate" class="form-control" style="width:100px" required n-Decimals="4" ng-model="x.Quantity" ng-change="getCalculateValue(x)" /></td>
                                <td><input type="text" name="Rate" class="form-control" style="width:100px" required n-Decimals="4" ng-model="x.Rate" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="ProjectPlanningRequisitionMaterialMasterAticleSave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="materialMasterArticleSearchPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:75%">
        <div class="modal-content">
            <div class="modal-header">
                Material Master Articel
                <button type="button" class="close" data-dismiss="modal">&times;</button>
