<div class="modal fade site-modal in" id="projectPlanningPurchaseOrderPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Project Planning Purchase Order</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="projectplanningPurchaseOrderListParameters.searchBy">
                                            <option ng-repeat="option in searchByProjectPlanningPurchaseOrderList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="projectplanningPurchaseOrderListParameters.search" ng-enter="GetProjectPlanningPurchaseOrderListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetProjectPlanningPurchaseOrderListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Apply</th>
                                <th>Id</th>
                                <th>Project Planning</th>
                                <th>Project Planning Requisition</th>
                                <th>Vendor</th>
                                <th>Vendor Reference No</th>
                                <th>Total Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in projectplanningPurchaseOrders |itemsPerPage:projectplanningPurchaseOrderListParameters.pageSize" total-items="projectplanningPurchaseOrderListParameters.total_count" ng-dblclick="GetProjectPlanningPurchaseOrderInfo(x);">
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="valuePassInProjectPlanningPurchaseOrderDelModal($index, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                                <td>{{x.Id}}</td>
                                <td>{{x.Title}}</td>
                                <td>{{x.RequisitionTitle}}</td>
                                <td>{{x.Vendor}}</td>
                                <td>{{x.VendorReferanceNo}}</td>
                                <td>{{x.TotalQuantity}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="GetFixedAssetPurchaseOrderListData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="projectPlanningCloseListPopUp()" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
