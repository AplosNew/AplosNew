<div class="modal fade site-modal in" id="projectPlanningPurchaseOrderDetailFormPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" style="width:90%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Asset Items</h4>
            </div>
            <div class="modal-body text-center">
                <div class="site-tab">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Asset</a></li>
                        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Others</a></li>
                    </ul>
                </div>
                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                        <div class="form-group">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click="getProjectPlanningDetailListData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus">Add</i></button></li>
                                </ul>
                            </div>
                        </div>
                        <div class="table-responsive modal-table"  ng-show="ProjectPlanningPurchaseOrderDetailSelectedList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Apply</th>
                                        <th>Asset Item</th>
                                        <th>Asset Master</th>
                                        <th>Asset Type</th>
                                        <th>Requisition Quantity</th>
                                        <th>Raised Quantity</th>
                                        <th>Balace Quantity</th>
                                        <th>PO UoM</th>
                                        <th>Quantity</th>
                                        <th>Rate <span ng-show="currencyName">({{currencyName}})</span></th>
                                        <th>Rate <span ng-show="projectPlanningInfo.CurrencyName">({{projectPlanningInfo.CurrencyName}})</span></th>
                                        <th>Amount <span ng-show="currencyName">({{currencyName}})</span></th>
                                        <th>Amount <span ng-show="projectPlanningInfo.CurrencyName">({{projectPlanningInfo.CurrencyName}})</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in ProjectPlanningPurchaseOrderDetailSelectedList" ng-class="{unsaveRow : x.Id==null}">
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="valuePassInBudgetSelectedDelModal($index, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                        <td>{{x.UserName}}</td>
                                        <td>{{x.FixedAssetName}}</td>
                                        <td>{{x.AssetType}}</td>
                                        <td>{{x.RequisitionQuantity}}({{x.RequisitionUOM}})</td>
                                        <td>{{x.RaisedQuantity}}</td>
                                        <td>{{x.RequisitionQuantity-x.RaisedQuantity}}</td>
                                        <td style="width:144px">
                                            <div class="select-style">
                                                <select class="form-control" required ng-model="x.AlternativeUomId"
                                                        ng-options="item.Value as item.Text for item in x.alernativeUomLists" id="AlternativeUomId"
                                                        name="AlternativeUom" tabindex="1">
                                                    <option></option>
                                                </select>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="form-group">
                                                <div class="col-sm-12">
                                                    <input type="text" name="Quantity" class="form-control" required only-Numbers ng-model="x.Quantity" ng-disabled="x.AlternativeUomId ===null" />
                                                </div>
                                            </div>
                                        </td>
                                        <td style="width:120px">
                                            <div class="form-group">
                                                <div class="col-sm-12">
                                                    <input type="text" name="Rate" class="form-control" required n-Decimals="4" ng-model="x.Rate" />
                                                </div>
                                            </div>
                                        </td>
                                        <td>{{ x.Rate* projectplanningRequisitionNew.ExchangeRate| number:4}}</td>
                                        <td>{{ x.Quantity * x.Rate| number:4}}</td>
                                        <td>{{x.Quantity * x.Rate* projectplanningPurchaseOrderNew.ExchangeRate| number:4}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                        <div class="form-group">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click="getProjectPlanningRMMNonAssetListData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus">Add</i></button></li>
                                </ul>
                            </div>
                        </div>
                        <div class="table-responsive modal-table" ng-show="ProjectPlanningPurchaseOrderDetailSelectedList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Apply</th>
                                        <th>Asset Item</th>
                                        <th>Asset Master</th>
                                        <th>Asset Type</th>
                                        <th>Requisition Quantity</th>
                                        <th>Raised Quantity</th>
                                        <th>Balace Quantity</th>
                                        <th>Base UoM</th>
                                        <th>Po UoM</th>
                                        <th>Quantity</th>
                                        <th>Rate <span ng-show="currencyName">({{currencyName}})</span></th>
                                        <th>Rate <span ng-show="projectPlanningInfo.CurrencyName">({{projectPlanningInfo.CurrencyName}})</span></th>
                                        <th>Amount <span ng-show="currencyName">({{currencyName}})</span></th>
                                        <th>Amount <span ng-show="projectPlanningInfo.CurrencyName">({{projectPlanningInfo.CurrencyName}})</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in ProjectPlanningPurchaseOrderDetailSelectedList" ng-class="{unsaveRow : x.Id==null}">
