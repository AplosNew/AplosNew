                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal ">
                        <div class="form-group" ng-repeat="l in list" ng-if="$index % 2 === 0">
                            <label class="col-sm-4 control-label">{{l.labelName}}</label>
                            <div class="col-sm-8">
                                <div ng-dropdown-multiselect="" options="l.valueListName" selected-model="l.modelName"
                                     extra-settings="multiSelectSettings" events="onItemSelect($events)"></div>
                            </div>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal" ng-if="$index+1/2 !=0">
                        <div class="form-group" ng-repeat="l in list" ng-if="$index % 2 != 0">
                            <label class="col-sm-4 control-label">{{l.labelName}}</label>
                            <div class="col-sm-8">
                                <div ng-dropdown-multiselect="" options="l.valueListName" selected-model="l.modelName"
                                     extra-settings="multiSelectSettings" events="multi4events"></div>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-12 table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Select</th>
                                    <th>Code</th>
                                    <th>Short Name</th>
                                    <th>Standard Name</th>
                                    <th>Requisition Quantity</th>
                                    <th ng-repeat="x in articleHead">{{x.MaterialAttributeName}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                @*<tr ng-repeat="x in setSingleRow | filter: {'Machine Type':(selectedText)}">*@

                                <tr ng-repeat="x in setSingleRow |  filter: {$:(selectedText)}">

                                    <td class="text-right table-td">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" id="{{x.Id}}" ng-model="x.Flag" ng-checked="x.Flag">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>{{x.Code}}</td>
                                    <td>{{x.ShortName}}</td>
                                    <td>{{x.StandardName}}</td>
                                    <td>{{x.RequisitionQuantity}}</td>
                                    <td ng-repeat="y in articleHead">{{x[y.MaterialAttributeName]}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="materialMasterArticleSearchModalCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

