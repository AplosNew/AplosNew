<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Project Planning Purchase Order
</h3>
<div class="form-elements" ng-form id="projectplanningPurchaseOrderNew" name="projectPlanningPurchaseOrderForm">
    <div class="row">
        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li> <button ng-click="Clear();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus"></i> AddNew</button></li>
                    <li> <button ng-click="getProjectPlanningPurchaseOrder()" class="btn" tabindex="10"><i class="glyphicon glyphicon-search"></i> Search</button></li>
                </ul>
            </div>
        </div>
        <input type="hidden" ng-model="projectplanningPurchaseOrderNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Project Planning<sup>*</sup></label>
                <div class="col-sm-7  show-message">
                    <input type="text" name="Project Planning" tabindex="5" ng-model="projectPlanningInfo.Title" class="form-control" required readonly>
                </div>
                <div class="col-sm-1">
                    <button ng-click="getProjectPlanningSearchPopup();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Vendor<sup>*</sup></label>
                <div class="col-sm-7 show-message">
                    <input type="text" name="Vendor" tabindex="3" ng-model="projectplanningPurchaseOrderNew.Vendor" class="form-control" readonly required>
                </div>
                <div class="col-sm-1">
                    <button ng-click="showVendorModal();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                </div>
                @*<div class="col-sm-1">
                        <button ng-click="clearVendorCode();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>*@
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="projectplanningPurchaseOrderNew.CurrencyId"
                                ng-options="item.Value as item.Text for item in CurrencyList" id="CurrencyId"
                                name="Currency" required tabindex="1" ng-change="getCurrencyName(projectplanningPurchaseOrderNew.CurrencyId)"></select>
                    </div>
                </div>

            </div>
            @*<div class="form-group">
                <label class="col-sm-4 control-label">Total Amount</label>
                <div class="col-sm-8">
                    <input type="text" name="totalAmount" ng-model="projectplanningPurchaseOrderNew.TotalAmount|number:4" class="form-control" readonly tabindex="4" maxlength="50">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Total Quantity</label>
                <div class="col-sm-8">
                    <input type="text" name="totalQuantity" ng-model="projectplanningPurchaseOrderNew.TotalQuantity" class="form-control" readonly tabindex="4" maxlength="50">
                </div>
            </div>*@
            <div class="form-group">
                <label class="col-sm-4 control-label">Vendor Reference No</label>
                <div class="col-sm-8">
                    <input type="text" name="Vendor Reference No" ng-model="projectplanningPurchaseOrderNew.VendorReferanceNo" class="form-control" tabindex="4" maxlength="50">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Project Planning Requisition<sup>*</sup></label>
                <div class="col-sm-7  show-message">
                    @*<input type="text" name="Project Planning" tabindex="5" ng-model="projectPlanningRequisitionInfo.ProjectPlanningId" class="form-control" required readonly>*@
                    <input type="text" name="Project Planning" tabindex="5" ng-model="projectplanningPurchaseOrderNew.RequisitionTitle" class="form-control" required readonly>
                </div>
                <div class="col-sm-1">
                    <button ng-click="getProjectPlanningRequisitionSearchPopup();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Planning Code</label>
                <div class="col-sm-8">
                    <input type="text" name="Planning Code" ng-model="projectPlanningInfo.Code" class="form-control" readonly tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Exchange Rate</label>
                <div class="col-sm-6">
                    <input type="text" name="Exchange Rate" ng-disabled="projectplanningPurchaseOrderNew.ExchangeRate===0" ng-model="projectplanningPurchaseOrderNew.ExchangeRate" n-Decimals="4" class="form-control" tabindex="4">
                </div>
                <div class="col-sm-2">
                    <input type="text" name="Exchange Rate" ng-model="projectPlanningInfo.CurrencyName" class="form-control" tabindex="4" readonly>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Planning Description</label>
                <div class="col-sm-8">
                    <input type="text" name="Planning Description" ng-model="projectPlanningInfo.Description" class="form-control" readonly tabindex="4" maxlength="50">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">PO Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="PoDate" id="PoDate" ng-model="projectplanningPurchaseOrderNew.PoDate" tabindex="5" datepicker class="form-control" end-date={{maxDate}} required>
                    @*<input type="text" ng-model="e.NewDOC" ng-disabled="e.ApprovalStatus == 'Extend'" ng-change="setApprovalDate(e.EmployeeId,$index)" date-format="dd-MM-yyyy" selector="form-control" end-date={{maxDate}} style="width: 110px;" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8">*@

                </div>
            </div>


        </div>
        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li ng-show="projectplanningPurchaseOrderNew.Id !=null"> <button ng-click="ShowProjectPlanningDetailForm();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i>Add Line Item</button></li>
                    @*<li> <button ng-click="saveMaster();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{projectplanningPurchaseOrders.length>0 ? 'Update':'Save'}}</button></li>*@
                    <li> <button ng-click="saveMaster();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                </ul>
            </div>
        </div>
        @*ng-disabled="projectplanningPurchaseOrders.length >0"*@


        <div class="col-xs-12" ng-show="projectPlanningPOMaterialSavedList.length >0">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Edit</th>
                            <th>Delete</th>
                            <th>Asset Item</th>
                            <th>Asset Master</th>
                            <th>Asset Type</th>
                            <th>Requisition Quantity</th>
                            <th>Raised Quantity</th>
                            <th>Quantity</th>
                            <th>Rate</th>
                            <th>Article</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in projectPlanningPOMaterialSavedList">
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="editProjectPlanningDetail($index, x)" ng-disabled="x.AvgRate > 0" class="btn-action tooltip-here" data-placement="top" title="Edit">
                                            <i class="glyphicon glyphicon-edit"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="valuePassInPORecMasterModal($index, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                            <i class="glyphicon glyphicon-remove"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                            <td>{{x.UserName}}</td>
                            <td>{{x.FixedAssetMaster}}</td>
                            <td>{{x.AssetType}}</td>
                            <td>{{x.RequisitionQuantity}}({{x.RequisitionUoM}})</td>
                            <td>{{x.RaisedQuantity}}({{x.RequisitionUoM}})</td>
                            <td>{{x.ArtQuantity !=null?x.ArtQuantity:x.Quantity}}({{x.PoRequisitionUoM}})</td>
                            <td>{{x.ArtQuantity !=null?x.AvgRate:x.Rate}}</td>
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="materialMasterArticleAddFormPopup(x)" class="btn-action" title="article Assign">
                                            <i class="glyphicon glyphicon-list"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>


    </div>
</div>
