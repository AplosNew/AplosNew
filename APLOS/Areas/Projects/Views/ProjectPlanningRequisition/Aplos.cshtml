<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Project Planning Requisition
</h3>
<div class="form-elements" ng-form id="projectPlanningRequisitionNew" name="projectPlanningRequisitionForm">
    <div class="row">
        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li> <button ng-click="Clear();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus"></i> AddNew</button></li>
                    <li> <button ng-click="getProjectPlanningRequisition()" class="btn" tabindex="10"><i class="glyphicon glyphicon-search"></i> Search</button></li>
                </ul>
            </div>
        </div>
        <input type="hidden" ng-model="projectPlanningRequisitionNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Project Planning<sup>*</sup></label>
                <div class="col-sm-7  show-message">
                    <input type="text" name="Project Planning" tabindex="5" ng-model="projectPlanningInfo.ProjectPlanningTitle" class="form-control" required readonly>
                </div>
                <div class="col-sm-1">
                    <button ng-click="getProjectPlanningSearchPopup();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Planning Code</label>
                <div class="col-sm-8">
                    <input type="text" name="Planning Code" ng-model="projectPlanningInfo.Code" class="form-control" readonly tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Total Quantity</label>
                <div class="col-sm-8">
                    <input type="text" name="totalQuantity" ng-model="projectPlanningRequisitionNew.TotalQuantity" class="form-control" readonly tabindex="4" maxlength="50">
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">

            <div class="form-group">
                <label class="col-sm-4 control-label">Planning Description</label>
                <div class="col-sm-8">
                    <input type="text" name="Planning Description" ng-model="projectPlanningInfo.Description" class="form-control" readonly tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                <div class="col-sm-8  show-message">
                    <input type="text" name="Title" tabindex="5" ng-model="projectPlanningRequisitionNew.Description" class="form-control" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Requisition Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="RequisitionDate" id="RequisitionDate" ng-model="projectPlanningRequisitionNew.RequisitionDate" tabindex="5" datepicker class="form-control datepicker" required>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li ng-show="projectPlanningRequisitionNew.Id !=null"> <button ng-click="materialMasterFormAddPopup();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> Add Line Item</button></li>
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus"></i> {{Action}}</button></li>
                </ul>
            </div>
        </div>
        <div class="col-xs-12" ng-show="projectPlanningMaterialSavedListDetail.length >0">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Edit</th>
                            <th>Delete</th>
                            <th>Asset Item</th>
                            <th>Asset Master</th>
                            <th>Asset Type</th>
                            <th>Planning Quantity</th>
                            <th>Raised Quantity </th>
                            <th>Quantity</th>
                            <th>Article</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in projectPlanningMaterialSavedListDetail">
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="editProjectPlanningRequisition($index, x)" ng-disabled="x.ReACount >0 " class="btn-action tooltip-here" data-placement="top" title="Edit">
                                            <i class="glyphicon glyphicon-edit"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="valuePassInPORecMasterModal($index, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                            <i class="glyphicon glyphicon-remove"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                            <td>{{x.UserName}}</td>
                            <td>{{x.FixedAssetName}}</td>
                            <td>{{x.AssetType}}</td>
                            <td>{{x.PlanningQuantity}}({{x.PlanningUOM}})</td>
                            <td>{{x.RaisedQuantity}}({{x.PlanningUOM}})</td>
                            <td>{{x.ReACount>0?x.ReACount: x.Quantity}}({{x.RequsitionUoM}})</td>
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="materialMasterArticleAddFormPopup(x)" class="btn-action" title="article Assign">
                                            <i class="glyphicon glyphicon-list"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
