@*<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Project Planning
</h3>*@
<togglable name="Project Planning"></togglable>
<div class="form-elements" ng-form id="projectPlanningNew" name="projectPlanningForm">
    <div class="row">

        <input type="hidden" ng-model="projectPlanningNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="projectPlanningNew.PlantId" ng-change="getExchangeRateAvailable();"
                                ng-options="item.Value as item.Text for item in PlantList" id="plantId" name="Plant" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" maxlength="15" ng-model="projectPlanningNew.Code" class="form-control" required tabindex="3">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Title</label>
                <div class="col-sm-8">
                    <input type="text" name="Title" maxlength="130" ng-model="projectPlanningNew.Title" class="form-control" tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Resp. Person by</label>
                <div class="col-sm-8 show-message text-left">

                    <input type="radio" name="baselinedate" tabindex="10" ng-change="clearResponsiblePerson()" ng-model="projectPlanningNew.ResponsiblePersonBy" value="Position">
                    <span>Position</span>
                    <input type="radio" name="baselinedate" tabindex="11" ng-change="clearResponsiblePerson()" ng-model="projectPlanningNew.ResponsiblePersonBy" value="Budget">
                    <span>Budget</span>
                    <input type="radio" name="baselinedate" tabindex="12" ng-change="clearResponsiblePerson()" ng-model="projectPlanningNew.ResponsiblePersonBy" value="Employee" checked="checked">
                    <span>Employee</span><br />
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group">
                <label class="col-sm-4 control-label">Production Entity</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="projectPlanningNew.EntityId" ng-options="item.Id as item.UserName for item in EntityList" id="entityId" name="Production Entity" tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    @*<input type="text" name="Description" ng-model="projectPlanningNew.Description" class="form-control" required tabindex="4" maxlength="50">*@
                    <textarea class="form-control" rows="3" ng-model="projectPlanningNew.Description" tabindex="4" maxlength="250" required></textarea>
                </div>
            </div>
           

            <div class="form-group">
                <label class="col-sm-4 control-label">Resp. Person <sup>*</sup></label>
                <div class="col-sm-7">
                    <input type="text" name="Responsible Person" ng-show="false" ng-model="projectPlanningNew.ResponsiblePersonId" class="form-control" readonly>
                    <input type="text" name="Responsible Person" ng-model="projectPlanningNew.ResponsiblePerson" class="form-control" readonly>
                </div>
                <div class="col-sm-1">
                    <button tabindex="13" ng-click="showEmployeeInformationModal();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>
        </div>
        <div>
            <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="projectPlanningNew.CurrencyId" ng-options="item.Value as item.Text for item in CurrencyList" id="CurrencyId"
                                    name="Currency" required tabindex="1" ng-change="GetCurrencyExchangeRateList();validateCurrency(projectPlanningNew.CurrencyId)"></select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="From Date" id="FromDate" ng-model="projectPlanningNew.FromDate" datepicker class="form-control datepicker" tabindex="1" required>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Status<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="projectPlanningNew.Status" ng-options="item.Value as item.Text for item in StatusList" id="Status" name="Status" required tabindex="1">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Exchange Rate<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Exchange Rate" ng-model="projectPlanningNew.ExchangeRate" class="form-control" tabindex="4" ng-disabled="showExchangeRateCtrl" required maxlength="50">
                    </div>
                    <div class="col-sm-1">
                        {{currencyExchangeName}}
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="To Date" id="ToDate" ng-model="projectPlanningNew.ToDate" datepicker class="form-control datepicker" tabindex="1" required>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>
        <div class="clearfix"></div>
        
        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li ng-hide="projectPlanningNew.Id===null"> <button ng-click="ShowBudgetMasterForm();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i>Add Line Item</button></li>

                </ul>
            </div>
        </div>
        <div class="col-xs-12" ng-show="ProjectPlanningDetailSavedList[0].Id !=null">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Edit</th>
                            <th>Delete</th>
                            <th>Planning Category</th>
                            <th>Planning SubCategory</th>
                            <th>GL</th>
                            <th>Budget Category</th>
                            <th>Budget SubCategory</th>
                            <th>Budget</th>
                            <th>Local Amount</th>
                            <th>Import Amount</th>
                            <th>Amount</th>
                            <th>Item Detail</th>
                            @*<th>Asset Item</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in ProjectPlanningDetailSavedList">
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="editProjectPlanningDetail($index, x)" class="btn-action tooltip-here" data-placement="top" title="Edit">
                                            <i class="glyphicon glyphicon-edit"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="valuePassInBudgetSavedDelModal($index, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                            <i class="glyphicon glyphicon-remove"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                            <td>{{x.ProjectPlanningCategory}}</td>
                            <td>{{x.ProjectPlanningSubCategory}}</td>
                            <td>{{x.GLGeneralInfoCode +" - "+ x.GLGeneralInfoName}}</td>
                            <td>{{x.BudgetCategory}}</td>
                            <td>{{x.BudgetSubCategory}}</td>
                            <td>{{x.BudgetName}}</td>
                            <td>{{x.LocalAmount}}</td>
                            <td>{{x.ImportAmount}}</td>
                            <td>{{x.LocalAmount + x.ImportAmount}}</td>
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="materialMasterFormSearchPopup(x)" class="btn-action" title="materialMaster Assign">
                                            <i class="glyphicon glyphicon-list"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="projectPlanningListParameters.searchBy">
                            <option ng-repeat="option in searchByProjectPlanningList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="projectPlanningListParameters.search" ng-enter="GetProjectPlanningListData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="GetProjectPlanningListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Apply</th>
                <th>Code</th>
                <th>Description</th>
                <th>Title</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in projectPlannings |itemsPerPage:projectPlanningListParameters.pageSize" total-items="projectPlanningListParameters.total_count" ng-dblclick="GetProjectPlanningInfo(x);">
                <td class="text-right table-td">
                    <ul class="list-inline action-list">
                        <li>
                            <button ng-click="valuePassInProjectPlanningDelModal($index, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </li>
                    </ul>
                </td>
                <td>{{x.Code}}</td>
                <td>{{x.Description}}</td>
                <td>{{x.Title}}</td>
                <td>{{x.Status}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="GetProjectPlanningListData(newPageNumber)">
    </dir-pagination-controls>
</div>

<div class="modal fade site-modal in" id="budgetMasterFormPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Budget Master</h4>
            </div>
            <div class="modal-body">
                <div class="form-elements" ng-form id="projectPlanning" name="projectPlanningBudgetForm">
                    <div class="row">
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Project Category<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="ProjectPlanningDetail.ProjectPlanningCategoryId"
                                                ng-options="item.Value as item.Text for item in ProjectPlanningCategoryList" id="ProjectPlanningCategoryId"
                                                name="Project Category" tabindex="1">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>



                            <div class="form-group">
                                <div class="col-sm-8">
                                    <div class="common-btn">
                                        <ul class="list-inline text-left">
                                            <li> <button ng-click="GetBudgetMasterList();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> Budget Master</button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">


                            <div class="form-group">
                                <label class="col-sm-4 control-label">Project SubCategory<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="ProjectPlanningDetail.ProjectPlanningSubCategoryId"
                                                ng-options="item.Value as item.Text for item in ProjectPlanningSubCategoryList" id="ProjectPlanningSubCategoryId"
                                                name="Planning SubCategory" tabindex="1">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12">
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Apply</th>
                                            <th>GL</th>
                                            <th>Budget Category</th>
                                            <th>Budget SubCategory</th>
                                            <th>Budget</th>
                                            <th>Ref No</th>
                                            <th>Local Amount</th>
                                            <th>Import Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in budgetMasterSelectedList">
                                            <td class="text-right table-td">
                                                <ul class="list-inline action-list">
                                                    <li>
                                                        <button ng-click="valuePassInDelModal($index, x.BudgetMasterId)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                            <i class="glyphicon glyphicon-remove"></i>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </td>
                                            <td>{{x.GLGeneralInfoCode +" - "+ x.GLGeneralInfoName}}</td>
                                            <td>{{x.BudgetCategory}}</td>
                                            <td>{{x.BudgetSubCategory}}</td>
                                            <td>{{x.BudgetName}}</td>
                                            <td>
                                                {{x.RefNo}}
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <div>
                                                        <input type="text" name="Local Amount" n-Decimals="4" maxlength="15" ng-model="x.LocalAmount" class="form-control" tabindex="3">
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <div>
                                                        <input type="text" name="Import Amount" n-Decimals="4" maxlength="15" ng-model="x.ImportAmount" class="form-control" tabindex="3">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-xs-12">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="BudgetMasterSave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="budgetMasterPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="budgetMasterForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Budget Master</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="budgetMasterListParameters.searchBy">
                                            <option ng-repeat="option in searchByBudgetMasterList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="budgetMasterListParameters.search" ng-enter="GetBudgetMasterListDatas()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetBudgetMasterListDatas()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>GL</th>
                                <th>Budget Category</th>
                                <th>Budget SubCategory</th>
                                <th>Budget</th>
                                <th>RefNo</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in BudgetMasterList |itemsPerPage:budgetMasterListParameters.pageSize" pagination-id="metaData.name + 'BudgetMasterList'" total-items="budgetMasterListParameters.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="{{x.Id}}" ng-model="x.Flag" checked="{{x.Flag}}" ng-click="selectBudgetMasterChValue($event,x)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.GLGeneralInfoCode +" - "+ x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetCategory}}</td>
                                <td>{{x.BudgetSubCategory}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.RefNo}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'BudgetMasterList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="GetBudgetMasterListDatas(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="budgetMasterSelectdCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
@*MachineType Master Modal*@
<div class="modal fade site-modal in" id="machineTypeMasterFormModal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" ng-form="fixedAssetMasterForm">
        <div class="modal-content">
            <div class="modal-header">
                Asset Item
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-element-ctrl">
                <div class="form-group">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li> <button ng-click="machineTypeMasterSearchPopup();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i>Add Asset Item</button></li>
                        </ul>
                    </div>
                </div>

                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Apply</th>
                                <th>Asset Item</th>
                                <th>Asset Class</th>
                                <th>Asset SubClass</th>
                                <th>Fixed Asset Master</th>
                                <th>Base UOM</th>
                                <th>Planning UOM</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in ProjectPlaningMachineTypeListForSave" ng-show="x.ProjectPlanningDetailId==ProjectPlanningDetailId" ng-dblclick="checkIsRegisterApply(x);">
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="valuePassInMachineFormDelModal($index, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                                <td>{{x.AssetItemName}}</td>
                                <td>{{x.AssetClassName}}</td>
                                <td>{{x.AssetSubClassName}}</td>
                                <td>{{x.FixedAssetMasterName}}</td>
                                <td>{{x.BaseUOM}}</td>
                                <td>
                                    <div class="select-style">
                                        <select class="form-control" required ng-model="x.PlanningUOMId"
                                                ng-options="item.Value as item.Text for item in x.AlernativeUomLists" id="uom" name="AlternativeUom" tabindex="1">
                                            <option></option>
                                        </select>
                                    </div>

                                </td>
                                <td>
                                    <div class="form-group" show-errors>
                                        <div class="show-message">
                                            <input type="text" class="form-control" name="Quantity" maxlength="15" ng-model="x.Quantity" only-Numbers required tabindex="3">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="FixedAssetMasterSave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="machineTypeMasterModal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Asset Item
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <div class="col-xs-12 col-sm-6 col-sm-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Asset Type</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select name="FixedAsset" ng-model="projectPlanningNew.AssetType" class="form-control"
                                        ng-options="item.Value as item.Text for item in fixedAssetTypes" required tabindex="9" ng-change="getMachineTypeData()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="machineTypeListParameters.searchBy">
                                            <option ng-repeat="option in searchByMachineTypeList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
