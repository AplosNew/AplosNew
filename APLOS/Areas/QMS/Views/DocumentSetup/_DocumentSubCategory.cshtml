<togglable name="SOP Document SubCategory"></togglable>
<div class="form-elements" ng-form name="sopDocumentSubCategoryNewForm">
    <input type="hidden" ng-model="sopDocumentSubCategoryNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Sequence" ng-model="sopDocumentSubCategoryNew.Sequence" class="form-control" required placeholder="0" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" maxlength="15" ng-model="sopDocumentSubCategoryNew.ShortName" class="form-control" tabindex="3" required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" maxlength="50" ng-model="sopDocumentSubCategoryNew.UserName" class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" name="Description" maxlength="250" rows="3" ng-model="sopDocumentSubCategoryNew.Description" tabindex="7"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" maxlength="10" ng-model="sopDocumentSubCategoryNew.Code" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" maxlength="50" ng-model="sopDocumentSubCategoryNew.StandardName" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" name="Remarks" maxlength="250" rows="3" ng-model="sopDocumentSubCategoryNew.Remarks" tabindex="6"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" class="css-checkbox" ng-model="sopDocumentSubCategoryNew.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="SaveDSC();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{ActionDSC}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmDetailPopUpDSC" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="ClearDSC();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchByDSC">
                            <option ng-repeat="option in searchByListDSC" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.searchDSC" ng-enter="getDataDSC()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getDataDSC()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="sopDocumentSubCategories" e-recorddoubleclick="GetDSC" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmDetailPopUpDSC" title="Confirmation" message={{message_Detailconfirmation}} data-ng-click-right-button="DeleteDSC();"></confirm-archive-generic>


