<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="QMSDefectMasterForm">
    <div class="row" ng-form name="General">
        <input type="hidden" ng-model="QMSDefectMaster.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="QMSDefectMaster.Sequence" e-width="100" required tabindex="1" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Code" ng-model="QMSDefectMaster.StandardCode" class="form-control" required tabindex="3" maxlength="10">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Code" ng-model="QMSDefectMaster.UserCode" class="form-control" required tabindex="5" maxlength="10">
                </div>
            </div>


            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Critical Level<sup>*</sup></label>
                <div class="col-sm-8  show-message">
                    <div class="select-style">

                        <select ng-model="QMSDefectMaster.CriticalityLevelId" class="form-control" name="Critical Level"
                                ng-options="item.Value as item.Text for item in CriticalityLevelList" required tabindex="7">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Product Master</label>
                <div class="col-sm-8  show-message">
                    <div class="checkbox-site">
                        <label>
                            <input id="Check_ProductApplicable" type="checkbox" class="css-checkbox" ng-model="QMSDefectMaster.ProductApplicable" tabindex="11">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Material Master</label>
                <div class="col-sm-8  show-message">
                    <div class="checkbox-site">
                        <label>
                            <input id="Check_MaterialApplicable" type="checkbox" class="css-checkbox" ng-model="QMSDefectMaster.MaterialApplicable" tabindex="12">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Process</label>
                <div class="col-sm-8  show-message">
                    <div class="checkbox-site">
                        <label>
                            <input id="Check_ProcessApplicable" type="checkbox" class="css-checkbox" ng-model="QMSDefectMaster.ProcessApplicable" tabindex="13">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-4 control-label">QMS Testing Master</label>
                <div class="col-sm-8  show-message">
                    <div class="checkbox-site">
                        <label>
                            <input id="Check_TestApplicable" type="checkbox" class="css-checkbox" ng-model="QMSDefectMaster.TestApplicable" tabindex="15">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Skill</label>
                <div class="col-sm-8  show-message">
                    <div class="checkbox-site">
                        <label>
                            <input id="Check_SkillApplicable" type="checkbox" class="css-checkbox" ng-model="QMSDefectMaster.SkillApplicable" tabindex="17">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="QMSDefectMaster.StandardName" class="form-control" maxlength="50" required tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8  show-message">
                    <input type="text" name="User Name" ng-model="QMSDefectMaster.UserName" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="QMSDefectMaster.ShortName" class="form-control" required tabindex="6" maxlength="15">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Repair Type</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select ng-model="QMSDefectMaster.RepairTypeId" class="form-control"
                                ng-options="item.Value as item.Text for item in RepairTypeList" tabindex="8">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-4 control-label">Defect Cause</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <textarea name="Defect Cause" style="height: 98px;" tabindex="10" maxlength="250" class="form-control" Rows="3" ng-model="QMSDefectMaster.DefectCause"></textarea>
                    </div>
                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-4 control-label">Machine Master</label>
                <div class="col-sm-8  show-message">
                    <div class="checkbox-site">
                        <label>
                            <input id="Check_MachineApplicable" type="checkbox" class="css-checkbox" ng-model="QMSDefectMaster.MachineApplicable" tabindex="14">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Process Parameter </label>
                <div class="col-sm-8  show-message">
                    <div class="checkbox-site">
                        <label>
                            <input id="Check_ProcessParameterApplicable" type="checkbox" class="css-checkbox" ng-model="QMSDefectMaster.ProcessParameterApplicable" tabindex="16">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>



        </div>
        <br />
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save()" class="btn" tabindex="18"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="19"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear()" class="btn" tabindex="20"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <confirm-modal></confirm-modal>


    <div class="form-elements">
        <div class="tab-design" id="tab_show">
