                    }))
                };

                // FormData to send image + defects
                const formData = new FormData();
                formData.append("imageFile", imageInput.files[0]);
                formData.append("defectsJson", JSON.stringify(dataToSave));

                const response = await fetch("/QMS/QualityProcess/SaveImageAndDefects", {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();

                if (!result.Success) {
                    ShowResult(result.Message, 'failure');
                } else {
                    ShowResult(result.Message, 'success');

                    // Optional: reload saved defects for this image
                    //await loadDefects(dataToSave.imageFile);
