        const clearButton = document.getElementById('clearButton');
        const messageContainer = document.getElementById('messageContainer');


        let defects = [];
        let imageLoaded = false;
        let originalImageWidth = 0;
        let originalImageHeight = 0;

        // --- Utility Functions ---

        function alertMessage(message, type) {
            const alertDiv = document.createElement('div');
            const color = type === 'success' ? 'bg-green-100 border-green-400 text-green-700' : 'bg-red-100 border-red-400 text-red-700';

            alertDiv.className = `max-w-md mx-auto border px-4 py-3 rounded-lg relative shadow-lg ${color} mb-2`;
            alertDiv.innerHTML = `<span class="block sm:inline font-medium">${message}</span>`;

            messageContainer.appendChild(alertDiv);

            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
        }

        // --- Core Logic Functions ---

        /**
         * Loads the selected image into the UI and prepares the canvas.
         */
        function loadImage() {
            const file = imageInput.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                garmentImage.src = e.target.result;
                garmentImage.style.display = 'block';
                defectCanvas.style.display = 'block';
                placeholderText.style.display = 'none';
                imageLoaded = false;

                garmentImage.onload = () => {
                    originalImageWidth = garmentImage.naturalWidth;
                    originalImageHeight = garmentImage.naturalHeight;

                    resizeCanvas();

                    defectCanvas.removeEventListener('click', handleImageClick);
                    defectCanvas.addEventListener('click', handleImageClick);

                    imageLoaded = true;
                    drawDefects();
                    updateControlButtons();
                };
            };
            reader.readAsDataURL(file);
        }

        /**
         * Resizes the canvas to match the current dimensions of the displayed image.
         */
        function resizeCanvas() {
            const container = document.getElementById('imageContainer');
            const rect = garmentImage.getBoundingClientRect();

            defectCanvas.width = rect.width;
            defectCanvas.height = rect.height;
            defectCanvas.style.width = `${rect.width}px`;
            defectCanvas.style.height = `${rect.height}px`;

            const imgRect = garmentImage.getBoundingClientRect();
            const containerRect = container.getBoundingClientRect();

            const xOffset = imgRect.left - containerRect.left;
            const yOffset = imgRect.top - containerRect.top;

            defectCanvas.style.left = `${xOffset}px`;
            defectCanvas.style.top = `${yOffset}px`;
        }

        /**
         * Handles clicks on the canvas to mark a defect.
         */
        function handleImageClick(event) {
            if (!imageLoaded) return;

            const rect = defectCanvas.getBoundingClientRect();
            const clickX = event.clientX - rect.left;
            const clickY = event.clientY - rect.top;

            // Calculate Normalized Coordinates (0.0 to 1.0)
            const normalizedX = clickX / defectCanvas.width;
            const normalizedY = clickY / defectCanvas.height;

            const defect = {
                id: Date.now(),
                x: parseFloat(normalizedX.toFixed(3)),
                y: parseFloat(normalizedY.toFixed(3)),
                description: 'General Defect'
            };

            defects.push(defect);
            drawDefects();
            renderDefectList();
        }

        /**
         * Redraws all defect markers on the canvas.
         */
        function drawDefects() {
            if (!imageLoaded) return;
            ctx.clearRect(0, 0, defectCanvas.width, defectCanvas.height);

            defects.forEach(defect => {
                // Convert Normalized Coordinates back to Canvas Pixels
                const pixelX = defect.x * defectCanvas.width;
                const pixelY = defect.y * defectCanvas.height;

                // Draw the defect marker (Red circle)
                ctx.beginPath();
                ctx.arc(pixelX, pixelY, 8, 0, Math.PI * 2, false); // Radius 8
                ctx.fillStyle = '#ef4444'; // Red-500
                ctx.fill();
                ctx.lineWidth = 2;
                ctx.strokeStyle = '#b91c1c'; // Red-700
                ctx.stroke();
            });
        }

        /**
         * Renders the list of defects in the sidebar.
         */
        function renderDefectList() {
            defectsList.innerHTML = '';
            if (defects.length === 0) {
                emptyListText.style.display = 'block';
            } else {
                emptyListText.style.display = 'none';
                defects.forEach((defect, index) => {
                    const listItem = document.createElement('li');
                    listItem.className = 'flex justify-between items-center p-3 bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-indigo-50 transition duration-150';
                    listItem.innerHTML = `
                                    <span class="text-sm font-mono text-gray-700">
                                        <strong class="text-indigo-600">${index + 1}.</strong>
                                        X: ${defect.x}, Y: ${defect.y}
                                    </span>
                                    <button onclick="deleteDefect(${defect.id})" class="text-red-500 hover:text-red-700 font-bold ml-4 p-1 rounded-full hover:bg-red-100 transition duration-150" title="Delete Defect">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                                        </svg>
                                    </button>
                                `;

                    defectsList.appendChild(listItem);
                });
            }
            updateControlButtons();
        }

        /**
         * Deletes a defect by its ID.
         */
        function deleteDefect(id) {
            defects = defects.filter(defect => defect.id !== id);
            drawDefects();
            renderDefectList();
        }

        /**
         * Clears all marked defects.
         */
        function clearDefects() {
            defects = [];
            drawDefects();
            renderDefectList();
        }

        /**
         * Updates the state of the Save and Clear buttons.
         */
        function updateControlButtons() {
            const isDisabled = defects.length === 0 || !imageLoaded;
            saveButton.disabled = isDisabled;
            clearButton.disabled = isDisabled;
            if (isDisabled) {
                saveButton.classList.replace('bg-green-600', 'bg-gray-400');
                saveButton.classList.replace('hover:bg-green-700', 'hover:bg-gray-400');
                clearButton.classList.replace('bg-red-500', 'bg-gray-400');
                clearButton.classList.replace('hover:bg-red-600', 'hover:bg-gray-400');
            } else {
                saveButton.classList.replace('bg-gray-400', 'bg-green-600');
                saveButton.classList.replace('hover:bg-gray-400', 'hover:bg-green-700');
                clearButton.classList.replace('bg-gray-400', 'bg-red-500');
                clearButton.classList.replace('hover:bg-gray-400', 'hover:bg-red-600');
            }
        }

        /**
         * Sends the defects array to the C# backend API.
         */



        async function saveDefects() {
            debugger;
            const imageInput = document.getElementById("imageInput");

            if (!imageInput.files[0]) {
                alert("Please select an image first.");
                return;
            }

            if (defects.length === 0) {
                alert("No defects to save.");
                return;
