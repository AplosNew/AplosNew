    async function loadDefects(imageFile) {
        try {
            const response = await fetch(`QMS/QualityProcess/GetDefects?imageFile=${encodeURIComponent(imageFile)}`);
            const result = await response.json();

            if (!result.Error) {
                console.log("Defects loaded:", result.Data.defects);
                // here you can render markers back on canvas
            } else {
                alertMessage(result.Message, "warning");
            }
        } catch (err) {
            console.error("Network Error:", err);
            alertMessage("Could not load defects.", "error");
        }
    }

    let currentClick = { x: 0, y: 0 };

    const img = document.getElementById("garmentImage");
    const modal = document.getElementById("defectModal");

    defectCanvas.addEventListener("click", function (e) {
        debugger;
        const rect = e.target.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;

        currentClick = { x, y };
        document.getElementById("defectId").value = ""; // new defect
        document.getElementById("defectType").value = "Stain";
        document.getElementById("defectNotes").value = "";

        modal.style.left = e.pageX + "px";
        modal.style.top = e.pageY + "px";
        modal.style.display = "block";
    });

