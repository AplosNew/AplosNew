    // Delete defect
    document.getElementById("deleteDefect").addEventListener("click", function () {
        const id = document.getElementById("defectId").value;
        if (!id) { alert("No defect selected."); return; }

        fetch("/QualityProcess/DeleteDefect?id=" + id, { method: "POST" })
        .then(r => r.json())
        .then(res => {
            alert(res.Message);
            modal.style.display = "none";
            loadDefects(); // reload markers
        });
    });

    function addMarker(defect) {
        const container = document.getElementById("image-container");
        const marker = document.createElement("div");
        marker.className = "marker";

        const img = document.getElementById("garmentImage");
        marker.style.left = (defect.XNormalized * img.width) + "px";
        marker.style.top = (defect.YNormalized * img.height) + "px";

        marker.title = defect.Type + " - " + defect.Description;

        // click marker to edit defect
        marker.addEventListener("click", (e) => {
            e.stopPropagation(); // prevent triggering new point
            document.getElementById("defectId").value = defect.Id;
            document.getElementById("defectType").value = defect.Type;
            document.getElementById("defectNotes").value = defect.Description;

            modal.style.left = e.pageX + "px";
            modal.style.top = e.pageY + "px";
            modal.style.display = "block";

            currentClick = { x: defect.XNormalized, y: defect.YNormalized };
        });

        container.appendChild(marker);
    }

    // Load defects from DB
    async function loadDefects() {
        const container = document.getElementById("image-container");
        // clear old markers
        container.querySelectorAll(".marker").forEach(m => m.remove());

        let res = await fetch("/QualityProcess/GetDefects?imageFile=garment1.jpg");
        let data = await res.json();
        data.Defects.forEach(d => addMarker(d));
    }

    loadDefects();


