<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">SrNo<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="SrNo" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.SrNo" e-width="100%" required />
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Defect Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Defect Category" ng-model="ModelNew.DefectCategory" class="form-control" maxlength="15" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Defect Names<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Defect Names" ng-model="ModelNew.DefectNames" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>
        @*<div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.ProcessId" name="Process" ng-options="item.Value as item.Text for item in processList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>*@
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Types Of Defects<sup>*</sup></label>
            @*<div class="col-sm-8 show-message">
                    <input type="text" name="TypesOfDefects" ng-model="ModelNew.TypesOfDefects" class="form-control" required tabindex="4" maxlength="50">
                </div>*@
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.TypesOfDefects" name="TypesOfDefects" required>
                        <option value="">--Select--</option>
                        <option value="Operation">Operation</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Is Machine</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.IsMachine" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Defect Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Defect Code" ng-model="ModelNew.DefectCode" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Defects Local Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Defects Local Name" ng-model="ModelNew.DefectsLocalName" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Quality Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.QualityProcessId" name="Process" ng-options="item.Value as item.Text for item in processList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Zone<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Zone" ng-model="ModelNew.Zone" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li ng-class="{ active: isSet2(1) }"><a ng-click="setTab2(1)" href="" data-toggle="tab">Process</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(1), active: isSet2(1) }">
            <div class="row" ng-form="processform">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li><button ng-click="processPopUpDataList();" ng-disabled="ModelNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Process</button></li>
                            <li> <button ng-click="SaveProcess();" ng-show="userProcessList.length>0" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save Process</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="table-responsive modal-table" ng-show="userProcessList.length>0">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Short Name</th>
                                    <th>Process</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in userProcessList" ng-class="{selected : x.Id==null}">
                                    <td>{{x.Code}}</td>
                                    <td>{{x.ShortName}}</td>
                                    <td>{{x.Process}}</td>
                                    <td class="text-right table-td">
                                        <ul class="list-inline action-list">
                                            <li>
                                                <button ng-click="removeProcess(x)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                            </li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-visible="false" e-isprimarykey="true"></div>
            <div e-column e-field="SrNo" e-headertext="SrNo" e-width="2"></div>
            <div e-column e-field="DefectCode" e-headertext="DefectCode" e-width="3"></div>
            <div e-column e-field="DefectCategory" e-headertext="DefectCategory" e-width="5"></div>
            <div e-column e-field="DefectNames" e-headertext="DefectNames" e-width="5"></div>
            <div e-column e-field="TypesOfDefects" e-headertext="TypesOfDefects" e-width="5"></div>
            <div e-column e-field="Zone" e-headertext="Zone" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Processes/Views/Shared/_SelectMultipleProcessPopUp.cshtml")
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteProcess();"></confirm-archive-generic>