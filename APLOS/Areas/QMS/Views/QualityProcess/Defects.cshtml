<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Defects
</h3>
<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Defect Master</a></li>
        <li ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" data-toggle="tab">Defect Point</a></li>
        <li ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);" href="" data-toggle="tab">AQL Master</a></li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        @Html.Partial("~/Areas/QMS/Views/QualityProcess/DefectMaster.cshtml")
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        @Html.Partial("~/Areas/QMS/Views/QualityProcess/DefectPoint.cshtml")
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
        @Html.Partial("~/Areas/QMS/Views/QualityProcess/AQLMaster.cshtml")
    </div>
</div>