<togglable name="{{titleDP}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewDPForm">
    <input type="hidden" ng-model="ModelNewDP.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">SrNo<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="SrNo" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNewDP.SrNo" e-width="100%" required />
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">ZoneA<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="ZoneA" ng-model="ModelNewDP.ZoneA" class="form-control" maxlength="15" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">ZoneC<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="ZoneC" ng-model="ModelNewDP.ZoneC" class="form-control" maxlength="15" required tabindex="3">
            </div>
        </div>
       
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="ModelNewDP.UserName" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">ZoneB<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="ZoneB" ng-model="ModelNewDP.ZoneB" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNewDP.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="SaveDP();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{DPAction}}</button></li>
            <li> <button ng-click="removeDP();" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="ClearDP();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchByDP">
                            <option ng-repeat="option in searchByDPList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="searchDP" ng-enter="getDPData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getDPData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="DPModelList" e-recorddoubleclick="GetDP" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-visible="false" e-isprimarykey="true"></div>
            <div e-column e-field="SrNo" e-headertext="SrNo" e-width="2"></div>
            <div e-column e-field="UserName" e-headertext="UserName" e-width="3"></div>
            <div e-column e-field="ZoneA" e-headertext="ZoneA" e-width="5"></div>
            <div e-column e-field="ZoneB" e-headertext="ZoneB" e-width="5"></div>
            <div e-column e-field="ZoneC" e-headertext="ZoneC" e-width="5"></div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmDelPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteDP();"></confirm-archive-generic>