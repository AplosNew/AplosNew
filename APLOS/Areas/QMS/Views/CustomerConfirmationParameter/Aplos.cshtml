<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Customer Confirmation Parameter
</h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .modellgModify {
        width: 1600px;
    }
</style>
<div class="form-horizontal form-elements">
    <div class="row">
        <div class="col-xs-12">
            <div id="GridCustomerRequirementControl" ej-grid e-datasource="CustomerRequirementControlList" e-recorddoubleclick="GetDetails"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true" e-rowdatabound="rowDataBound"
                 e-allowselection="false" e-allowscrolling="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-type="string" e-field="CustomerType" e-headertext="Customer Type" e-width="100"></div>
                    <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="100"></div>
                    <div e-column e-type="string" e-field="LineItemNo" e-headertext="LineItemNo" e-width="100"></div>
                    <div e-column e-type="string" e-field="Material" e-headertext="Material" e-width="100"></div>
                    <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="100"></div>
                    <div e-column e-type="string" e-field="BuyerReferenceNo" e-headertext="Buyer ReferenceNo" e-width="100"></div>
                    <div e-column e-type="string" e-field="OwnReferenceNo" e-headertext="Own ReferenceNo" e-width="100"></div>
                    <div e-column e-type="string" e-field="ProductLibraryCode" e-headertext="ProductLibrary Code" e-width="100"></div>
                    <div e-column e-type="string" e-field="ProductionGrouping" e-headertext="Production Grouping" e-width="100"></div>
                    <div e-column e-type="string" e-field="PONo" e-headertext="PONo" e-width="100"></div>
                    <div e-column e-type="string" e-field="ItemQty" e-headertext="Item Qty" e-width="100"></div>
                    <div e-column e-type="string" e-field="Remark" e-headertext="Remark" e-width="100"></div>
                    <div e-column e-type="string" e-field="POStatus" e-headertext="PO Status" e-width="100"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="UpdateCustomerParameterPopUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Customer Confirmation Parameter<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-element-ctrl form-horizontal">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal" style="padding-left:0px;">
                        <div class="form-group" style="margin-bottom: 0px;">
                            <label class="col-sm-2 control-label">Line Item No<sup>*</sup></label>
                            <label class="col-sm-2 control-label">Para.Responsible Person<sup>*</sup></label>
                            <label class="col-sm-2 control-label">Para.Approval Person</label>
                            <label class="col-sm-2 control-label">Critical Level</label>
                            <label class="col-sm-2 control-label">Remarks</label>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal" style="padding-left:0px;">
                        <div class="form-group">
                            <div class="col-sm-2">
                                <input type="text" ng-disabled="true" ng-model="CustomerUpdateParaNew.LineItemNo" class="form-control" maxlength="200">
                            </div>
                            <div class="col-sm-2">
                                <div class="select-style">
                                    <select class="form-control" ng-model="CustomerUpdateParaNew.EmployeeId" name="Parameter Responsible Person"
                                            ng-options="item.Value as item.Text for item in ParameterResponsiblePersonLists">
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="select-style">
                                    <select class="form-control" ng-model="CustomerUpdateParaNew.ApprovedById" name="Parameter Approval Person"
                                            ng-options="item.Value as item.Text for item in ParameterApprovalPersonLists">
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="select-style">
                                    <select class="form-control" ng-model="CustomerUpdateParaNew.CriticalLevel" name="Critical Level"
                                            ng-options="item.Value as item.Text for item in CriticalLevelLists">
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <input type="text" ng-model="CustomerUpdateParaNew.Remarks" class="form-control" maxlength="200">
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="clearfix common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li><button ng-click="CustomerUpdateSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="modal-dialog modal-lg modellgModify">
                <div id="CustomerConfirmationParameterDetails" ej-grid style="z-index:3;"
                     e-datasource="CCPDList"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-allowsorting="true"
                     e-enabletouch="false"
                     e-responsive="true"
                     e-allowselection="true"
                     e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="ParameterId" e-headertext="ParameterId" e-width="50" e-visible="false"></div>
                        <div e-column e-field="TransactionHeaderId" e-headertext="TransactionHeaderId" e-width="50" e-visible="false"></div>
                        <div e-column e-field="Issue" e-headertext="Issue" e-width="120"></div>
                        <div e-column e-field="ParameterName" e-headertext="Parameter Name" e-width="100"></div>
                        <div e-column e-field="UOM" e-headertext="UOM" e-width="100"></div>
                        <div e-column e-template="#MinRequirement" e-headertext="Min Requirement" e-width="100"></div>
                        <div e-column e-template="#MaxRequirement" e-headertext="Max Requirement" e-width="100"></div>
                        <div e-column e-template="#MinStandard" e-headertext="Min Standard" e-width="100"></div>
                        <div e-column e-template="#MaxStandard" e-headertext="Max Standard" e-width="100"></div>
                        <div e-column e-template="#CriticalLevelGrid" e-headertext="CriticalLevel" e-width="100"></div>
                        <div e-column e-template="#ResponsiblePerson" e-headertext="Responsible Person" e-width="100"></div>
                        <div e-column e-template="#Remarks" e-headertext="Remarks" e-width="150"></div>
                        <div e-column e-template="#SaveQIC" e-headertext="Save" e-width="80"></div>
                    </div>
                </div>
                <script type="text/template" id="MinRequirement">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Min Requirement" ng-model="data.MinRequirement" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
                <script type="text/template" id="MaxRequirement">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Max Requirement" ng-model="data.MaxRequirement" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
                <script type="text/template" id="MinStandard">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="MinStandard" ng-model="data.MinStandard" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
                <script type="text/template" id="MaxStandard">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="MaxStandard" ng-model="data.MaxStandard" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
                <script type="text/template" id="Remarks">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Remarks" ng-model="data.Remarks" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
                <script type="text/template" id="ResponsiblePerson">
                    <div class="col-sm-12" style="padding:0px;">
                        <input type="text" ng-click="$parent.selectGridResponsible(this);" name="Responsible Person" ng-model="data.ResponsiblePerson" ng-disabled="false" class="form-control" readonly>
                    </div>
                </script>
                <script type="text/template" id="QUDJobCart">
                    <div class="form-group">
                        <div class="common-btn">
                            <a class="btn" style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" href="Productions/QualityControl/GetQualityUpdateIssueJobCardReportView?PlannedId={{data.QCId}}" target="_blank">
                                <i class="glyphicon glyphicon-print"></i>
                            </a>
                        </div>
                    </div>
                </script>
                <script type="text/template" id="SaveQIC">
                    <div class="form-group">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="$parent.SaveUCPD(this);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i></button></li>
                            </ul>
                        </div>
                    </div>
                </script>
                <script type="text/template" id="Delete">
                    <div class="form-group">
                        <div class="common-btn">
                            <ul class="list-inline action-list">
                                <li>
                                    <button ng-click="$parent.deleteMasterWC(this);" class="btn"><i class="glyphicon glyphicon-remove"></i></button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </script>
                <script type="text/template" id="CriticalLevelGrid">
                    <div class="select-style">
                        <select class="form-control" ng-model="data.CriticalLevel" name="CriticalLevel"
                                ng-options="item.Value as item.Text for item in $parent.CriticalLevelGridLists">
                        </select>
                    </div>
                </script>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="ResponsiblePersonPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Employee List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an Employee</p>
                        <div style="color:black;" id="GridResponsiblePersonPopUp" ej-grid e-datasource="EmployeeList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="doubleEmployee">
                            <div e-columns>
                                <div e-column e-field="SystemId" e-headertext="Id" e-visible="false" e-width="120"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="120"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="120"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="120"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="120"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeResponsiblePersonPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>




