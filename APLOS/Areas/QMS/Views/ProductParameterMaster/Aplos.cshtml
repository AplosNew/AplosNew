<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetPRM(1), active: isSetPRM(1) }">
        <togglable name="Product Parameter Master"></togglable>
        <div class="form-elements form-horizontal">
            <div class="row" ng-form="ProductParameterMasterForm">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ProductParaMasterNew.Sequence" e-width="100" required />
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Short Name" ng-model="ProductParaMasterNew.ShortName" class="form-control" maxlength="50" required tabindex="3">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="ProductParaMasterNew.UserName" class="form-control" required tabindex="5" maxlength="100">
                        </div>
                    </div>
                   
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Product Group<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="Position Code" ng-disabled="true" ng-model="ProductParaMasterNew.ProductGroup" class="form-control" maxlength="100" required autocomplete="off">
                            </div>
                            <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                <button ng-click="selectProductGroup();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ProductParaMasterNew.IsActive" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                        <div class="col-sm-4 show-message">
                            <input type="text" name="Code" ng-model="ProductParaMasterNew.Code" class="form-control" required tabindex="2" maxlength="10">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ProductParaMasterNew.StandardName" class="form-control" required tabindex="4" maxlength="100">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="ProductParaMasterNew.Remarks" maxlength="250" tabindex="6"></textarea>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveProductParaMaster();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                        <li> <button ng-click="removeProductParaMaster($index,ProductParaMasterNew.Id);" ng-disabled="ProductParaMasterNew.Id===null" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete </button></li>
                        <li> <button ng-click="ClearProductParaMaster();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="table-responsive aplos-grid-toggle">
            <div id="GridQualityManagementMaster" ej-grid e-datasource="QualityManagementMasterList" e-recorddoubleclick="GetDetails"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Quality Id" e-visible="false" e-width="50"></div>
                    <div e-column e-field="Sequence" e-headertext="Sequence" e-width="100"></div>
                    <div e-column e-field="StandaredName" e-headertext="Standard Name" e-width="100"></div>
                    <div e-column e-field="ScheduleDays" e-headertext="Schedule Days" e-width="100"></div>
                    <div e-column e-field="UserName" e-headertext="User Name" e-width="100"></div>
                    <div e-column e-field="ResponsiblePersoneBgtCode" e-headertext="Res.Pers.Bgt Code" e-width="100"></div>
                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                </div>
            </div>
        </div>
    </div>
    <div role="tabpanel" ng-form="ProductGroupForm" class="tab-pane fade" ng-class="{ 'in':isSetPRM(2), active: isSetPRM(2) }">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Production Group</label>
                <div class="col-sm-8">
                    <input type="text" name="Production Group" ng-model="ProductGroupNew.ProductionGroup" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Production SubGroup</label>
                <div class="col-sm-8">
                    <input type="text" name="Production SubGroup" ng-model="ProductGroupNew.ProductionSubGroup" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Production Item</label>
                <div class="col-sm-8">
                    <input type="text" name="Production Item" ng-model="ProductGroupNew.ProductionItem" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12"></div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="ProductGroupSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                <li> <button ng-click="removeProductGroup($index,ProductGroupNew.Id);" ng-disabled="ProductGroupNew.Id===null" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete </button></li>
                <li> <button ng-click="ProductGroupClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
        <div id="GridProductGroup" ej-grid e-datasource="ProductGroupList" e-recorddoubleclick="GetProductGroupDetails"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="50"></div>
                <div e-column e-field="ProductionGroup" e-headertext="Production Group" e-width="100"></div>
                <div e-column e-field="ProductionSubGroup" e-headertext="Production SubGroup" e-width="100"></div>
                <div e-column e-field="ProductionItem" e-headertext="Production Item" e-width="100"></div>
            </div>
        </div>
    </div>
