<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSetPRM(1) }"><a ng-click="setTabPRM(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Product Parameter Master</a></li>
        <li role="presentation" ng-class="{ active: isSetPRM(2) }"><a ng-click="setTabPRM(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Product Group</a></li>
    </ul>
