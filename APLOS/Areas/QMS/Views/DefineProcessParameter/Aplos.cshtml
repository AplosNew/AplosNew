<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Define Process Parameter
</h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .modellgModify {
        width: 1600px;
    }
</style>
<togglable name="Define Process Parameter"></togglable>
<div class="form-elements form-horizontal">
    <div class="row" ng-form="DefineProcessParameterForm">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Group Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="DefineProcessParameterNew.Group" name="Group" ng-options="item.Value as item.Text for item in GroupList" ng-change="getPPMSubGroup(DefineProcessParameterNew.Group);" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="DefineProcessParameterNew.MasterId" name="User Name" ng-options="item.Value as item.Text for item in UserNameList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">UserCode<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="UserCode" ng-model="DefineProcessParameterNew.UserCode" required class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">DefineName<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="DefineName" ng-model="DefineProcessParameterNew.DefineName" required class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sub Group Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="DefineProcessParameterNew.SubGroup" name="Sub Group" ng-options="item.Value as item.Text for item in SubGroupList" ng-change="getPPMUserName(DefineProcessParameterNew.SubGroup);" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Bywhom<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Bywhom" ng-disabled="true" ng-model="DefineProcessParameterNew.ByWhom" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectByWhom();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <input type="text" name="Remarks" ng-model="DefineProcessParameterNew.Remarks" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-12 control-label"></label>
        <label class="col-sm-12 control-label"></label>
    </div>
    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Article</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Process Parameter</a></li>

        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div id="GridDefineProcessParameterArticle" ej-grid e-datasource="DefineProcessParameterArticleList" e-templaterefresh="refreshTemplateArticle" e-recorddoubleclick=""
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-headertext="All" e-headertemplateid="#headerTemplateArticle" e-template="#checkboxTemplateArticle" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                        <div e-column e-field="Product" e-headertext="Product" e-width="100"></div>
                        <div e-column e-field="Material" e-headertext="Material" e-width="100"></div>
                        <div e-column e-field="Article" e-headertext="Article" e-width="100"></div>
                        <div e-column e-template="#Remarks" e-headertext="Remarks" e-width="200"></div>
                    </div>
                </div>
                <script type="text/template" id="checkboxTemplateArticle">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplateArticle">
                    <input type="checkbox" id="Aheadchk" />
                </script>
                <script type="text/template" id="Remarks">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Remarks" ng-model="data.Remarks" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-disabled="DefineProcessParameterNew.Id===null" ng-click="ArticleSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                </ul>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div style="color:black;" id="GridDefineProcessParaProcess" ej-grid e-datasource="DefineProcessParaProcessList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                     e-recorddoubleclick="" e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" e-templaterefresh="refreshTemplateDefineProcess">
                    <div e-columns>
                        <div e-column e-headertext="All" e-headertemplateid="#headerTemplateDefineProcess" e-template="#checkboxTemplateDefineProcess" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                        <div e-column e-field="UserName" e-headertext="Process.Para.Master" e-width="100"></div>
                        <div e-column e-template="#ProcessRemarks" e-headertext="Remarks" e-width="200"></div>
                        <div e-column e-template="#ProcessParameter" e-headertext="Process Parameter" e-width="200"></div>
                    </div>
                </div>

                <script type="text/template" id="checkboxTemplateDefineProcess">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplateDefineProcess">
                    <input type="checkbox" id="DPheadchk" />
                </script>
                <script type="text/template" id="ProcessRemarks">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Process Remarks" ng-model="data.Remarks" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
                <script type="text/template" id="ProcessParameter">
                    <div class="form-group">
                        <div class="col-sm-5 text-center" style="padding:0px;padding-left:2px">
                            <div class="common-btn">
                                <ul class="list-inline text-center">
                                    <li><button ng-disabled="data.Id===null" ng-click="$parent.getProcessParameterPopup(this)" class="btn"><i class="glyphicon glyphicon-list"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </script>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-disabled="ProcessParaMasterNew.Id===null" ng-click="ProcessSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
