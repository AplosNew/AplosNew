<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Order Wise Quality Report
</h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .modellgModify {
        width: 1600px;
    }
</style>
<div class="form-horizontal form-elements">
    <div class="row">
        <div class="col-xs-12">
            <div id="GridOrderWiseQualityReport" ej-grid e-datasource="OrderWiseQualityReportList" e-recorddoubleclick="GetDetails"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true" e-rowdatabound="rowDataBound"
                 e-allowselection="false" e-allowscrolling="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-type="string" e-field="QualityStatus" e-headertext="Quality Status" e-width="100"></div>
                    <div e-column e-type="string" e-field="Date" e-headertext="Date" e-width="100"></div>
                    <div e-column e-type="string" e-field="MOLineItemNo" e-headertext="MO LineItem No." e-width="100"></div>
                    <div e-column e-type="string" e-field="POStatus" e-headertext="PO Status" e-width="100"></div>
                    <div e-column e-type="string" e-field="PONo" e-headertext="PO No." e-width="100"></div>
                    <div e-column e-type="string" e-field="LotNumber" e-headertext="Lot Number" e-width="100"></div>
                    <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="100"></div>
                    <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="100"></div>
                    <div e-column e-type="string" e-template="#Grade" e-headertext="Grade" e-width="100"></div>
                    <div e-column e-type="string" e-template="#Comment" e-headertext="Comment" e-width="100"></div>
                </div>
            </div>
            <script type="text/template" id="Grade">
                <div class="col-sm-10" style="padding:0px;">
                    <input type="text" name="Grade" ng-model="data.Grade" class="form-control" maxlength="200">
                </div>
            </script>
            <script type="text/template" id="Comment">
                <div class="col-sm-10" style="padding:0px;">
                    <input type="text" name="Comment" ng-model="data.CommentDetails" ng-click="$parent.CommentEntry(this);" class="form-control" maxlength="200">
                </div>
            </script>
        </div>
    </div>
</div>
