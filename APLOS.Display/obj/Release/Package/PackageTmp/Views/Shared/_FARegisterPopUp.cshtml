<div class="modal fade site-modal in" id="faRegisterPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Fixed Asset Register
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="faRegisterParameters.searchBy">
                                            <option ng-repeat="option in faRegisterSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="faRegisterParameters.search">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getFARegisterData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table" ng-show="faRegisterDataList.length>0">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th ng-repeat="x in faRegisterSearchList">{{x.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in faRegisterDataList|itemsPerPage:faRegisterParameters.pageSize" total-items="faRegisterParameters.total_count"
                                pagination-id="metaData.name + 'faRegisterDataList'">
                                <td>
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="x.Flag" ng-click="pushInTempList(x,$event,activityFARegisterList)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td ng-repeat="y in faRegisterSearchList">{{x[y.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'faRegisterDataList'"
                                             direction-links="true" boundary-links="true"
                                             on-page-change="getFARegisterData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button type="button" class="btn btn-default" ng-click="closeFARegisterPopUp();">Close</button></li>
                        <li><button type="button" class="btn btn-default" ng-click="selectFARegisterPopUp();">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>