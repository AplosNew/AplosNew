<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Credential Policy</h3>
<div class="form-elements" ng-form id="credentialpolicy" name="credentialpolicyForm">
    <input type="hidden" ng-model="credentialpolicy.Id">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-6 control-label">Password Expire After Day<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" name="PwdExpAfterDay" ng-model="credentialpolicy.PwdExpAfterDay" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-6 control-label">Password Checking From Last History when Password will change<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" name="PwdCheckingFromLastHistory" ng-model="credentialpolicy.PwdCheckingFromLastHistory" class="form-control" required placeholder="0" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-6 control-label">Password Fail Count<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" name="PwdFailCount" ng-model="credentialpolicy.PwdFailCount" class="form-control" required placeholder="0" tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-6 control-label">Password Lock Time Difference<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" name="PwdLockTimeDifference" ng-model="credentialpolicy.PwdLockTimeDifference" class="form-control" required placeholder="0" tabindex="7">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-6 control-label">Active</label>
            <div class="col-sm-6">
                <div class="checkbox">
                    <input type="checkbox" class="css-checkbox" id="active" ng-model="credentialpolicy.Active" tabindex="9">
                    <label class="css-label" for="active"></label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-6 control-label">Password Expire Before Day For Alert<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" name="PwdExpAlertBeforeDay" ng-model="credentialpolicy.PwdExpAlertBeforeDay" class="form-control" required placeholder="0" tabindex="2">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-6 control-label">Authentication Token Fail Count<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" name="AuthTokenFailCount" ng-model="credentialpolicy.AuthTokenFailCount" class="form-control" required placeholder="0" tabindex="6">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-6 control-label">Authentication Token Lock Time Difference<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" name="AuthTokenLockTimeDifference" ng-model="credentialpolicy.AuthTokenLockTimeDifference" class="form-control" required placeholder="0" tabindex="6">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-6 control-label">Two Factor Enable</label>
            <div class="col-sm-6">
                <div class="checkbox">
                    <input type="checkbox" class="css-checkbox" id="twofactorenable" ng-model="credentialpolicy.TwoFactorEnable" tabindex="6">
                    <label class="css-label" for="twofactorenable"></label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-6 control-label">Allow Concurrent User</label>
            <div class="col-sm-6">
                <div class="checkbox">
                    <input type="checkbox" class="css-checkbox" id="allowconcurrentuser" ng-model="credentialpolicy.AllowConcurrentUser" tabindex="10">
                    <label class="css-label" for="allowconcurrentuser"></label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>