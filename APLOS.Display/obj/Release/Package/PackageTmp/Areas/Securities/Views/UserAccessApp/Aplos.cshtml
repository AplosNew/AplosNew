<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> User Access App</h3>
<div class="form-elements" ng-form name="userAccessAppForm">
    <input type="hidden" ng-model="userAccessApp.Id">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 15px;">
                <span class="input-group-addon">{{userAccessApp.UserName}}</span>
                <input type="text" name="User" ng-model="userAccessApp.UserFullname" class="form-control" required readonly>
                <span class="input-group-btn">
                    <button name="submit" class="btn single-small-btn" ng-click="popUp()" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" required ng-model="userAccessApp.CompanyId" ng-options="item.Value as item.Text for item in companyList"
                            id="companyId" name="Company Name" tabindex="2">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="search();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button></li>
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
        </ul>
    </div>
</div>
<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="appMapping" role="tab" data-toggle="tab">App Mapping</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="userAppList" role="tab" data-toggle="tab">User App List</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{'in':isSet(1), active: isSet(1) }">
            <div class="table-responsive modal-table" ng-show="tableShow">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Apply</th>
                            <th>Module App</th>
                            <th>Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in userAccessApps">
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="x.Active" ng-checked="x.Active" />
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>{{x.ModuleAppName}}</td>
                            <td>{{x.Status?'Yes':'No'}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{'in':isSet(2), active: isSet(2) }">
            <div class="table-responsive modal-table" ng-show="appAccessList.length>0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>AppId</th>
                            <th>Module App</th>
                            <th>Company</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in appAccessList">
                            <td>{{x.MAppId}}</td>
                            <td>{{x.MAppName}}</td>
                            <td>{{x.CompanyName}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                User <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in searchByUserList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Employee Id</th>
                                <th>Full Name</th>
                                <th>Auth Token</th>
                                <th>User Type</th>
                                <th>Auth Token Locked</th>
                                <th>User Locked</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count"
                                ng-click="selectSingleClick(x)" ng-class="{selected : x.UserId === rowSelected}" ng-dblclick="selectDoubleClick(x);" pagination-id="metaData.name + 'popUpList'">
                                <td>{{x.UserId}}</td>
                                <td>{{x.EmployeeId}}</td>
                                <td>{{x.FullName}}</td>
                                <td>{{x.AuthToken}}</td>
                                <td>{{x.UserType}}</td>
                                <td>{{x.AuthTokenLocked?'Locked':'UnLocked'}}</td>
                                <td>{{x.UserLocked?'Locked':'UnLocked'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'popUpList'" direction-links="true" boundary-links="true" on-page-change="getPopUpData(newPageNumber)"></dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="selectByButton();" class="btn"><i class=""></i> Select</button></li>
                        <li><button type="button" class="btn btn-default" ng-click="closePopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>