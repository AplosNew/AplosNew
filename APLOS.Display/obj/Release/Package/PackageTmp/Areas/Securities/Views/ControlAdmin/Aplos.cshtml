<togglable name="Control Admin"></togglable>
<div class="form-elements" ng-form id="controlAdmin" name="controlAdminForm">
    <input type="hidden" ng-model="controlAdmin.UserId">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Username<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="30" type="text" name="User" ng-model="controlAdmin.UserId" ng-readonly="inactive" class="form-control" required placeholder="User Name" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Full Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="30" type="text" name="Full Name" ng-model="controlAdmin.FullName" class="form-control" required placeholder="Type your full name" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Email<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="30" type="text" name="Email" ng-model="controlAdmin.Email" class="form-control" required placeholder="example@mail.com" tabindex="5">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" ng-show="passwordShow" show-errors>
            <label class="col-sm-4 control-label">Password<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="100" type="password" name="Password" ng-model="controlAdmin.Password" class="form-control" id="pwd" required tabindex="2">
            </div>
        </div>
        <div class="form-group" ng-show="passwordShow" show-errors>
            <label class="col-sm-4 control-label">Confirm Password<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="100" type="password" name="Confirm Password" ng-model="controlAdmin.ConfirmPassword" class="form-control"
                       ng-keyup="compare(controlAdmin.Password,controlAdmin.ConfirmPassword)" id="confirmPassword" required tabindex="4">
                <p class="msg-error" ng-show="compareTo">These passwords don't match. Try again?</p>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th class="text-right">Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in filtered = (controlAdmins | orderBy:'Sequence') |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.UserId, $index);">
                <td>{{x.UserId}}</td>
                <td>{{x.FullName}}</td>
                <td>{{x.Email}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li><a href="{{bootPoint}}control-admin-reset/{{x.UserId}}" class="btn-action tooltip-here" data-toggle="tooltip" data-placement="top" title="Password Reset" tooltip><i class="glyphicon glyphicon-pencil"></i>Reset</a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>