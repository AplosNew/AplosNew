<style type="text/css">
    label .lblcheckbox {
        position: relative;
        cursor: pointer;
        color: white;
    }

    label [type="checkbox"] {
        display: none;
    }

    [type="checkbox"] + span {
        display: inline-block;
        text-align: center;
        color: white;
        padding-top: .4em;
        padding-right: .5em;
        padding-bottom: .5em;
        padding-left: .5em;
        background: #f00;
        height: 28px;
    }

    :checked + span {
        background: #a6edb2;
    }

    [type="checkbox"][disabled] + span {
        background: #f00;
    }
</style>
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> User Access Override</h3>
<div class="form-elements form-horizontal" ng-form name="userRoleDetailForm">
    <input type="hidden" ng-model="userRoleDetail.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Username :</label>
            <input type="hidden" ng-model="userRoleDetail.UserId" />
            <label class="col-sm-8 " ng-model="userRoleDetail.UserName"><b>{{userRoleDetail.UserName}} </b></label>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Company :</label>
            <input type="hidden" ng-model="userRoleDetail.CompanyId">
            <label class="col-sm-8 control-label"><b>{{userRoleDetail.CompanyName}}</b></label>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Full Name :</label>
            <label class="col-sm-8 control-label" ng-model="userRoleDetail.FullName"><b>{{userRoleDetail.FullName}}</b></label>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Role :</label>
            <input type="hidden" ng-model="userRoleDetail.RoleId">
            <label class="col-sm-8 control-label"><b>{{userRoleDetail.RoleName}}</b></label>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
            <li> <button ng-click="Back();" class="btn"><i class="glyphicon glyphicon-arrow-left"></i> Back</button></li>
        </ul>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Panel Name</th>
                    <th>Menu Frame</th>
                    <th>Menu Group</th>
                    <th>Menu Subgroup</th>
                    <th>Menu Items</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="roleDetail in roleDetails">
                    <td>{{roleDetail.PanelName}}</td>
                    <td>{{roleDetail.MenuFrameName}}</td>
                    <td>{{roleDetail.MenuGroupName}}</td>
                    <td>{{roleDetail.MenuSubGroupName}}</td>
                    <td>{{roleDetail.MenuItemName}}</td>
                    <td>
                        <label class="lblcheckbox" ng-repeat="menuAction in roleDetail.MenuActions">
                            <input type="checkbox" ng-model="menuAction.Active"> &nbsp; &nbsp;
                            <span>{{menuAction.MenuActionName}}</span>
                        </label>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>