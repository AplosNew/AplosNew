<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Change Password</h3>
<div class="form-elements form-horizontal" ng-form name="cpanalePwdChangeForm">
    <fieldset class="col-xs-12 col-sm-7 col-md-7 scheduler-border" style="background-color: #e74c3c;">
        <div class="col-xs-12 col-sm-12 col-md-12" style="padding-top:18px;">
            <div class="form-group">
                <label class="col-sm-4 control-label">Username</label>
                <div class="col-sm-8">
                    <input type="text" ng-model="clientAdmin.UserId" readonly class="form-control" tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Old Password<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="password" name="Old Password" ng-model="clientAdmin.OldPassword" class="form-control" required tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">New Password<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="password" name="Password" ng-model="clientAdmin.Password" class="form-control"
                           ng-keyup="compare(clientAdmin.Password, clientAdmin.ConfirmPassword)" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">New Confirmed Password<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="password" name="Confirm Password" ng-model="clientAdmin.ConfirmPassword" class="form-control"
                           ng-keyup="compare(clientAdmin.Password, clientAdmin.ConfirmPassword)" required tabindex="4">
                    <p class="msg-error" ng-show="compareTo">These passwords don't match. Try again?</p>
                </div>
            </div>
        </div>
    </fieldset>
</div>
<div class="common-btn">
    <ul class="list-inline text-right">
        <li ng-show="show"><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> Update</button></li>
        <li><button ng-click="Back();" class="btn"><i class="glyphicon glyphicon-arrow-left"></i> Back</button></li>
    </ul>
</div>