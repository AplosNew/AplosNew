<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }

    .e-grid .e-rowcell {
        line-height: 22px;
        /*font-size: 14px;*/
        padding: 0px 2px 0px 2px;
    }
</style>
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Employee Mobile Apps Authorization</h3>
<div id="payrollGroupMasterNew" class="form-horizontal form-elements" ng-form name="payrollGroupMasterNewForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="empMobileAuthSearchParameters.CompanyId" ng-options="item.Value as item.Text for item in complanyList"
                            name="Company Name" ng-change="getPlantByCompany();" tabindex="2" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-5 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-7 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="empMobileAuthSearchParameters.PlantId" name="Plant" ng-change="plantChange();getAssignData();"
                            ng-options="item.Value as item.Text for item in plantList" required tabindex="1">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="assign" role="tab" data-toggle="tab">Employee (Plant Wise)</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);getGusetData();" href="" aria-controls="assigned" role="tab" data-toggle="tab">Guest(Group Wise)</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="content-container-fluid" style="color:black;" ng-show="assignList.length>0">
                        <div id="Grid" ej-grid e-datasource="assignList" e-editsettings-allowediting="true" e-endedit="savesingledata" e-editsettings-editmode="dialog"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-field="EmployeeId" e-headertext="Emp Id" e-width="60" e-isprimarykey="true"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Emp Code" e-width="70" e-allowediting="false"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Emp Name" e-width="90" e-allowediting="false"></div>
                                <div e-column e-field="DepartmentName" e-headertext="Deparment" e-width="70" e-allowediting="false"></div>
                                <div e-column e-field="DesignationName" e-headertext="GivenDesignation" e-width="100" e-allowediting="false"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="70" e-allowediting="false"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-width="70" e-allowediting="false"></div>
                                <div e-column e-field="PIN" e-headertext="PIN" e-width="35" e-allowediting="true"></div>
                                <div e-column e-headertext="Set PIN" e-commands="setPinCommand" e-isunbound=true e-textalign="center" e-width="40"></div>
                                @*<div e-column e-headertext="Delete" e-commands="command" e-isunbound=true e-textalign="center" e-width="30"></div>*@
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                @*<div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li style="float:left"> </li>
                    <li style="float:right"> <button ng-click="Save();" class="btn" ng-disabled="" ng-show="unassignList.length>0"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>
                </ul>
            </div>

        </div>
        <div class="clearfix"></div>
        <div class="col-sx-12">
            <div class="row">
                <div class="content-container-fluid" style="color:black;" ng-show="unassignList.length>0">
                    <div style="color:black;" id="Grid1" ej-grid e-datasource="unassignList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel"
                         e-templaterefresh="refreshTemplateemployee">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>
                            <div e-column e-field="EmployeeId" e-headertext="Emp Id" e-width="80"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Emp Code" e-width="90"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Emp Name" e-width="110"></div>
                            <div e-column e-field="DepartmentName" e-headertext="Deparment" e-width="100"></div>
                            <div e-column e-field="DesignationName" e-headertext="GivenDesignation" e-width="100"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="PIN" e-headertext="PIN" e-width="80"></div>
                        </div>
                    </div>

                </div>
            </div>

            <script type="text/x-jsrender" id="checkboxTemplate">
                <input type="checkbox" ng-model="{{:Id}}" class="rowCheckbox" value="{{:Id}}" />
            </script>
            <script type="text/x-jsrender" id="headerTemplate">
                <input type="checkbox" id="headchk" />
            </script>
        </div>*@
                <div class="col-sx-12">
                    <div class="row">
                        <div class="content-container-fluid" style="color:black;" ng-show="gusetList.length>0">
                            <div id="GridGuest" ej-grid e-datasource="gusetList" e-editsettings-allowediting="true" e-endedit="savesingledata" e-editsettings-editmode="dialog"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>

                                    <div e-column e-field="Id" e-headertext="Id" e-width="60" e-isprimarykey="true" e-visible="false"></div>
                                    <div e-column e-field="EmployeeId" e-headertext="Emp Id" e-width="60"></div>
                                    @*<div e-column e-field="EmployeeCode" e-headertext="Emp Code" e-width="70" e-allowediting="false"></div>*@
                                    <div e-column e-field="EmployeeName" e-headertext="Emp Name" e-width="90" e-allowediting="false"></div>
                                    <div e-column e-field="EmailId" e-headertext="EmailId" e-width="70" e-allowediting="false"></div>
                                    <div e-column e-field="Division" e-headertext="Division" e-width="100" e-allowediting="false"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-width="70" e-allowediting="false"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="70" e-allowediting="false"></div>
                                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="70" e-allowediting="false"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="70" e-allowediting="false"></div>
                                    <div e-column e-field="PIN" e-headertext="PIN" e-width="35" e-allowediting="true"></div>
                                    <div e-column e-headertext="Set PIN" e-commands="setGusetPinCommand" e-isunbound=true e-textalign="center" e-width="40"></div>
                                    @*<div e-column e-headertext="Delete" e-commands="command" e-isunbound=true e-textalign="center" e-width="30"></div>*@
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<confirm-archive-generic modalid="confirm_PopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>

