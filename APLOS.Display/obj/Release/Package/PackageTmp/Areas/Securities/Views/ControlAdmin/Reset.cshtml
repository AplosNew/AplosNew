<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Reset Password</h3>
<div class="form-element-ctrl form-horizontal" ng-form id="controlAdminReset" name="controlAdminForm">
    <fieldset class="col-xs-12 col-sm-7 col-md-7 scheduler-border" style="background-color: #e74c3c;">
        <div class="col-xs-12 col-sm-12 col-md-12" style="padding-top:18px;">
            <div class="form-group">
                <label class="col-sm-4 control-label">Username<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" ng-model="controlAdminReset.UserId" readonly class="form-control" required placeholder="0">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">New Password<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="password" name="Password" ng-model="controlAdminReset.Password" ng-keyup="compare(controlAdminReset.Password, controlAdminReset.ConfirmPassword)" class="form-control" id="pwd" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">New Confirmed Password<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="password" name="Confirm Password" ng-model="controlAdminReset.ConfirmPassword" class="form-control"
                           ng-keyup="compare(controlAdminReset.Password, controlAdminReset.ConfirmPassword)" id="Conpwd" required>
                    <p class="msg-error" ng-show="compareTo">These passwords don't match. Try again?</p>
                </div>
            </div>
        </div>
    </fieldset>
</div>
<div class="common-btn">
    <ul class="list-inline text-right">
        <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Reset</button></li>
        <li><button ng-click="Back();" class="btn"><i class="glyphicon glyphicon-arrow-left"></i> Back</button></li>
    </ul>
</div>