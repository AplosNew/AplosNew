<togglable name="Control Admin"></togglable>
<div class="form-elements" ng-form id="controlAdmin" name="controlAdminForm">
    
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Id<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="30" type="text" name="User" ng-model="ModelNew.Id" ng-readonly="inactive" class="form-control" required placeholder="User Name" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">URL<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="10000" type="text" name="Full Name" ng-model="ModelNew.URL" class="form-control" required placeholder="Type your full name" tabindex="3">
            </div>
        </div>        
    </div>  
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="content-container-fluid" style="color:black;">
            <div style="color:black;" id="MenuSyncList" ej-grid e-datasource="ModelList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true" e-recorddoubleclick="Get" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-width="60"></div>
                    <div e-column e-field="URL" e-headertext="URL" e-width="80"></div>                    
                </div>
            </div>
        </div>
    </div>
  
</div>
<confirm-modal></confirm-modal>