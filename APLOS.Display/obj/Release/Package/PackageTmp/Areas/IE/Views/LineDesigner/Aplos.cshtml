<link href="content/images/diagram/drawingtools/drawingtools.css" rel="stylesheet" />
<style type="text/css">
    .e-toolbar > .e-horizontal.e-ul > li {
        margin: 5px;
        margin-left: .3px;
        margin-top: 0px;
        width: 36px;
        height: 25px;
    }

    .toolBarIconStyle {
        font-size: 17px;
        color: #6B6B6B;
        margin-top: 4px;
        margin-left: 8px;
    }

    .icon-colors {
        color: #ffffff;
    }

    .router {
        margin-top: 0px;
        margin-bottom: 0px;
    }
</style>
<div id="mainContent"></div>

<div id="ToolbarItem" ej-toolbar e-datasource="drawingToolsList" e-fields-tooltiptext="tooltiptext"
     e-width="100%" e-height="33px" e-fields-id="id" e-fields-spritecssclass="spriteCss" e-click="onItemclick"
     style="background-color: #ebeced; border-bottom-color: #bbbbbb; border-top-style: none; border-left-style: none; border-right-style: none">
</div>
<div>
    <ej-diagram id="diagram" e-height="350px" e-itemclick="itemClick" e-width="100%" e-nodes="nodes">
    </ej-diagram>
</div>

<script id="htmlTemplate" type="text/template">
    <div class="row">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <input type="button" value="{{this.items[0].addInfo.Sequence}}" style="color: #000; width:100%; background-color: #fbfb00; border-color: #f89b1c" />
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <input type="button" value="{{this.items[0].addInfo.RequiredManPower}}" style="color: #ffffff; width:100%; background-color: #3900e8; border-color: #f89b1c" />
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <input type="button" value="{{this.items[0].addInfo.AllotedWorkstation}}" style="color: #ffffff; width:100%; background-color: #009400; border-color: #f89b1c" />
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" ng-click="$parent.employeeButtonClick(this);" src="POPResources/EmployeeProfiles/EmpPic/{{this.items[0].addInfo.EmpPicPath}}"
                 style="height:70px;width:70px;border:2px solid #efefef; border-radius:50%;" />
        </div>
        <div class="col-xs-12 col-sm-8 col-md-8" style="vertical-align:central;">
            {{this.items[0].addInfo.EmployeeName}} <br />
            {{this.items[0].addInfo.Designation}}

        </div>
    </div>

    <div class="row">
        <div class="col-xs-12 col-sm-9 col-md-9">{{this.items[0].addInfo.OperationDesc?this.items[0].addInfo.OperationDesc:'[select operation]'}}</div>
        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="common-btn">
                <ul class="list-inline text-right small">
                    <li>
                        <button ng-click="$parent.operationButtonClick(this);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                            <i class="glyphicon glyphicon-search"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="row" style="padding-top:4px;">
        <div class="col-xs-12 col-sm-9 col-md-9">{{this.items[0].addInfo.MachineDesc?this.items[0].addInfo.MachineDesc:'[select machine]'}}</div>
        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="common-btn">
                <ul class="list-inline text-right small">
                    <li>
                        <button ng-click="$parent.machineButtonClick(this);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                            <i class="glyphicon glyphicon-search"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</script>
<script id="svgTemplate" type="text/x-jsrender">
    <svg version="1.0" xmlns="http://www.w3.org/2000/svg" width="350.000000pt" height="229.000000pt" viewBox="0 0 350.000000 229.000000" preserveAspectRatio="xMidYMid meet">
        <g transform="translate(0.000000,229.000000) scale(0.100000,-0.100000)" fill="#de6ca9" stroke="none">
            <path d="M0 23l8-8 17 17 7-7-17-17 8-8h-23v23z"></path>
        </g>

    </svg>
</script>


<ej-dialog id="dialogSearchEmployee" title="Employees" e-enablemodal="true" e-position-y="0" e-position-x="0" e-showoninit="false" e-target="#mainContent" e-close="onDialogClose" e-width="900" e-open="enableBtn">
    <div class="col-xs-12" style="border:1px solid #dfdfdf">
        <div class="row text-right">
            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="search-form">
                    <div class="row">
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="select-style">
                                <select ng-model="EmployeeSearchCol">
                                    <option ng-repeat="option in EmployeemodelFilterByList" value="{{option.value}}">{{option.name}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-7 col-md-7">
                            <input type="text" class="form-control" placeholder="Search" ng-model="EmployeeSearchVal" ng-enter="getEmployeeData()">
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2">
                            <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="SearchEmployee" ng-init="chkinit()" ej-grid e-datasource="EmployeeList" e-gridlines="horizontal"
             e-allowtextwrap="true" e-textwrapsettings.wrapmode="content"
             e-recorddoubleclick="ViewEmployeeStatus" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="30" e-primarykey="true" e-visible="false"></div>
                <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                <div e-column e-headertext="" e-template="#empdetail" e-textalign="left" e-width="400"></div>
                @*<div e-column e-field="EmployeeCode" e-headertext="Code" e-width="30"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>*@
            </div>
        </div>
        <script type="text/x-jsrender" id="empimage">
            <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')"
                 src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;border:2px solid #efefef; border-radius:50%;" />
        </script>
        <script type="text/template" id="empdetail">
            <div style="font-size:1.2em">
                <span style="color:blue;font-weight:bold;">{{data.EmployeeCode}}  </span><span style="color:black;font-weight:bold;">{{data.EmployeeName}}</span><br />
            </div>
            <div style="font-size:1em;font-style:italic">
                {{data.Designation}}, {{data.Department}}
            </div>
            <div style="font-size:1em;">
                Section: {{data.Section}}, Sub-section: {{data.SubSection}}
            </div>
        </script>
    </div>
</ej-dialog>