<h3 id="ifName" class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Encrypt Decrypt Generator</h3>
<div class="form-elements form-horizontal">
    <div class="col-12">
        <div class="form-group">
            <label class="col-sm-2 control-label">Text<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" ng-model="encryptDecrypt.Decrypt" class="form-control" tabindex="1">
                    <span class="input-group-btn">
                        <button ng-click="EncryptText();" class="btn single-small-btn" tabindex="2">Encrypt</button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="form-group">
            <label class="col-sm-2 control-label">Encrypt Text<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" ng-model="encryptDecrypt.Encrypt" class="form-control" tabindex="3">
                    <span class="input-group-btn">
                        <button ng-click="DecryptText();" class="btn single-small-btn" tabindex="4">Decrypt</button>
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>