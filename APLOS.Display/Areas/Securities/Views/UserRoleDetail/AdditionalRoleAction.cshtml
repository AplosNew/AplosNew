<!-- #region css -->
<style type="text/css">
    label .lblcheckbox {
        position: relative;
        cursor: pointer;
        color: white;
    }

    label [type="checkbox"] {
        display: none;
        /*use your custom sprites instead as background on the span;*/
    }

    [type="checkbox"] + span {
        display: inline-block;
        text-align: center;
        color: white;
        padding-top: .4em;
        padding-right: .5em;
        padding-bottom: .5em;
        padding-left: .5em;
        background: #f00;
        height: 28px;
    }

    :checked + span {
        background: #a6edb2;
    }

    [type="checkbox"][disabled] + span {
        background: #f00;
    }
</style>

<!-- #endregion -->
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> User Access Action</h3>
<div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
    <div class="form-group">
        <label class="col-sm-3 control-label">User :</label>
        <label class="col-sm-9 "><b>{{userRoleDetail.FullName}}</b></label>
    </div>
    <div class="form-group">
        <label class="col-sm-3 control-label">Module :</label>
        <label class="col-sm-9 control-label"><b>{{userRoleDetail.ModuleName}}</b></label>
    </div>
</div>
<div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
    <div class="form-group">
        <label class="col-sm-3 control-label">Company :</label>
        <input type="hidden" value="{{userRoleDetail.CompanyId}}" />
        <label class="col-sm-9 control-label"><b>{{userRoleDetail.CompanyName}}</b></label>
    </div>
    <div class="form-group">
        <label class="col-sm-3 control-label">Menu Frame :</label>
        <label class="col-sm-9 control-label"><b>{{userRoleDetail.MenuFrameName}}</b></label>
    </div>
</div>
<div class="common-btn">
    <ul class="list-inline text-right">
        <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
        <li><button ng-click="Back();" class="btn"><i class="glyphicon glyphicon-arrow-left"></i> Back</button></li>
    </ul>
</div>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Panel Name</th>
                <th>Menu Group</th>
                <th>Menu Subgroup</th>
                <th>Menu Items</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="roleDetail in roleDetails">
                <td>{{roleDetail.PanelName}}</td>
                <td>{{roleDetail.MenuGroupName}}</td>
                <td>{{roleDetail.MenuSubGroupName}}</td>
                <td>{{roleDetail.MenuItemName}}</td>
                <td>
                    <label class="lblcheckbox" ng-repeat="menuAction in roleDetail.MenuActions">
                        <input type="checkbox" ng-model="menuAction.Active"> &nbsp; &nbsp;
                        <span>{{menuAction.MenuActionName}}</span>
                    </label>
                </td>
            </tr>
        </tbody>
    </table>
</div>