<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>User Locked Log</h3>
<div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
    <h3>Username : <b>{{UserId}}</b></h3>
</div>
<div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
    <h3>Full Name : <b>{{FullName | uppercase}}</b></h3>
</div>
<div class="common-btn">
    <ul class="list-inline text-right">
        <li> <button ng-click="Back();" class="btn"><i class="glyphicon glyphicon-circle-arrow-left"></i> Back</button></li>
    </ul>
</div>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>User Locked Date</th>
                <th>User UnLocked Date</th>
                <th>Unlock By</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in userLockLogs |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                <td>{{x.UserLockedDate.replace('/Date(','').replace(')/','') | date:'dd-MMM-yyyy HH:mm:ss'}}</td>
                <td>{{x.UserUnLockedDate.replace('/Date(','').replace(')/','') | date:'dd-MMM-yyyy HH:mm:ss'}}</td>
                <td>{{x.UnlockBy}}</td>
            </tr>
        </tbody>
    </table>
</div>
<dir-pagination-controls max-size="10"
                         direction-links="true"
                         boundary-links="true"
                         on-page-change="getData(newPageNumber)">
</dir-pagination-controls>