<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>User Reset Password</h3>
<div class="form-element-ctrl form-horizontal" name="userResetForm" ng-form>
    <fieldset class="col-xs-12 col-sm-7 col-md-7 scheduler-border">
        <div class="col-xs-12 col-sm-12 col-md-12" style="padding-top:18px;">
            <input type="hidden" ng-model="user.UserId">
            <div class="form-group">
                <label class="col-sm-4 control-label">Username</label>
                <div class="col-sm-8">
                    <input type="text" name="User id" ng-model="user.UserId" readonly class="form-control" required tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">New Password<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="password" name="Password" ng-model="user.Password" class="form-control" id="pwd" required tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">New Confirmed Password<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="password" name="Confirm Password" ng-model="user.ConfirmPassword" class="form-control" id="Conpwd" required tabindex="3">
                    <p class="msg-error" ng-show="user.ConfirmPassword != user.Password">These passwords don't match. Try again?</p>
                </div>
            </div>
        </div>
    </fieldset>
</div>
<div class="common-btn">
    <ul class="list-inline text-right">
        <li><button class="btn" ng-click="Save();"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
        <li><button ng-click="Back();" class="btn"><i class="glyphicon glyphicon-arrow-left"></i> Back</button></li>
    </ul>
</div>