<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>User Authentication Token Change</h3>
<div class="form-element-ctrl form-horizontal" ng-form id="userAuth" name="userAuthForm">
    <fieldset class="col-xs-12 col-sm-7 col-md-7 scheduler-border">
        <div class="col-xs-12 col-sm-12 col-md-12" style="padding-top:18px;">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Username</label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User id" ng-model="user.UserId" readonly class="form-control" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Full Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Full name" ng-model="user.FullName" class="form-control" required readonly tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Authentication Token<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Authentication token" ng-model="user.AuthToken" class="form-control" id="Conpwd" required tabindex="2">
                </div>
            </div>
        </div>
    </fieldset>
</div>
<div class="common-btn">
    <ul class="list-inline text-right">
        <li><button class="btn" ng-click="Save();"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
        <li><button ng-click="Back();" class="btn"><i class="glyphicon glyphicon-arrow-left"></i> Back</button></li>
    </ul>
</div>