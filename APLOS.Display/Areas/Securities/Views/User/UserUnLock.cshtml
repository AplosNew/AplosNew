<togglable name="User Locked"></togglable>
<div class="form-elements" ng-form name="UserUnLockForm">
    <input type="hidden" ng-model="user.Id">
    <input type="hidden" ng-model="user.UserId">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Username</label>
            <div class="col-sm-8">
                <label class="col-sm-8 control-label">:  {{user.UserId}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Full Name</label>
            <div class="col-sm-8">
                <label class="col-sm-8 control-label">:  {{user.FullName}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Power User</label>
            <div class="col-sm-8">
                <label class="col-sm-8 control-label">:  {{user.PowerUser?'Yes':''}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Last Lock Time</label>
            <div class="col-sm-8">
                <label class="col-sm-8 control-label">:  {{user.UserLockedDate.replace('/Date(','').replace(')/','') | date:'dd-MMM-yyyy HH:mm:ss'}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Total Auth Lock Time</label>
            <div class="col-sm-8">
                <label class="col-sm-8 control-label">:  {{user.TotalUserLockTime}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Total Password Fail Count</label>
            <div class="col-sm-8">
                <label class="col-sm-8 control-label">:  {{user.PasswordFailCount}}</label>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li>
                <button ng-click="passValue(user.Id, $index)" data-toggle="modal" data-target="#archivePopUp" class="btn">
                    <i class="glyphicon glyphicon-lock"></i> {{Action}}
                </button>
            </li>
            <li> <a href="#user-lock-log/{{user.Id}}" class="btn"> Log</a></li>
        </ul>
    </div>
</div>
<div class="row text-right">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Auth Token</th>
                <th>Power User</th>
                <th>User Locked</th>
                <th>User Locked Date</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in users |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-click="Get(x.Id, $index);">
                <td>{{x.UserId}}</td>
                <td>{{x.FullName}}</td>
                <td>{{x.AuthToken}}</td>
                <td>{{x.PowerUser?'Yes':'No'}}</td>
                <td>{{x.UserLocked?'Locked':'UnLocked'}}</td>
                <td>{{x.UserLockedDate.replace('/Date(','').replace(')/','') | date:'dd-MMM-yyyy HH:mm:ss'}}</td>
            </tr>
        </tbody>
    </table>
</div>
<dir-pagination-controls max-size="10"
                         direction-links="true"
                         boundary-links="true"
                         on-page-change="getData(newPageNumber)">
</dir-pagination-controls>
<confirm-archive message="Are you sure want to unlock this" body="{{user.UserId}}" data-ng-click-right-button="userUnLock()"></confirm-archive>