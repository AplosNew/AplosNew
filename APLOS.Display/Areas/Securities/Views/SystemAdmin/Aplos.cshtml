<togglable name="System Admin"></togglable>
<div class="form-elements" ng-form id="systemAdminNew" name="systemAdminNewForm">
    <input type="hidden" ng-model="systemAdminNew.UserId">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Username<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User" ng-model="systemAdminNew.UserId" ng-readonly="inactive" class="form-control" required placeholder="jhon" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Date Of Birth<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" autocomplete="off" required name="Date Of Birth" ng-model="systemAdminNew.DateOfBirth" placeholder="dd-MMM-yyyy" datepicker class="form-control datepicker" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors ng-show="passwordShow">
            <label class="col-sm-4 control-label">Password<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input name="Password" type="password" ng-model="systemAdminNew.Password" class="form-control"
                       ng-keyup="compare(systemAdminNew.Password, systemAdminNew.ConfirmPassword)" id="pwd" required tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Company Group<sup>*</sup></label>
            <div class="col-sm-4 col-md-8 show-message">
                <div class="select-style">
                    <select required name="CompanyGroup" class="form-control" ng-model="systemAdminNew.CompanyGroupId" id="groupId"
                            ng-options="item.Value as item.Text for item in companyGroupList" tabindex="7"></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Phone</label>
            <div class="col-sm-8">
                <input type="text" ng-model="systemAdminNew.Phone" class="form-control" tabindex="9">
            </div>
        </div>
        <div class="form-group">
            <label style="white-space: normal;" class="col-sm-4 control-label">Password Change On First Login</label>
            <div class="checkbox-site">
                <label>
                    <input type="checkbox" ng-model="systemAdminNew.PasswordChangeOnFirstLogin" tabindex="11">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Password Never Expired</label>
            <div class="checkbox-site">
                <label>
                    <input type="checkbox" ng-model="systemAdminNew.PasswordNeverExpired" tabindex="13">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Full Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Full Name" ng-model="systemAdminNew.FullName" class="form-control" required placeholder="Mr. Jhon" tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Email<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="email" name="Email" ng-model="systemAdminNew.Email" class="form-control" required placeholder="example@mail.com" tabindex="4">
            </div>
        </div>
        <div class="form-group" ng-show="passwordShow" show-errors>
            <label class="col-sm-4 control-label">Confirm Password<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="password" name="Confirm Password" ng-model="systemAdminNew.ConfirmPassword" class="form-control" id="Conpwd"
                       ng-keyup="compare(systemAdminNew.Password, systemAdminNew.ConfirmPassword)" required tabindex="6">
                <p class="msg-error" ng-show="compareTo">These passwords don't match. Try again?</p>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Authentication Token<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" ng-model="systemAdminNew.AuthToken" class="form-control" required readonly tabindex="8">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="coalevel1.Remarks" tabindex="12"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="checkbox-site">
                <label>
                    <input type="checkbox" ng-model="systemAdminNew.Active">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="110"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Group Id</th>
                <th>Company Group</th>
                <th>Auth Token</th>
                <th>Id</th>
                <th class="text-right">Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in systemAdmins | itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.UserId}}</td>
                <td>{{x.FullName}}</td>
                <td>{{x.CompanyGroupId}}</td>
                <td>{{x.CompanyGroupName}}</td>
                <td>{{x.AuthToken}}</td>
                <td>{{x.Id}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li><a href="{{bootPoint}}system-admin-reset/{{x.Id}}" class="btn btn-action tooltip-here" data-toggle="tooltip" data-placement="top" title="Password Reset" tooltip><i class="glyphicon glyphicon-pencil"></i> Reset</a></li>
                        <li><a href="{{bootPoint}}system-admin-authtoken/{{x.Id}}" class="btn btn-action tooltip-here" data-toggle="tooltip" data-placement="top" title="Change Authentication" tooltip>Change Auth</a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>