<div class="row" style="height:{{dataHeight}}px;">
    <div class="col-sm-2 text-center"  style="height: {{DataRowHeight}}px;" ng-repeat="x in productionData">
        <table style="height:90%">
            <tr style="width:100%;height:40%">
                <td style="font-size: 5vw; font-weight: bolder; background-color: chocolate; color: white;">{{x.hour}}</td>
            </tr>
            <tr style="width:100%;height:60%">
                <td style="font-size: 7vw; font-weight: bolder; background-color: darkgreen; color: white;">{{x.quantity}}</td>
            </tr>
        </table>
     
    </div>
</div>
<div class="row" style="height:{{FooterRowHeight}}px;">
    <div class="col-sm-2 text-center" style="height: {{FooterRowHeight}}px;">
        <table style="height:90%">
            <tr style="width:100%;height:40%">
                <td style="font-size: 5vw; font-weight: bolder; background-color: chocolate; color: white;">DAY TGT/HR</td>
            </tr>
            <tr style="width:100%;height:60%">
                <td style="font-size: 7vw; font-weight: bolder; background-color: darkgreen; color: white;">120</td>
            </tr>
        </table>

    </div>
    <div class="col-sm-2 text-center" style="height: {{FooterRowHeight}}px;">
        <table style="height:90%">
            <tr style="width:100%;height:40%">
                <td style="font-size: 5vw; font-weight: bolder; background-color: chocolate; color: white;">PRD/HR</td>
            </tr>
            <tr style="width:100%;height:60%">
                <td style="font-size: 7vw; font-weight: bolder; background-color: darkgreen; color: white;">30</td>
            </tr>
        </table>

    </div>
    <div class="col-sm-2 text-center" style="height: {{FooterRowHeight}}px;">
        <table style="height:90%">
            <tr style="width:100%;height:40%">
                <td style="font-size: 5vw; font-weight: bolder; background-color: chocolate; color: white;">TGT/HR</td>
            </tr>
            <tr style="width:100%;height:60%">
                <td style="font-size: 7vw; font-weight: bolder; background-color: darkgreen; color: white;">60</td>
            </tr>
        </table>

    </div>
</div>