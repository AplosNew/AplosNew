            width: 200px;
            visibility: hidden;
            background-color: lightgoldenrodyellow;
            border: 1px solid #ffd002;
            color: #000;
            text-align: center;
            border-radius: 2px;
            padding: 5px 0;
            position: absolute;
            z-index: 11111111;
            top: -5px;
            right: 110%;
        }

            .tooltipAplos .tooltipAplostext::after {
