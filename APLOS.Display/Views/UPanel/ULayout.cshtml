<!DOCTYPE html>
<html lang="en" ng-app="upanelApp" spellcheck="true">
<head>
    <link href="~/SyncfusionLib/css/web/default-theme/ej.web.all.min.css" rel="stylesheet" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta charset="utf-8" />
    <base href="@ViewBag.BasePath">
    <title>{{title}}</title>
    <link rel="shortcut icon" href="images/title.gif" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
    @Scripts.Render("~/bundles/jq")
    @Scripts.Render("~/bundles/angular")
    @Scripts.Render("~/bundles/syncfusion")

    @Scripts.Render("~/bundles/ie")
    @Scripts.Render("~/bundles/securities")
    @Scripts.Render("~/bundles/upanel")
</head>
<body panel-body style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">

    <div id="iframe_div_for_report" style="display:none"></div>

    <nav class="row navbar navbar-default navbar-fixed-top navbar-site" id="templateHeader" style="z-index:881;">
        <div class="container-fluid">

            <div class="navbar-collapse collapse" id="navbar">
                <div class="col-md-12 col-md-8 col-md-8">
                    <ul class="nav navbar-nav">

                        <li style="font-size:2em;font-weight:bolder;"><strong></strong> {{PlantName}}</li>
                        <li style="font-size:2em; font-weight: bolder;"><strong></strong> {{FormName}}</li>
                        <li></li>
                    </ul>
                </div>
                <div class="col-md-12 col-md-4 col-md-4 text-right text-nowrap">
                    <ul class="nav navbar-nav">
                        <li class="text-right" style="font-size: 2em; font-weight: bolder; position: fixed; float: right;"><strong><span id="datetimedisplay"></span></strong> </li>
                    </ul>
                </div>
            </div>


        </div>
    </nav>


    <div class="container-fluid" id="main">
        <div class="row">
            <div class="inner-content" style="margin:0px;">
                <div style="padding: 0px; position: relative; float:left; top: -40px;"><span ng-bind-html="FormIcon"></span></div>
                <div ng-view>
                </div>

            </div>
        </div>
    </div>

    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>
    <noscript>
        JavaScript is disable in your browser. Please enable from browser settings.
    </noscript>
</body>

</html>

<style>
    .tooltipAplos {
