<div class="login-portal">
    <a class="download-btn" href="download-authtoken"><i aria-hidden="true" class="glyphicon glyphicon-cloud-download"></i> Download</a>
    <div class="login-portal-inner">
        <div class="container">
            <div class="company-name">
                <img class="logo" src="{{companyGroupLogo}}">
                <p>{{companyGroupName}}</p>
            </div>
            <p id="error" style="margin-top: -6%;font-size: 30px;text-align: center;color:red;">@ViewBag.InvalidPanel</p>
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <a class="next-arrow" href="EP/{{authenticationToken}}/{{companyGroupId}}">
                        <i class="glyphicon glyphicon-menu-right"></i>
                    </a>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="widget-btn">
                            <a href="apanel/{{authenticationToken}}/{{companyGroupId}}">
                                <i aria-hidden="true" class="glyphicon glyphicon-send"></i> Administration
                            </a>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="widget-btn">
                            <a href="mpanel/{{authenticationToken}}/{{companyGroupId}}">
                                <i aria-hidden="true" class="glyphicon glyphicon-flash"></i> Master
                            </a>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="widget-btn">
                            <a href="upanel/{{authenticationToken}}/{{companyGroupId}}">
                                <i aria-hidden="true" class="glyphicon glyphicon-signal"></i> Application
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>
</div>