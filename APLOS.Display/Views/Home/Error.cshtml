<!DOCTYPE html>
<html spellcheck="true">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta charset="utf-8" />
    <base href="/">
    <title>Error</title>
    <link rel="shortcut icon" href="images/title.gif" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
</head>
<body class="login-bg">
    <noscript>
        JavaScript is disable in your browser. Please enable from browser settings.
    </noscript>
    <div class="login-portal">
        <a class="download-btn" href="/Download/AuthToken"><i aria-hidden="true" class="glyphicon glyphicon-save"></i> Download</a>
        <div class="login-portal-inner">
            <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-sm-4 col-md-8 col-md-offset-2">
                        <div class="widget-btn">
                            <p><i aria-hidden="true" class="glyphicon glyphicon-warning-sign"></i> @ViewBag.Error </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>