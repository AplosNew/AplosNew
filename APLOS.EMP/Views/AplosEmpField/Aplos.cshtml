<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Field<label style="float:right"></label>
</h3>
<div class="form-elements form-horizontal" ng-form name="testingCategoryNewForm">
    <input type="hidden" ng-model="testingCategoryNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Interface Field Id</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="InterfaceId Field" ng-model="AplosEmpField.InterfaceIdField" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Interface Field Name</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="InterfaceId Field" ng-model="AplosEmpField.InterfaceFieldName" class="form-control" required tabindex="3">
            </div>
        </div>
       
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Aplos ColumnId</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="AplosEmpField.AplosColumnId" class="form-control" required tabindex="2" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Aplos ColumnName</label>
            <div class="col-sm-8">
                <input type="text" name="User Name" ng-model="AplosEmpField.AplosColumnName" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="AplosEmpField.Active" tabindex="5">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="6"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button ng-click="Delete();" class="btn" tabindex="7"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="8"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="table-responsive modal-table aplos-grid-toggle">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>InterfaceIdField</th>
                    <th>InterfaceFieldName</th>
                    <th>AplosColumnId</th>
                    <th>AplosColumnName</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in employeeFields" ng-dblclick="getData(x)">
                    <td>{{x.InterfaceIdField}}</td>
                    <td>{{x.InterfaceFieldName}}</td>
                    <td>{{x.AplosColumnId}}</td>
                    <td>{{x.AplosColumnName}}</td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

