@{
    ViewBag.Title = "Aplos";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" ng-app="aplosEmpApp" spellcheck="true">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta charset="utf-8" />
    <title>Pin Change</title>
    <link rel="shortcut icon" href="~/images/title.gif" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
    @Scripts.Render("~/bundles/jq")
    @Scripts.Render("~/bundles/angular")
    @Scripts.Render("~/bundles/aplosemp")
    @Scripts.Render("~/bundles/apps")
</head>
<body class="login-bg" ng-controller="@ViewBag.ControllerName">
    <div class="login-content" ng-form name="">
        <div class="company-name company-name-login">
            <img class="logo" src="~/images/{{logoFileName}}" alt="Logo">
            <p>{{groupName}}</p>
        </div>
        <form class="login-inner" autocomplete="off">
            <p id="error" class="login-error" ng-hide="errorHide">{{errorText}}</p>
            <h4>Please change your pin</h4>
            <div class="form-group" show-errors>
                <div class="input-group show-message">
                    <span class="input-group-addon"><span class="glyphicon glyphicon-lock"></span></span>
                    <input tabindex="1" type="password" ng-enter="PinChange()" class="form-control" ng-model="employee.NewPIN" placeholder="Enter New PIN" name="NewPIN" id="NewPIN" required autofocus />
                </div>
            </div>
            <div class="checkbox"></div>
            <button tabindex="2" type="button" class="btn btn-default pull-right" ng-click="PinChange()"><span class="glyphicon glyphicon-log-in"></span> PIN Change</button>
        </form>
    </div>
    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>
</body>
</html>
