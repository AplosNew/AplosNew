@{
    ViewBag.Title = "Aplos";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}
<h3 class="site-heading" ng-show="employee.Id !=0 && employee.IsFirstlogin !=false && employee.NewPIN !=null">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> My Information
</h3>
<style>
    /****************File Upload*/
    * {
        box-sizing: border-box;
        -moz-box-sizing: border-box;
        -webkit-box-sizing: border-box;
    }

    .inputBtnSection {
        /*display: inline-block;*/
        vertical-align: top;
        font-size: 0;
        font-family: verdana;
    }

    .disableInputField {
        /*display: inline-block;*/
        vertical-align: top;
        height: 27px;
        margin: 0;
        font-size: 14px;
        padding: 0 3px;
    }

    .fileUpload {
        position: relative;
        overflow: hidden;
        /*border: solid 1px gray;*/
        display: inline-block;
        vertical-align: top;
    }

    .uploadBtn {
        display: inline-block;
        vertical-align: top;
        background: #242841;
        font-size: 14px;
        padding: 0 10px;
        height: 25px;
        line-height: 22px;
        color: #fff;
    }

    .fileUpload input.upload {
        position: absolute;
        top: 0;
        right: 0;
        margin: 0;
        padding: 0;
        font-size: 20px;
        cursor: pointer;
        opacity: 0;
        filter: alpha(opacity=0);
    }
</style>
<div class="form-elements form-horizontal" ng-form name="employeeForm" ng-show="employee.Id !=0 && employee.IsFirstlogin !=false && employee.NewPIN !=null">
    <input type="hidden" ng-model="employee.Id">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General Info</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="preRecruite" role="tab" data-toggle="tab">Activity Info</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="jd" role="tab" data-toggle="tab">Document Info</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="kpi" role="tab" data-toggle="tab">KPI Info</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" aria-controls="advance" role="tab" data-toggle="tab">Advance Info</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="generalForm">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" name="Code" ng-model="employee.Code" class="form-control" maxlength="50" tabindex="20" disabled>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">First Name<sup>*</sup></label>
                            <div class="col-sm-2" style="padding-right:0px;">
                                <div class="select-style">
                                    <select id="SalutationId" class="form-control" name="Salutation" ng-model="employee.SalutationId" tabindex="21">
                                        <option ng-repeat="option in salutaionList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-6" style="padding-left:0px;">
                                <input type="text" name="First Name" ng-model="employee.FirstName" class="form-control" maxlength="50" placeholder="First Name" tabindex="22">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Father Name</label>
                            <div class="col-sm-8">
                                <input type="text" name="Father Name" ng-model="employee.FatherName" class="form-control" maxlength="50" placeholder="Father Name" tabindex="24">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Email</label>
                            <div class="col-sm-8">
                                <input type="text" name="Email" ng-model="employee.Email" class="form-control" maxlength="50" placeholder="Email Id" tabindex="26" disabled>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Birthday Celebration Date<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="employee.BirthdayCelebrationDate" datepicker class="form-control datepicker" placeholder="dd-MM-yyyy" tabindex="10">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Reporting Officer</label>
                            <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                                <span class="input-group-addon">{{employee.ReportingOfficerId}}</span>
                                <input type="text" ng-model="employee.ReportingOfficerName" placeholder="Reporting Officer Name" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="getEmployeeData()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="clearEmployeeCode()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                        @*<div class="form-group">
                                <label class="col-sm-4 control-label">Reporting Officer</label>
                                <div class="col-sm-2" style="padding-right:0px;">
                                    <input type="text" ng-model="employee.ReportingOfficerId" placeholder="Id" class="form-control" readonly>
                                </div>
                                <div class="col-sm-4" style="padding-left:0px;padding-right:0px;">
                                    <input type="text" ng-model="employee.ReportingOfficerName" placeholder="Reporting Officer Name" class="form-control" readonly>
                                </div>
                                <div class="col-sm-2" style="padding-left:0px;margin-left: 0px;">
                                    <button style="margin-left:0px;" ng-click="clearEmployeeCode();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-refresh"></i></button>
                                    <button style="margin-left:-3px;" ng-click="getEmployeeData();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                                </div>
                            </div>*@
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Full Name</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" ng-model="employee.Name" tabindex="4" disabled>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Last Name<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" name="Last Name" ng-model="employee.LastName" class="form-control" placeholder="Last Name" maxlength="50" tabindex="23">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Mother Name</label>
                            <div class="col-sm-8">
                                <input type="text" name="Mother Name" ng-model="employee.MotherName" class="form-control" placeholder="Mother Name" maxlength="50" tabindex="25">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Mobile<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" name="Mobile" ng-model="employee.Mobile" class="form-control" maxlength="50" placeholder="Mobile No" tabindex="27">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Date Of Join</label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="employee.DOJ" datepicker class="form-control datepicker" placeholder="dd-MM-yyyy" tabindex="10" disabled>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn" style="padding-right:18px">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="GetIndividualInfo();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> View </button></li>
                        <li> <button ng-click="Save();" ng-disabled="disableBtn();savebtndisable" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    </ul>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="activityForm">
                    <input type="hidden" ng-model="activityNew.Id" />
                    <input type="hidden" ng-model="activityNew.EmployeeId" />
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" name="Name" ng-model="activityNew.Name" class="form-control" maxlength="50" placeholder="Activity" tabindex="31">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity Category<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="ActivityCategoryId" ng-change="checkActivityCategory()" class="form-control" name="Activity Category" ng-model="activityNew.ActivityCategoryId" tabindex="33">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in activityCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="otherActivityCategory">
                            <label class="col-sm-4 control-label"></label>
                            <div class="col-sm-8">
                                <input type="text" maxlength="200" name="Other Activity Category" ng-model="activityNew.OtherActivityCategory" placeholder="Other Activity Category" class="form-control" tabindex="33">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Period<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="PeriodId" class="form-control" name="Period" ng-model="activityNew.PeriodId" tabindex="35">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in periodList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Average Time (Min)<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="number" name="AverageTime" ng-model="activityNew.AverageTime" placeholder="Average Time (Min)" class="form-control" tabindex="37">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="activityNew.Remarks" name="Remarks" maxlength="200" placeholder="Remarks" tabindex="39"></textarea>
                            </div>
                        </div>
                        <div class="form-group" ng-show="hidediv">
                            <label class="col-sm-4 control-label">KPI</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="activityNew.KPI">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="hidediv">
                            <label class="col-sm-4 control-label">Documents</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="activityNew.Documents">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity Detail<sup>*</sup></label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="activityNew.ActivityDetail" name="Activity Detail" maxlength="500" placeholder="Activity Detail" tabindex="32"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity Importance<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="ActivityImportanceId" class="form-control" name="Activity Importance" ng-model="activityNew.ActivityImportanceId" tabindex="34">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in activityImportanceList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Frequency<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="number" name="Frequency" ng-model="activityNew.Frequency" placeholder="Frequency" class="form-control" tabindex="36">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label" title="Do You Find Value In This Activity">Find Value in this Activity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Value In Activity" ng-model="activityNew.ValueInActivity" class="form-control" tabindex="38">
                                        <option value="">--Select--</option>
                                        <option value="Yes">Yes</option>
                                        <option value="No">No</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Purpose of the activity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="activityNew.PurposeOfTheActivity" name="PurposeOfTheActivity" maxlength="200" placeholder="Purpose Of The Activity" tabindex="40"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Has Financial Impact</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="activityNew.FinancialImpact" tabindex="10">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveActivity();" ng-disabled="disableBtn();savebtndisable" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{ActivityAction}}</button></li>
                            <li> <button ng-click="clearactivity();" ng-disabled="disableBtn()" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Activity</th>
                                        <th>Activity Detail</th>
                                        <th>Documents</th>
                                        <th>KPI</th>
                                        <th class="col-md-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="x in activityDataList |itemsPerPage:activityDataParameters.pageSize" total-items="activityDataParameters.total_count">
                                        <td>{{x.Name}}</td>
                                        <td>{{x.ActivityDetail}}</td>
                                        <td>{{x.Documents?'Yes':'No'}}</td>
                                        <td>{{x.KPI?'Yes':'No'}}</td>
                                        <td class="text-center table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="activityEdit(x, $index)" ng-disabled="disableBtn()" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                        <i class="glyphicon glyphicon-edit"></i>
                                                    </button>
                                                </li>
                                                <li>
                                                    <button ng-click="activityDelete(x, $index)" ng-disabled="disableBtn()" class="btn btn-action tooltip-here" data-placement="top" title="Delete">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <dir-pagination-controls max-size="50"
                                                     direction-links="true"
                                                     boundary-links="true"
                                                     on-page-change="activityData(newPageNumber)">
                            </dir-pagination-controls>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row" ng-form name="documentForm">
                    <input type="hidden" ng-model="documentActivityNew.Id" />
                    <div class="col-xs-6 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="ActivityId" class="form-control" name="Activity" ng-model="documentActivityNew.ActivityId" tabindex="41" ng-change="documentData()">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in activitydocumentList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="documentActivityNew.Name" name="Description" placeholder="Description" maxlength="200" tabindex="43"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Application Name</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="documentActivityNew.ApplicationName" name="Name" placeholder="Application Name" maxlength="200" tabindex="45"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="documentActivityNew.Remarks" name="Remarks" placeholder="Remarks" maxlength="200" tabindex="47"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Document Format<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="DocumentFormateId" class="form-control" name="Document Formate" ng-model="documentActivityNew.DocumentFormateId" tabindex="42">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in documentFormateList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Data Source Category<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="DataSourceCategoryId" class="form-control" name="Data Source Category" ng-model="documentActivityNew.DataSourceCategoryId" tabindex="44">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in dataSourceCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Prepared by<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="PreparedById" name="Prepared By" ng-model="documentActivityNew.PreparedBy" ng-change="preparedbyOther()" class="form-control" tabindex="46">
                                        <option value="">--Select--</option>
                                        <option value="Self">Self</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        @*<div class="form-group" ng-show="preparebyOther">
                                <label class="col-sm-4 control-label" title="Prepared by in Case of other"><span>Prepared by in case of</span><br /><span>other</span></label>
                                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                                    <input type="text" name="Prepared By InCase Of Other" ng-model="documentActivityNew.PreparedByInCaseOfOtherName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="getPreparedData()" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="clearPreparedByCode()" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                            </div>*@
                        <div class="form-group" ng-show="preparebyOther">
                            <label class="col-sm-4 control-label" title="Prepared by in Case of other"><span>Prepared by in case of</span><br /><span>other</span></label>
                            <div class="col-sm-2" style="padding-right:0px;">
                                <input type="text" ng-model="documentActivityNew.PreparedByInCaseOfOther" placeholder="Id" class="form-control" tabindex="8" readonly>
                            </div>
                            <div class="col-sm-4" style="padding-left:0px;padding-right:0px;">
                                <input type="text" name="Name" ng-model="documentActivityNew.PreparedByInCaseOfOtherName" placeholder="Prepared by In CaseOf Other" class="form-control" readonly>
                            </div>
                            <div class="col-sm-2" style="padding-left:0px;margin-left: 0px;">
                                <button style="margin-left:0px;" ng-click="clearPreparedByCode();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-refresh"></i></button>
                                <button style="margin-left:-3px;" ng-click="getPreparedData();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="inputBtnSection common-btn">
                                <label class="fileUpload col-sm-4 ">
                                    <input id="uploadBtn" type="file" name="file[]" class="upload" />
                                    <span class="uploadBtn"><i class="fa fa-paperclip" aria-hidden="true"> Attach</i></span>
                                </label>
                                <div class="col-sm-6" style="width: 255px;">
                                    <input type="text" id="uploadFile" name="uploadFile" class="disableInputField form-control" disabled="disabled" style="width: 239px;" />
                                </div>
                                <div class="col-sm-2" style="padding-left:0px;">
                                    <button ng-click="documentRemove();" class="btn" ng-disabled="disableBtn()" style="height: 31px;width: 88px;padding-left: 8px;background: #242841;"><i class="fa fa-chain-broken" aria-hidden="true"></i> Detach</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn" style="padding-right:18px">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="UpdateDocument();" class="btn" ng-disabled="disableBtn();savebtndisable" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{DocumentAction}}</button></li>
                            <li> <button ng-click="cleardocumentActivitybody();" class="btn" ng-disabled="disableBtn()" tabindex="9"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
