    <button class="btn" id="Cbtn1_3" style="cursor:pointer;background-color:#242841; color:white; margin-top:4%;">1</button>
    <button class="btn" id="Cbtn2_3" style="cursor:pointer;background-color:#242841; color:white;margin-top:4%;">2</button>
