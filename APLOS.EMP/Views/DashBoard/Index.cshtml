@{
    ViewBag.Title = "Chart";
    Layout = "~/Views/Shared/_EmployeeAccessLayout.cshtml";
}
<style>
    .chart-title {
        position: absolute;
        left: 0;
        right: 0;
        margin: 0 auto;
        top: 40%;
        transform: translateY(-50%);
        width: 75%;
        text-align: center;
        font-size: 13px;
    }

    .groupChart {
        margin-right: auto;
    }

    .vertical-scrolling {
        position: relative;
        height: 450px;
        width: 75%;
        overflow: scroll;
    }

        .vertical-scrolling table {
            content: 'super';
            position: relative;
            height: auto;
        }

    #wizard-container ul li {
        display: inline;
    }

        #wizard-container ul li a {
            display: block;
            font-size: 12px;
            font-family: 'open Sans';
            float: left;
            height: 40px;
            background: #242841;
            text-align: center;
            padding: 2px 10px 0 31px;
            position: relative;
            margin: 0 10px 10px 0;
            text-decoration: none;
            color: #fff;
            display: inline-block;
        }

            #wizard-container ul li a:after {
                content: "";
                border-top: 20px solid transparent;
                border-bottom: 20px solid transparent;
                border-left: 20px solid #242841;
                position: absolute;
                right: -20px;
                top: 0;
                z-index: 1;
            }

            #wizard-container ul li a:before {
                content: "";
                position: absolute;
                border-top: 20px solid transparent;
                border-bottom: 20px solid transparent;
                border-left: 20px solid #FFFFFF;
                left: 0;
                top: 0;
            }

        #wizard-container ul li:first-child a:before {
            display: none;
        }

    .table-fixed tbody {
        height: 230px;
        overflow-y: auto;
        width: 100%;
    }

    .table-fixed thead, table-fixed tbody {
        display: block;
    }
</style>

<div class="container" id="headerNav">
    <div id="wizard-container">
        <ul style="cursor:pointer; margin-bottom:-22px;">
            <li ng-repeat="x in ColList" ng-click="headerNav(x)" ng-show="x.Sequence < index">
                <a href="#">
                    <b>{{x.AplosColumnName}}</b><br />{{x.Text}}
                </a>
            </li>
        </ul>
    </div>
</div>
<br />
<br />
<div class="row" id="summaryPie" style="max-width:1108px; background-color:white; margin-top:-5%">
    <br />
    <br />
    <div class="col-lg-4">
        <div class="row">
            <div class="col-lg-12">
                <label class="chart-title">Total Employee <br><span>{{CmpTotalEmp}}</span></label>
                <canvas id="myChart" width="400" height="400"></canvas>
            </div>
            <div class="col-lg-12 table-responsive modal-table">
                <table class="table table-bordered table-hover table-striped">
                    <thead><tr><th colspan="2">Employee Logged in and Submitted  status</th></tr></thead>
                    <tbody style="cursor:pointer;">
                        <tr ng-click="sNLEData()">
                            <td>Not LoggedIn Employees</td>
                            <td style="text-align:right">{{CmpNotLEmp}}</td>
                        </tr>
                        <tr ng-click="sSEData()">
                            <td>Submitted Employees</td>
                            <td style="text-align:right">{{CmpSubmitted}}</td>
                        </tr>
                        <tr ng-click="sNSEData()">
                            <td>Not Submitted Employees</td>
                            <td style="text-align:right">{{CmpNotSubmitted}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-1"></div>
    <div class="col-lg-7">
        <div class="modal-table" style="margin-left:0%; overflow-y:scroll; max-height:375px; max-width:100%;">
            <table class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th>{{ColList[index+2].AplosColumnName}}</th>
                        <th>Total Employee</th>
                        <th>Not Logged In</th>
                        <th>Submitted</th>
                        <th>Not Submitted</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in list" id="tcompany">
                        <td style="cursor:pointer;" ng-click="setIndex(x);GetCompanyWisePList('',x);">{{x.UserName}}</td>
                        <td style="text-align:right">{{x.totalEmployee}}</td>
                        <td style="cursor:pointer; text-align:right" ng-click="NLEData(x)">{{x.NotLoggedIn}}</td>
                        <td style="cursor:pointer; text-align:right" ng-click="SEData(x)">{{x.Submitted}}</td>
                        <td style="cursor:pointer; text-align:right" ng-click="NSEData(x)">{{x.NotSubmitted}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="row" style=" margin-top:-2%;" id="navigMamun">
    <div class="container" style="margin-left:35%;  position:relative;">
        <button class="btn" id="Cbtn1_1" style="cursor:pointer;background-color:#bdc3c7; color:white; margin-left:0px;">1</button>
        <button class="btn" id="Cbtn2_1" style="cursor:pointer;background-color:#242841; color:white;" ng-click="summaryLineChart();totalActivity();totalFirstLoggedIn();dayWiseSubmit();totalDocument()">2&nbsp;</button>
        <button class="btn" id="Cbtn3_1" style="cursor:pointer;background-color:#242841; color:white;" ng-click="summaryLineChart();totalActivity();totalFirstLoggedIn();dayWiseSubmit();totalDocument()">3</button>&nbsp;&nbsp;&nbsp;
        <button class="btn" style="cursor:pointer; background-color:#242841; color:white;" id="forward1" ng-click="summaryLineChart();totalActivity();totalFirstLoggedIn();dayWiseSubmit();totalDocument()"> Next&nbsp; <i class="fa fa-angle-double-right" aria-hidden="true"></i></button>
    </div>
</div>
