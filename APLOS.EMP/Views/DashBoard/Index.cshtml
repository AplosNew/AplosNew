<div id="stNLIEModal" class="modal fade site-modal in" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-left:115px;" onload="AutoRefresh(120000);">
    <div class="modal-dialog" style="width:1250px;">
        <div class="modal-content" style="width:1250px; ">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">×</button>
                <h4 class="modal-title" id="myModalLabel">List of Not Logged In Employees</h4>
            </div>
            <div class="modal-body table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>SL</th>
                            <th ng-repeat="x in ColList" ng-click="headerNav(x)" ng-show="x.Sequence >-2">
                                {{x.AplosColumnName}}
                            </th>
                            <th>EmpCode</th>
                            <th>Employee Name</th>
                            <th>Activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in sNLEList">
                            <td>{{$index +1}}</td>
                            <td>{{x.CompanyName}}</td>
                            <td ng-repeat="y in ColList" ng-show="y.Sequence > -1">
                                {{x[y.ColumnName]}}
                            </td>
                            <td>{{x.EmpCode}}</td>
                            <td>{{x.EmpName}}</td>
                            <td>{{x.Activity}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
