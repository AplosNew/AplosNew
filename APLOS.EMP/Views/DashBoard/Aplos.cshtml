
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_EmployeeAccessLayout.cshtml";
}

<style>
    .chart-title {
        position: absolute;
        left: 0;
        right: 0;
        margin: 0 auto;
        top: 40%;
        transform: translateY(-50%);
        width: 75%;
        text-align: center;
        font-size: 13px;
    }

    .groupChart {
        margin-right: auto;
    }

    .vertical-scrolling {
        position: relative;
        height: 448px;
        width: 89%;
        overflow: scroll;
    }

        .vertical-scrolling table {
            content: 'super';
            position: relative;
            height: auto;
        }
</style>

@* -----------------------------------------------*Navigation Tab*----------------------------------------------------------------- *@
<div class="container" data-spy="affix">

    <button type="button" class="btn btn-default btn-sm" id="GroupName">

        <span ng-repeat="x in list">
            <ng-container ng-if="((list.indexOf(x) == 0))">
                <b>Company Group:<br>{{x.GroupName}}</b>
                <!--need to break this loop-->
            </ng-container>
        </span>
    </button>
    <button type="button" class="btn btn-default btn-sm " id="CompanyName">
        <span ng-repeat="x in list">
            <ng-container ng-if="((list.indexOf(x) == 0))">
                <b>Company: <br />{{x.CompanyName}}</b>
                <!--need to break this loop-->
            </ng-container>
        </span>
    </button>
    <button type="button" class="btn btn-default btn-sm " id="PlantName">
        <span class="pName" ng-repeat="x in divList">
            <ng-container ng-if="((divList.indexOf(x) == 0))">
                <b>Entity:<br />{{x.plantName}} </b>
                <!--need to break this loop-->
            </ng-container>
        </span>
    </button>
    <button type="button" class="btn btn-default btn-sm " id="DivisionName">
        <span class="divName" ng-repeat="x in deptList">
            <ng-container ng-if="((deptList.indexOf(x) == 0))">
                <b>Plant:<br /> {{x.division}}</b>
                <!--need to break this loop-->
            </ng-container>
        </span>
    </button>
    <button type="button" class="btn btn-default btn-sm " id="DepartmentName">
        <span class="depName" ng-repeat="x in desigList">
            <ng-container ng-if="((desigList.indexOf(x) == 0))">
                <b>Division: <br />{{x.department}}</b>
                <!--need to break this loop-->
            </ng-container>
        </span>
    </button>
    <button type="button" class="btn btn-default btn-sm " id="DesignationName">
        <span class="depName" ng-repeat="x in catgList">
            <ng-container ng-if="((catgList.indexOf(x) == 0))">
                <b>Sub Division: <br />{{x.designation}}</b>
                <!--need to break this loop-->
            </ng-container>
        </span>
    </button>
    <button type="button" class="btn btn-default btn-sm " id="CategoryName">
        <span class="depName" ng-repeat="x in funcList">
            <ng-container ng-if="((funcList.indexOf(x) == 0))">
                <b>Unit: <br />{{x.category}}</b>
                <!--need to break this loop-->
            </ng-container>
        </span>
    </button>

    <table style="">
        <thead>
            <tr>
                <th ng-repeat="x in ColList" ng-click="headerClick()">
                    {{x.AplosColumnName}}
                </th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@* -------------------------------------------------/\End of Navigation Tab/\----------------------------------------------------------------- *@
<br />
<br />
@* ---------------------------------------------------*Company Group Logged In Details*------------------------------------------------------------- *@
<div class="row" id="company" style="min-height:550px;">
    <br />
    <br />
    @* -----------------------------------------------------------------Company Chart--------------------------------------------------------- *@
    <div class="col-lg-4" data-spy="affix">
        <div class="row">
            <div class="col-lg-10">
                <label class="chart-title">Total Employee <br><span>{{CmpTotalEmp}}</span></label>
                <canvas id="myChart" width="400" height="400"></canvas>
            </div>
            <div class="col-lg-10 table-responsive modal-table">
                <table class="table table-bordered table-hover table-striped">
                    <thead><tr><th colspan="2">Employee Logged in and Submitted  status</th></tr></thead>
                    <tbody style="cursor:pointer;">

                        <tr ng-click="CGNLEData()">
                            <td>Not LoggedIn Employees</td>
                            <td>{{CmpNotLEmp}}</td>
                        </tr>
                        <tr ng-click="CGSEData()">
                            <td>Submitted Employees</td>
                            <td>{{CmpSubmitted}}</td>
                        </tr>
                        <tr ng-click="CGNSEData()">
                            <td>Not Submitted Employees</td>
                            <td>{{CmpNotSubmitted}}</td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>

    </div>
    @* ---------------------------------End of Company chart --------------------------------------------------------------------------------- *@

    @*------------------------------------------ Company wise LoggedIn information------------------------------------------------------------ *@
    <div class="col-lg-8 scrollspy table-responsive modal-table" id="companyTable" style="margin-left:450px;">
        <table class="table table-bordered table-hover table-striped" style="max-width: 89%;">
            <thead>
                <tr>
                    <th>
                        {{getColName(-1)}}
                    </th>
                    <th>
                        NotLoggedIn
                    </th>
                    <th>
                        Submitted
                    </th>
                    <th>
                        Not Submitted
                    </th>
                </tr>
            </thead>
            @*<tbody class="mtbody" style="cursor:pointer;" id="company" ng-click="companyAnimition()"></tbody>*@
            <tbody>
                <tr ng-repeat="x in list" style="cursor:pointer;" id="tcompany">
                    <td ng-click="GetCompanyWisePList(x)"> {{x.UserName}}</td>
                    <td ng-click="GetNotLoggedIn(x)">{{x.NotLoggedIn}}</td>
                    <td>{{x.Submitted}}</td>
                    <td>{{x.NotSubmitted}}</td>
                </tr>
            </tbody>
        </table>
    </div>



    @*------------------------ End of Company Group wise LoggedIn information------------------------------- *@
</div>
