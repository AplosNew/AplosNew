@{
    ViewBag.Title = "Aplos";
    Layout = "~/Views/Shared/_EmployeeAccessLayout.cshtml";
}

<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Admin User Access<label style="float:right"></label>
</h3>
<div class="form-elements form-horizontal row" ng-form name="userAccessForm">
    <input type="hidden" ng-model="userAccessNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee</label>
            <div class="col-sm-8 input-group" style="padding-left:15px;padding-right:15px">
                @*<input type="text" class="form-control" ng-model="userAccessNew.Id" placeholder="Id" readonly>*@
                 <span class="input-group-addon" placeholder="Id">{{userAccessNew.Id}}</span>
                <input type="text" class="form-control" ng-model="userAccessNew.Name" placeholder="Employee Name" readonly>
                <span class="input-group-btn">
                    <button ng-click="getEmployeeData();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Pin</label>
            <div class="col-sm-8">
                <input type="text" name="pin" ng-show="!userAccessNew.IsFirstlogin" ng-model="userAccessNew.InitialPIN" placeholder="PIN" class="form-control" maxlength="50" tabindex="2">
                <input type="text" name="pin" ng-show="userAccessNew.IsFirstlogin" ng-model="userAccessNew.NewPIN" placeholder="PIN" class="form-control" maxlength="50" tabindex="2">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Access User</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="userAccessNew.AccessUser">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <fieldset class="scheduler-border">
            <div class="col-xs-12 col-sm-6 col-md-6" compile="left">
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6" compile="right">
            </div>
        </fieldset>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
            <li> <button ng-click="clearuserAccess();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="modal fade site-modal in" id="employeemodal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchbyEmployeelist|orderBy:'name'" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="loadEmployeeData();">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadEmployeeData();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Code</th>
                                <th>Employee Name</th>
                                <th>Email</th>
                                <th>Mobile</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeData  |itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-dblclick="getuserAccess(x);" pagination-id="metaData.name + 'employeeData'">
                                <td>{{x.Id}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.Name}}</td>
                                <td>{{x.Email}}</td>
                                <td>{{x.Mobile}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'employeeData'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadEmployeeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>



