@{
    ViewBag.Title = "User Access Restriction";
    Layout = "~/Views/Shared/_EmployeeAccessLayout.cshtml";
}
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> User Access Restriction<label style="float:right;cursor:none;"></label></h3>
<div class="form-elements form-horizontal">
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="1"><i class="glyphicon glyphicon-floppy-disk"></i> Save Changes</button></li>
        </ul>
    </div>
</div>
<div class="row text-right">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchbyEmployeelist|orderBy:'name'" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="flag" ng-click="CheckAll($event,employees);" name="Flag">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </th>
                <th>Id</th>
                <th>Code</th>
                <th>Company</th>
                <th>Employee Name</th>
                <th>Email</th>
                <th>Mobile</th>
                <th>Status</th>
                <th>Access Restricted</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in employees |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'employees'">
                <td>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.Flag" ng-click="SelectOrDeselect(x.Id,$event)"name="Flag">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td>{{x.Id}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.CompanyName}}</td>
                <td>{{x.Name}}</td>
                <td>{{x.Email}}</td>
                <td>{{x.Mobile}}</td>
                <td>{{x.Status}}</td>
                <td>{{x.AccessRestricted}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             pagination-id="metaData.name + 'employees'"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>



