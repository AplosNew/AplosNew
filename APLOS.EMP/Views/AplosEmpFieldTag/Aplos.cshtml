<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Field Tag<label style="float:right"></label>
</h3>
<div class="form-elements form-horizontal" ng-form name="testingCategoryNewForm">
    <div class="row">
        <div class="form-group  col-lg-6">
            <label class="col-sm-4 control-label">Company Group<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="CompanyGroupId" class="form-control" name="Company Group" ng-model="CompanyGroupId" tabindex="1" ng-change="getEmpTag()">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in companyGroups" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="table-responsive modal-table col-lg-12">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Column</th>
                        <th>Aplicable</th>
                        <th>Aplos Column Name</th>
                        <th>Client Column Id</th>
                        <th>Client Column Name</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in employeeTagList">
                        <td>{{x.ColumnName}}</td>
                        <td>
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" id="IsAplicable" ng-model="x.IsAplicable" ng-checked="x.IsAplicable">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </td>
                        <td>
                            <div class="select-style">
                                <select class="form-control" id="{{x.AplosEmpFieldId}}"  name="AplosEmpFieldId" ng-model="x.AplosEmpFieldId"
                                        ng-options="item.Value as item.Text for item in employeeFields">
                                    <option></option>
                                </select>
                                @*<select id="{{x.AplosEmpFieldId}}" class="form-control" name="AplosEmpFieldId" data-ng-model="x.AplosEmpFieldId">
                                    <option></option>
                                    <option ng-repeat="option in employeeFields" value="{{option.Value}}" track by option.Value>{{option.Text}}</option>
                                </select>*@
                            </div>
                        </td>
                        <td>
                            <input type="text" name="InterfaceId Field" ng-model="x.ClientColumnId" class="form-control">
                        </td>
                        <td>
                            <input type="text" name="InterfaceId Field" ng-model="x.ClinetColumnName" class="form-control">
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="form-group  col-lg-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9" ng-disabled="employeeTagList.length==0"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>

                </ul>
            </div>
        </div>

    </div>
        
</div>